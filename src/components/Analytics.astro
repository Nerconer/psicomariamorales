---
// Umami Cloud. It sets no cookies, stores no visitor identifier and only keeps
// aggregated statistics, so no consent banner is needed (relevant for a health
// website).
//
// The tracker is loaded from this <script>, which Astro marks as already run
// and does not execute again on page transitions, so loading and listeners are
// set up only once. Pageviews for internal navigations are detected by the
// tracker itself, which hooks into history.pushState.
//
// Named events are declared with data-event="name" and sent from here instead
// of the native data-umami-event attributes: the tracker intercepts link clicks
// (preventDefault followed by location.href), which breaks ClientRouter
// transitions on internal links.
---

<script>
  import { ANALYTICS } from '../consts';

  type EventData = Record<string, string | number | boolean>;
  type Umami = { track: (name: string, data?: EventData) => void };

  const umami = () => (window as unknown as { umami?: Umami }).umami;

  // The tracker takes a few milliseconds to become available. Anything that
  // happens before that is queued here and sent once it loads, so the first
  // click is not lost.
  const queue: Array<[string, EventData | undefined]> = [];

  const track = (name: string, data?: EventData) => {
    const u = umami();
    if (u) u.track(name, data);
    else queue.push([name, data]);
  };

  const loadTracker = () => {
    if (document.querySelector('script[data-umami-tracker]')) return;
    const s = document.createElement('script');
    s.defer = true;
    s.src = ANALYTICS.umamiSrc;
    s.dataset.umamiTracker = '';
    s.dataset.websiteId = ANALYTICS.umamiWebsiteId;
    // Core Web Vitals measured on real visitors.
    s.dataset.performance = 'true';
    s.addEventListener('load', () => {
      for (const [name, data] of queue.splice(0, queue.length)) track(name, data);
    });
    document.head.appendChild(s);
  };

  // ── Clicks ───────────────────────────────────────────────────────────────
  // Elements with data-event come first. If there is none, a fallback covers
  // phone, email and any outbound link added later without a tag.
  const DATA_PREFIX = 'data-event-';

  const dataOf = (el: HTMLElement) => {
    const data: EventData = {};
    for (const { name, value } of Array.from(el.attributes))
      if (name.startsWith(DATA_PREFIX)) data[name.slice(DATA_PREFIX.length)] = value;
    return data;
  };

  const initClicks = () => {
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;

      const tagged = target?.closest?.<HTMLElement>('[data-event]');
      if (tagged) {
        track(tagged.dataset.event || 'unnamed', dataOf(tagged));
        return;
      }

      const link = target?.closest?.('a');
      if (!link) return;
      const href = link.getAttribute('href') || '';
      if (href.startsWith('tel:')) track('phone_click', { location: 'untagged' });
      else if (href.startsWith('mailto:')) track('email_click', { location: 'untagged' });
      else if (link.host && link.host !== window.location.host)
        track('outbound_click', { target: link.host, url: link.href });
    });

    // Components report their own events through here, so they do not depend
    // on the tracker being loaded yet.
    document.addEventListener('site:event', (e) => {
      const detail = (e as CustomEvent<{ name?: string; data?: EventData }>).detail;
      if (detail?.name) track(detail.name, detail.data);
    });
  };

  // ── Reading depth on blog posts ──────────────────────────────────────────
  const MILESTONES = [25, 50, 75, 100];
  let reading: AbortController | null = null;

  const initReading = () => {
    reading?.abort();
    reading = null;

    const article = document.querySelector<HTMLElement>('[data-article]');
    if (!article) return;

    const slug = article.dataset.article || window.location.pathname;
    const ac = new AbortController();
    reading = ac;
    let next = 0;

    const measure = () => {
      const box = article.getBoundingClientRect();
      if (box.height <= 0) return;
      const pct = Math.max(0, Math.min(100, ((window.innerHeight - box.top) / box.height) * 100));
      while (next < MILESTONES.length && pct >= MILESTONES[next]) {
        track('article_read', { article: slug, depth: MILESTONES[next] });
        next++;
      }
      if (next >= MILESTONES.length) ac.abort();
    };

    window.addEventListener('scroll', measure, { passive: true, signal: ac.signal });
    window.addEventListener('resize', measure, { passive: true, signal: ac.signal });
    // A short post can fit entirely on screen from the start.
    requestAnimationFrame(measure);
  };

  loadTracker();
  initClicks();
  // astro:page-load also fires on the initial load.
  document.addEventListener('astro:page-load', initReading);
</script>
