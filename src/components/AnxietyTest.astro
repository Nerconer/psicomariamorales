---
// GAD-7 anxiety questionnaire (Spitzer et al., 2006), shown on the anxiety
// page only. The instructions, the seven items and the four answers are the
// official Spanish (Spain) translation published by Pfizer on
// phqscreeners.com, which may be reproduced without permission. Do not reword
// them: a changed item is no longer the validated scale. There is no official
// Catalan version, so the Catalan page shows the same Spanish items.
//
// The score is computed in the browser. Answers and score are never stored,
// put in the URL or sent to analytics, because they describe how the person
// feels. Analytics only learns that the test was opened and finished.
import { SITE, PRICES, formatPrice, FREE_CALL_BY_LOCALE } from '../consts';
import type { Locale } from '../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'es' } = Astro.props;

const STEM = 'En los últimos 14 días, ¿con qué frecuencia le han supuesto una molestia los siguientes problemas?';
const ITEMS = [
  'Sentirse nervioso/a, angustiado/a o muy tenso/a',
  'Ser incapaz de dejar de preocuparse o de controlar la preocupación',
  'Preocuparse demasiado por diferentes cuestiones',
  'Tener problemas para relajarse',
  'Estar tan inquieto/a que le resulta difícil permanecer sentado/a',
  'Enfadarse o irritarse con facilidad',
  'Sentir miedo de que algo terrible pueda ocurrir',
];
const ANSWERS = ['Nunca', 'Varios días', 'Más de la mitad de los días', 'Casi cada día'];

const first = formatPrice(PRICES.firstSession.amount);

// Severity bands of the original validation: 0-4, 5-9, 10-14 and 15-21.
// From 10 on, the authors recommend a professional assessment.
const COPY = {
  es: {
    title: 'Test de ansiedad GAD-7',
    intro: 'Siete preguntas sobre los últimos 14 días. Es un cuestionario validado que sirve para orientar, no para diagnosticar. Tus respuestas no se guardan ni se envían.',
    languageNote: '',
    open: 'Hacer el test · 2 minutos',
    submit: 'Ver mi resultado',
    missingOne: 'Falta 1 pregunta por responder.',
    missingMany: 'Faltan {n} preguntas por responder.',
    score: 'Puntuación: {n} de 21',
    bands: [
      { max: 4, title: 'Ansiedad mínima', text: 'Tus respuestas no apuntan a una ansiedad que te complique el día a día. Si aun así hay algo que te preocupa, también podemos hablarlo.' },
      { max: 9, title: 'Ansiedad leve', text: 'Estas semanas hay algo de ansiedad. Si se mantiene o va a más, vale la pena pararse a mirarla.' },
      { max: 14, title: 'Ansiedad moderada', text: 'A partir de esta puntuación se recomienda consultarlo con una psicóloga. Una primera conversación ayuda a entender qué hay detrás.' },
      { max: 21, title: 'Ansiedad grave', text: 'Tus respuestas indican mucha ansiedad estas semanas. Te recomiendo pedir ayuda profesional pronto, sin esperar a que pase sola.' },
    ],
    freeCall: 'Pedir llamada gratuita de 15 min',
    book: `Reservar primera sesión · ${first}`,
    restart: 'Volver a hacerlo',
    note: 'Esto es una orientación, no un diagnóstico. Si ahora mismo estás en peligro o piensas en hacerte daño, llama al',
    noteFree: '(gratis, 24 horas) o al',
    source: 'GAD-7: Spitzer, Kroenke, Williams y Löwe (2006). Versión oficial en castellano de España, de reproducción libre.',
  },
  ca: {
    title: "Test d'ansietat GAD-7",
    intro: "Set preguntes sobre els últims 14 dies. És un qüestionari validat que serveix per orientar, no per diagnosticar. Les teves respostes no es guarden ni s'envien.",
    languageNote: 'El GAD-7 no té versió oficial en català, així que les preguntes es mostren en la versió validada en castellà.',
    open: 'Fer el test · 2 minuts',
    submit: 'Veure el meu resultat',
    missingOne: 'Falta 1 pregunta per respondre.',
    missingMany: 'Falten {n} preguntes per respondre.',
    score: 'Puntuació: {n} de 21',
    bands: [
      { max: 4, title: 'Ansietat mínima', text: "Les teves respostes no apunten a una ansietat que et compliqui el dia a dia. Si tot i així hi ha alguna cosa que et preocupa, també en podem parlar." },
      { max: 9, title: 'Ansietat lleu', text: "Aquestes setmanes hi ha una mica d'ansietat. Si es manté o va a més, val la pena aturar-s'hi." },
      { max: 14, title: 'Ansietat moderada', text: "A partir d'aquesta puntuació es recomana consultar-ho amb una psicòloga. Una primera conversa ajuda a entendre què hi ha al darrere." },
      { max: 21, title: 'Ansietat greu', text: 'Les teves respostes indiquen molta ansietat aquestes setmanes. Et recomano demanar ajuda professional aviat, sense esperar que passi sola.' },
    ],
    freeCall: 'Demanar trucada gratuïta de 15 min',
    book: `Reservar la primera sessió · ${first}`,
    restart: 'Tornar-lo a fer',
    note: "Això és una orientació, no un diagnòstic. Si ara mateix estàs en perill o penses a fer-te mal, truca al",
    noteFree: '(gratuït, 24 hores) o al',
    source: "GAD-7: Spitzer, Kroenke, Williams i Löwe (2006). Versió oficial en castellà d'Espanya, de reproducció lliure.",
  },
}[locale];

const config = { bands: COPY.bands, missingOne: COPY.missingOne, missingMany: COPY.missingMany, score: COPY.score };
---

<div class="anxiety-test rounded-3xl border border-line/60 bg-white p-5 shadow-soft sm:p-8">
  <h2 class="text-2xl font-bold text-primary md:text-3xl">{COPY.title}</h2>
  <p class="mt-3 max-w-[62ch]">{COPY.intro}</p>
  {COPY.languageNote && <p class="mt-2 max-w-[62ch] text-sm text-muted">{COPY.languageNote}</p>}

  <details class="mt-5" data-details>
    <summary class="btn-outline cursor-pointer list-none">{COPY.open}</summary>

    <form class="mt-7" novalidate data-form>
      <p class="max-w-[62ch] font-semibold" id="gad7-stem">{STEM}</p>
      <ol class="mt-5 space-y-6">
        {
          ITEMS.map((item, i) => (
            <li>
              <fieldset data-item aria-describedby="gad7-stem">
                <legend class="font-semibold">
                  {i + 1}. {item}
                </legend>
                <div class="mt-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
                  {ANSWERS.map((answer, value) => (
                    <label class="gad-option">
                      <input type="radio" name={`gad7-${i}`} value={value} class="sr-only" />
                      <span>{answer}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            </li>
          ))
        }
      </ol>
      <p class="mt-5 hidden font-semibold text-primary" role="alert" data-missing></p>
      <button type="submit" class="btn-primary mt-6">{COPY.submit}</button>
    </form>

    <div class="mt-7 hidden" data-result>
      <p class="text-sm font-bold text-muted" data-score></p>
      <h3 class="mt-1 text-2xl font-bold text-primary" tabindex="-1" data-band-title></h3>
      <p class="mt-3 max-w-[62ch]" data-band-text></p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a class="btn-primary" href={FREE_CALL_BY_LOCALE[locale]} target="_blank" rel="noopener" data-event="free_call_click" data-event-location="gad7_result"
          >{COPY.freeCall}</a
        >
        <a class="btn-whatsapp" href={SITE.doctoralia} target="_blank" rel="noopener" data-event="booking_click" data-event-location="gad7_result">{COPY.book}</a>
      </div>
      <button type="button" class="mt-5 font-semibold text-muted underline decoration-line underline-offset-4" data-restart>{COPY.restart}</button>
      <p class="mt-6 border-t border-line/60 pt-4 text-sm text-muted">
        {COPY.note} <a class="font-semibold underline" href="tel:024" data-no-track>024</a>{' '}
        {COPY.noteFree} <a class="font-semibold underline" href="tel:112" data-no-track>112</a>.
      </p>
    </div>

    <p class="mt-6 text-xs text-muted">{COPY.source}</p>
  </details>

  <script is:inline type="application/json" data-config set:html={JSON.stringify(config)} />
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] > summary {
    display: none;
  }
  .gad-option {
    display: flex;
    min-height: 3rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    border: 1.5px solid color-mix(in srgb, var(--color-line) 80%, white);
    background: var(--color-bg);
    padding: 0.55rem 0.75rem;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-ink);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .gad-option:hover {
    border-color: var(--color-primary);
  }
  .gad-option:has(:checked) {
    border-color: var(--color-primary);
    background: var(--color-surface);
    color: var(--color-primary);
  }
  .gad-option:has(:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>

<script>
  type Band = { max: number; title: string; text: string };
  type Config = { bands: Band[]; missingOne: string; missingMany: string; score: string };

  document.querySelectorAll<HTMLElement>('.anxiety-test').forEach((root) => {
    const config: Config = JSON.parse(root.querySelector('script[data-config]')?.textContent || '{}');
    const details = root.querySelector<HTMLDetailsElement>('[data-details]')!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const missing = root.querySelector<HTMLElement>('[data-missing]')!;
    const items = Array.from(root.querySelectorAll<HTMLFieldSetElement>('[data-item]'));
    let opened = false;

    // Only that the test was used is reported, never an answer or the score.
    const track = (name: string) => document.dispatchEvent(new CustomEvent('site:event', { detail: { name } }));

    details.addEventListener('toggle', () => {
      if (details.open && !opened) {
        opened = true;
        track('gad7_start');
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const values = items.map((f) => f.querySelector<HTMLInputElement>('input:checked')?.value);
      const unanswered = values.filter((v) => v === undefined).length;
      if (unanswered) {
        missing.textContent = unanswered === 1 ? config.missingOne : config.missingMany.replace('{n}', String(unanswered));
        missing.classList.remove('hidden');
        items[values.findIndex((v) => v === undefined)].querySelector('input')?.focus();
        return;
      }

      const score = values.reduce((sum, v) => sum + Number(v), 0);
      const band = config.bands.find((b) => score <= b.max) ?? config.bands[config.bands.length - 1];
      root.querySelector('[data-score]')!.textContent = config.score.replace('{n}', String(score));
      root.querySelector('[data-band-title]')!.textContent = band.title;
      root.querySelector('[data-band-text]')!.textContent = band.text;

      missing.classList.add('hidden');
      form.classList.add('hidden');
      result.classList.remove('hidden');
      root.querySelector<HTMLElement>('[data-band-title]')?.focus({ preventScroll: true });
      result.scrollIntoView({ block: 'start', behavior: 'smooth' });
      track('gad7_complete');
    });

    root.querySelector('[data-restart]')?.addEventListener('click', () => {
      form.reset();
      result.classList.add('hidden');
      form.classList.remove('hidden');
      items[0].querySelector('input')?.focus();
    });
  });
</script>
