---
// One therapeutic approach with its icon (therapy page).
import Icon, { type IconName } from './ui/Icon.astro';

interface Props {
  icon: IconName;
  title: string;
  text: string;
}
const { icon, title, text } = Astro.props;
---

<article class="card p-5!">
  <span class="grid h-11 w-11 place-items-center rounded-xl bg-surface text-primary" aria-hidden="true">
    <Icon name={icon} />
  </span>
  <h4 class="mt-3 font-display text-lg font-bold text-primary">{title}</h4>
  <p class="mt-1 text-base text-muted">{text}</p>
</article>
