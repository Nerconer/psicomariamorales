---
// Closing call to action shared by every page: booking, WhatsApp and a call.
import { SITE, WHATSAPP_BY_LOCALE } from '../consts';
import { localeFromPath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import Icon from './ui/Icon.astro';
import WhatsAppIcon from './ui/WhatsAppIcon.astro';

interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
}

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const {
  title = t('cta.title'),
  text = t('cta.text'),
  primaryLabel = t('cta.bookFirst'),
  primaryHref = SITE.doctoralia,
} = Astro.props;

const external = primaryHref.startsWith('http');
---

<section class="bg-primary-strong">
  <div class="mx-auto w-[min(820px,calc(100%-2rem))] py-16 text-center md:py-20">
    <h2 class="text-3xl font-bold text-white md:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-[52ch] text-white/85">{text}</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
      <a
        href={primaryHref}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener' : undefined}
        data-event={external ? 'booking_click' : 'contact_page_click'}
        data-event-location="final_cta"
        class="btn-light"
      >
        <Icon name="calendar" size={20} />
        {primaryLabel}
      </a>
      <a
        href={WHATSAPP_BY_LOCALE[locale]}
        target="_blank"
        rel="noopener"
        data-event="whatsapp_click"
        data-event-location="final_cta"
        class="btn-light-outline"
      >
        <WhatsAppIcon size={20} />
        WhatsApp
      </a>
      <a href={SITE.phoneHref} data-event="phone_click" data-event-location="final_cta" class="btn-light-outline">
        <Icon name="phone" size={20} />
        {t('cta.call')}
      </a>
    </div>
  </div>
</section>
