---
// Doctoralia's official widget (reviews or booking calendar), loaded only when
// the visitor asks for it. Until then nothing is requested from Doctoralia, so
// no third-party cookie is set and the site needs no consent banner.
import { SITE, REVIEWS } from '../consts';
import Icon from './ui/Icon.astro';
import { localeFromPath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  mode: 'reviews' | 'calendar';
  location: string;
  /** Only the button and the notice, for pages where the calendar is the point. */
  compact?: boolean;
}
const { mode, location, compact = false } = Astro.props;
const { rating, count, slug } = REVIEWS.doctoralia;

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const label = mode === 'reviews' ? t('doctoralia.reviews') : t('doctoralia.calendar');
---

<div class="doctoralia-embed rounded-2xl border border-line/60 bg-white p-5 sm:p-7" data-mode={mode} data-location={location}>
  <div data-placeholder>
    {
      compact ? null : mode === 'reviews' ? (
        <p class="flex flex-wrap items-baseline gap-x-2 font-display text-ink">
          <span class="text-3xl font-bold">{rating.toLocaleString(locale === 'ca' ? 'ca-ES' : 'es-ES', { minimumFractionDigits: 1 })}</span>
          <span class="text-sun-strong" aria-hidden="true">★★★★★</span>
          <span class="text-base text-muted">
            {count} {count === 1 ? t('doctoralia.one') : t('doctoralia.many')}
          </span>
        </p>
      ) : (
        <p class="flex items-center gap-2 font-display text-lg font-bold text-ink">
          <Icon name="calendar" class="text-primary" />
          {t('doctoralia.calendarPrompt')}
        </p>
      )
    }
    <div class:list={['flex flex-col gap-3 sm:flex-row sm:items-center', !compact && 'mt-4']}>
      <button type="button" class="btn-primary" data-load>{label}</button>
      {!compact && (
      <a
        href={SITE.doctoralia}
        target="_blank"
        rel="noopener"
        data-event={mode === 'reviews' ? 'reviews_click' : 'booking_click'}
        data-event-location={location}
        class="font-semibold text-primary underline decoration-line underline-offset-4 hover:decoration-primary"
        >{t('doctoralia.open')}</a
      >
      )}
    </div>
    <p class="mt-3 text-sm text-muted">
      {t('doctoralia.notice')}
    </p>
  </div>

  <div data-target hidden>
    <a
      class="zl-url"
      href={SITE.doctoralia}
      rel="nofollow"
      data-zlw-doctor={slug}
      data-zlw-type={mode === 'reviews' ? 'big' : 'big_with_calendar'}
      data-zlw-opinion={mode === 'reviews' ? 'true' : 'false'}
      data-zlw-hide-branding="true"
      data-zlw-saas-only="true">Maria Morales Herrerías en Doctoralia</a
    >
  </div>
</div>

<script>
  const WIDGET_SRC = 'https://platform.docplanner.com/js/widget.js';

  // The widget script scans the page for .zl-url links when it runs, so it is
  // (re)inserted after the link is revealed.
  const loadWidget = () => {
    document.getElementById('zl-widget-s')?.remove();
    const s = document.createElement('script');
    s.id = 'zl-widget-s';
    s.src = WIDGET_SRC;
    s.async = true;
    document.body.appendChild(s);
  };

  document.querySelectorAll<HTMLElement>('.doctoralia-embed').forEach((root) => {
    root.querySelector('[data-load]')?.addEventListener('click', () => {
      root.querySelector<HTMLElement>('[data-placeholder]')?.remove();
      root.querySelector<HTMLElement>('[data-target]')?.removeAttribute('hidden');
      document.dispatchEvent(
        new CustomEvent('site:event', {
          detail: {
            name: 'doctoralia_widget_open',
            data: { mode: root.dataset.mode ?? '', location: root.dataset.location ?? '' },
          },
        })
      );
      loadWidget();
    });
  });
</script>
