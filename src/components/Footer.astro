---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-t border-line/20 bg-surface">
  <div class="mx-auto grid w-[min(1120px,92%)] gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl font-semibold text-ink">
        Psico<em class="not-italic text-primary">Maria</em>Morales
      </p>
      <p class="mt-3 max-w-[36ch] text-base text-muted">
        Psicología integradora presencial en Barcelona y online. Ansiedad, estrés, gestión de
        conflictos, regulación emocional, trauma y apego.
      </p>
      <p class="mt-3 text-base font-semibold text-primary-strong">
        <a
          href={SITE.copc}
          target="_blank"
          rel="noopener"
          title="Ficha profesional en el Col·legi Oficial de Psicologia de Catalunya"
          data-event="license_click"
          data-event-location="footer"
          class="underline decoration-line underline-offset-4 hover:decoration-primary-strong"
          >Colegiada n.º {SITE.licenseNumber}</a
        >
      </p>
      <a
        href={SITE.doctoralia}
        target="_blank"
        rel="noopener"
        data-event="booking_click"
        data-event-location="footer"
        class="btn-outline mt-5 min-h-11 !px-5 !py-2">Reservar cita en Doctoralia</a
      >
    </div>

    <nav aria-label="Enlaces del pie" class="grid grid-cols-2 gap-x-6 text-base">
      <a class="flex min-h-11 items-center text-muted hover:text-primary" href="/sobre-mi/">Sobre mí</a>
      <a class="flex min-h-11 items-center text-muted hover:text-primary" href="/terapia-psicologica/">Terapia psicológica</a>
      <a class="flex min-h-11 items-center text-muted hover:text-primary" href="/terapia-de-pareja/">Terapia de pareja</a>
      <a class="flex min-h-11 items-center text-muted hover:text-primary" href="/empresas/">Empresas</a>
      <a class="flex min-h-11 items-center text-muted hover:text-primary" href="/centros-educativos/">Centros educativos</a>
      <a class="flex min-h-11 items-center text-muted hover:text-primary" href="/tarifas/">Tarifas</a>
      <a class="flex min-h-11 items-center text-muted hover:text-primary" href="/blog/">Blog</a>
      <a class="flex min-h-11 items-center text-muted hover:text-primary" href="/contacto/">Contacto</a>
    </nav>

    <div class="text-base">
      <p class="mb-2 font-semibold text-ink">Sígueme</p>
      <div class="flex gap-4">
        <a
          class="inline-flex min-h-11 items-center text-muted hover:text-primary"
          href={SITE.linkedin}
          target="_blank"
          rel="noopener"
          data-event="linkedin_click"
          data-event-location="footer">LinkedIn</a
        >
      </div>
      <div class="mt-6">
        <a class="flex min-h-11 items-center text-muted hover:text-primary" href="/aviso-legal/">Aviso legal</a>
        <a class="flex min-h-11 items-center text-muted hover:text-primary" href="/politica-privacidad/"
          >Política de privacidad</a
        >
        <a class="flex min-h-11 items-center text-muted hover:text-primary" href="/politica-cookies/"
          >Política de cookies</a
        >
      </div>
    </div>
  </div>

  <div class="border-t border-line/20 py-4">
    <p class="text-center text-sm text-muted">
      © {year} Maria Morales · Psicóloga sanitaria en Barcelona
    </p>
  </div>
</footer>
