---
import { SITE } from '../consts';
import Icon from './ui/Icon.astro';
import WhatsAppIcon from './ui/WhatsAppIcon.astro';

const year = new Date().getFullYear();

const pages = [
  { href: '/terapia-online/', label: 'Terapia online' },
  { href: '/terapia-psicologica/', label: 'Terapia psicológica' },
  { href: '/terapia-de-pareja/', label: 'Terapia de pareja' },
  { href: '/tarifas/', label: 'Tarifas' },
  { href: '/sobre-mi/', label: 'Sobre mí' },
  { href: '/empresas/', label: 'Empresas' },
  { href: '/centros-educativos/', label: 'Centros educativos' },
  { href: '/blog/', label: 'Blog' },
  { href: '/contacto/', label: 'Contacto' },
];

const legal = [
  { href: '/aviso-legal/', label: 'Aviso legal' },
  { href: '/politica-privacidad/', label: 'Política de privacidad' },
  { href: '/politica-cookies/', label: 'Política de cookies' },
];

const linkClass = 'flex min-h-11 items-center text-muted hover:text-primary';
---

<footer class="border-t border-line/50 bg-surface">
  <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] gap-10 py-14 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <p class="font-display text-xl font-bold text-ink">{SITE.person}</p>
      <p class="text-muted">{SITE.role}</p>
      <p class="mt-4 max-w-[38ch] text-base text-muted">
        Psicología integradora presencial en Barcelona y online. Ansiedad, estrés, gestión de
        conflictos, regulación emocional, trauma y apego.
      </p>
      <p class="mt-4 text-base font-semibold">
        <a
          href={SITE.copc}
          target="_blank"
          rel="noopener"
          title="Ficha profesional en el Col·legi Oficial de Psicologia de Catalunya"
          data-event="license_click"
          data-event-location="footer"
          class="text-primary underline decoration-line underline-offset-4 hover:decoration-primary"
          >Colegiada n.º {SITE.licenseNumber} (COPC)</a
        >
      </p>
    </div>

    <div class="text-base">
      <p class="mb-2 font-display font-bold text-ink">Contacto</p>
      <a
        class={`${linkClass} gap-2`}
        href={SITE.whatsapp}
        target="_blank"
        rel="noopener"
        data-event="whatsapp_click"
        data-event-location="footer"
      >
        <WhatsAppIcon size={18} class="text-[#128c4a]" />
        WhatsApp
      </a>
      <a class={`${linkClass} gap-2`} href={SITE.phoneHref} data-event="phone_click" data-event-location="footer">
        <Icon name="phone" size={18} class="text-primary" />
        {SITE.phone}
      </a>
      <a class={`${linkClass} gap-2`} href={`mailto:${SITE.email}`} data-event="email_click" data-event-location="footer">
        <Icon name="mail" size={18} class="text-primary" />
        {SITE.email}
      </a>
      <a
        class={`${linkClass} gap-2`}
        href={SITE.doctoralia}
        target="_blank"
        rel="noopener"
        data-event="booking_click"
        data-event-location="footer"
      >
        <Icon name="calendar" size={18} class="text-primary" />
        Reservar en Doctoralia
      </a>
    </div>

    <nav aria-label="Enlaces del pie" class="grid grid-cols-2 gap-x-6 text-base md:grid-cols-1">
      {pages.map((l) => <a class={linkClass} href={l.href}>{l.label}</a>)}
    </nav>
  </div>

  <div class="border-t border-line/50">
    <div class="mx-auto flex w-[min(1120px,calc(100%-2rem))] flex-col gap-2 py-5 text-sm text-muted md:flex-row md:items-center md:justify-between">
      <p>© {year} {SITE.person} · {SITE.role} · Barcelona y online</p>
      <div class="flex flex-wrap gap-x-5">
        {legal.map((l) => <a class="flex min-h-11 items-center hover:text-primary" href={l.href}>{l.label}</a>)}
        <a
          class="flex min-h-11 items-center hover:text-primary"
          href={SITE.linkedin}
          target="_blank"
          rel="noopener"
          data-event="linkedin_click"
          data-event-location="footer">LinkedIn</a
        >
      </div>
    </div>
  </div>
</footer>
