---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-t border-forest-soft/20 bg-mist">
  <div class="mx-auto grid w-[min(1120px,92%)] gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl font-semibold text-ink">
        Psico<em class="not-italic text-forest">Maria</em>Morales
      </p>
      <p class="mt-3 max-w-[36ch] text-base text-ink-soft">
        Psicología integradora presencial en Barcelona y online. Ansiedad, estrés, gestión de
        conflictos, regulación emocional, trauma y apego.
      </p>
      <p class="mt-3 text-base font-semibold text-forest-dark">
        <a
          href={SITE.copc}
          target="_blank"
          rel="noopener"
          title="Ficha profesional en el Col·legi Oficial de Psicologia de Catalunya"
          data-evento="colegiada-copc"
          data-evento-ubicacion="footer"
          class="underline decoration-forest-soft underline-offset-4 hover:decoration-forest-dark"
          >Colegiada n.º {SITE.licenseNumber}</a
        >
      </p>
      <a
        href={SITE.doctoralia}
        target="_blank"
        rel="noopener"
        data-evento="reservar-doctoralia"
        data-evento-ubicacion="footer"
        class="btn-outline mt-5 min-h-11 !px-5 !py-2">Reservar cita en Doctoralia</a
      >
    </div>

    <nav aria-label="Enlaces del pie" class="grid grid-cols-2 gap-x-6 text-base">
      <a class="flex min-h-11 items-center text-ink-soft hover:text-forest" href="/sobre-mi">Sobre mí</a>
      <a class="flex min-h-11 items-center text-ink-soft hover:text-forest" href="/terapia-psicologica">Terapia psicológica</a>
      <a class="flex min-h-11 items-center text-ink-soft hover:text-forest" href="/terapia-de-pareja">Terapia de pareja</a>
      <a class="flex min-h-11 items-center text-ink-soft hover:text-forest" href="/empresas">Empresas</a>
      <a class="flex min-h-11 items-center text-ink-soft hover:text-forest" href="/centros-educativos">Centros educativos</a>
      <a class="flex min-h-11 items-center text-ink-soft hover:text-forest" href="/tarifas">Tarifas</a>
      <a class="flex min-h-11 items-center text-ink-soft hover:text-forest" href="/blog">Blog</a>
      <a class="flex min-h-11 items-center text-ink-soft hover:text-forest" href="/contacto">Contacto</a>
    </nav>

    <div class="text-base">
      <p class="mb-2 font-semibold text-ink">Sígueme</p>
      <div class="flex gap-4">
        <a
          class="inline-flex min-h-11 items-center text-ink-soft hover:text-forest"
          href={SITE.linkedin}
          target="_blank"
          rel="noopener"
          data-evento="linkedin"
          data-evento-ubicacion="footer">LinkedIn</a
        >
      </div>
      <div class="mt-6">
        <a class="flex min-h-11 items-center text-ink-soft hover:text-forest" href="/aviso-legal">Aviso legal</a>
        <a class="flex min-h-11 items-center text-ink-soft hover:text-forest" href="/politica-privacidad"
          >Política de privacidad</a
        >
        <a class="flex min-h-11 items-center text-ink-soft hover:text-forest" href="/politica-cookies"
          >Política de cookies</a
        >
      </div>
    </div>
  </div>

  <div class="border-t border-forest-soft/20 py-4">
    <p class="text-center text-sm text-ink-soft">
      © {year} Maria Morales · Psicóloga sanitaria en Barcelona
    </p>
  </div>
</footer>
