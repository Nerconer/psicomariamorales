---
import { SITE } from '../consts';

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/terapia-psicologica', label: 'Terapia psicológica' },
  { href: '/terapia-de-pareja', label: 'Terapia de pareja' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/tarifas', label: 'Tarifas' },
  { href: '/blog', label: 'Recursos' },
  { href: '/contacto', label: 'Contacto' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-forest-soft/20 bg-cream/90 backdrop-blur-md">
  <div class="mx-auto flex w-[min(1200px,94%)] items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-3" aria-label="Inicio — PsicoMariaMorales">
      <span
        class="grid h-11 w-11 place-items-center rounded-full border border-forest/60 font-display text-2xl font-bold text-forest"
        >M</span
      >
      <span class="leading-tight">
        <span class="block font-display text-xl font-semibold text-ink"
          >Psico<em class="not-italic text-forest">Maria</em>Morales</span
        >
        <span class="block text-[0.62rem] font-medium uppercase tracking-[0.28em] text-forest"
          >Psicología integradora</span
        >
      </span>
    </a>

    <nav class="hidden items-center gap-5 xl:flex" aria-label="Navegación principal">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'whitespace-nowrap text-[0.86rem] font-medium transition-colors hover:text-forest',
              isActive(l.href) ? 'text-forest' : 'text-ink-soft',
            ]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <a href={SITE.doctoralia} target="_blank" rel="noopener" class="btn-primary whitespace-nowrap !px-5 !py-2 text-sm">
        Reservar cita
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="grid h-11 w-11 place-items-center rounded-full text-forest transition-colors hover:bg-mist xl:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path class="icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="icon-close hidden" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-forest-soft/20 bg-cream px-[4%] pb-6 pt-3 xl:!hidden"
    aria-label="Navegación móvil"
  >
    {
      links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'block border-b border-forest-soft/15 py-3 font-display text-lg',
            isActive(l.href) ? 'text-forest' : 'text-ink',
          ]}
        >
          {l.label}
        </a>
      ))
    }
    <a href={SITE.doctoralia} target="_blank" rel="noopener" class="btn-primary mt-5 w-full justify-center">
      Reservar cita en Doctoralia
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  });
</script>
