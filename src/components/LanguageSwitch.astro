---
// ES / CA switch, always visible at the top of the header instead of being one
// more menu entry. It goes to the same page in the other language when there
// is one, and to that language's home otherwise.
import { LOCALES, localeFromPath, type Locale } from '../i18n/config';
import { alternatesOf, pathFor } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const versions = alternatesOf(Astro.url.pathname);
const links = (Object.keys(LOCALES) as Locale[]).map((l) => {
  const version = versions.find((v) => v.locale === l);
  return { locale: l, href: version?.path ?? (l === locale ? Astro.url.pathname : pathFor('home', l)), translated: Boolean(version) };
});
---

<div class:list={['inline-flex shrink-0 items-center rounded-full border border-line/70 bg-white p-0.5', className]} role="group" aria-label={t('nav.language')}>
  {
    links.map((l) => (
      <a
        href={l.href}
        hreflang={l.translated ? LOCALES[l.locale].htmlLang : undefined}
        lang={LOCALES[l.locale].htmlLang}
        aria-current={l.locale === locale ? 'true' : undefined}
        data-event={l.locale === locale ? undefined : 'language_switch'}
        data-event-to={l.locale === locale ? undefined : l.locale}
        class:list={[
          'inline-flex min-h-8 min-w-9 items-center justify-center rounded-full px-2.5 text-sm font-bold transition-colors',
          l.locale === locale ? 'bg-primary text-white' : 'text-muted hover:text-primary',
        ]}
      >
        {LOCALES[l.locale].short}
        <span class="sr-only">{LOCALES[l.locale].label}</span>
      </a>
    ))
  }
</div>
