---
// Ordinary life stages in which therapy can help, as a short list of chips.
import Chip from './ui/Chip.astro';
import { LIFE_STAGES } from '../data/life-stages';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
  /** Chip fill: `light` on tinted sections, where the default would not show. */
  tone?: 'default' | 'light';
}
const { locale, tone = 'default' } = Astro.props;
const c = LIFE_STAGES[locale];
---

<h3 class="text-lg font-bold text-muted">{c.title}</h3>
<p class="mt-3 max-w-[68ch]">{c.intro}</p>
<ul class="mt-4 flex flex-wrap gap-2">
  {
    c.items.map((item) => (
      <li>
        <Chip tone={tone}>{item}</Chip>
      </li>
    ))
  }
</ul>
