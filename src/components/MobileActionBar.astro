---
// Fixed bar on mobile with the three ways to get in touch, always one tap
// away. The body keeps bottom padding so it never hides the end of the page.
// The phone number is written out because many older visitors look for the
// digits, not for an icon. WhatsApp keeps only its well-known icon.
import { SITE, WHATSAPP_BY_LOCALE } from '../consts';
import { localeFromPath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import Icon from './ui/Icon.astro';
import WhatsAppIcon from './ui/WhatsAppIcon.astro';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<nav
  aria-label={t('nav.quick')}
  class="fixed inset-x-3 bottom-3 z-50 grid grid-cols-[3rem_minmax(0,1.15fr)_minmax(0,1fr)] gap-1.5 rounded-full border border-line/50 bg-white p-1.5 shadow-[0_12px_32px_-12px_rgb(42_31_53/0.45)] md:hidden"
>
  <a
    href={WHATSAPP_BY_LOCALE[locale]}
    target="_blank"
    rel="noopener"
    aria-label={t('cta.whatsappLong')}
    data-event="whatsapp_click"
    data-event-location="mobile_bar"
    class="grid min-h-12 place-items-center rounded-full"
  >
    <WhatsAppIcon size={24} class="text-[#128c4a]" />
  </a>
  <a
    href={SITE.phoneHref}
    aria-label={`${t('cta.callTo')} ${SITE.phoneLocal}`}
    data-event="phone_click"
    data-event-location="mobile_bar"
    class="flex min-h-12 items-center justify-center gap-1.5 whitespace-nowrap rounded-full text-[0.95rem] font-bold text-ink max-[359px]:text-sm"
  >
    <Icon name="phone" size={18} class="text-primary max-[359px]:hidden" />
    {SITE.phoneLocal}
  </a>
  <a
    href={SITE.doctoralia}
    target="_blank"
    rel="noopener"
    data-event="booking_click"
    data-event-location="mobile_bar"
    class="flex min-h-12 items-center justify-center gap-1.5 whitespace-nowrap rounded-full bg-primary text-[0.95rem] font-bold text-white max-[359px]:text-sm"
  >
    <Icon name="calendar" size={18} class="max-[374px]:hidden" />
    {t('cta.book')}
  </a>
</nav>
