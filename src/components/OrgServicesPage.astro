---
// One-screen page for organisations (companies, schools): what is offered,
// the topics, and a direct way to ask for a proposal.
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import Chip from './ui/Chip.astro';
import Icon from './ui/Icon.astro';
import WhatsAppIcon from './ui/WhatsAppIcon.astro';
import { SITE, whatsappUrl } from '../consts';

interface Props {
  metaTitle: string;
  description: string;
  title: string;
  lead: string;
  formats: string[];
  topics: string[];
  subject: string;
  location: string;
}
const { metaTitle, description, title, lead, formats, topics, subject, location } = Astro.props;
const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent(subject)}`;
const whatsapp = whatsappUrl(`Hola Maria, te escribo por: ${subject}.`);
---

<Layout title={metaTitle} description={description}>
  <PageHero title={title} lead={lead} />

  <section class="py-12 md:py-16">
    <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
      <h2 class="text-2xl font-bold text-primary md:text-3xl">Formatos</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {formats.map((f) => <Chip tone="sun">{f}</Chip>)}
      </div>

      <h2 class="mt-10 text-2xl font-bold text-primary md:text-3xl">Temas</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {topics.map((t) => <Chip>{t}</Chip>)}
      </div>
    </div>
  </section>

  <section class="bg-primary-strong">
    <div class="mx-auto w-[min(820px,calc(100%-2rem))] py-14 text-center md:py-16">
      <h2 class="text-3xl font-bold text-white">Cuéntame qué necesitáis</h2>
      <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={mailto} data-event="email_click" data-event-location={location} class="btn-sun">
          <Icon name="mail" size={20} /> Escribir un email
        </a>
        <a href={whatsapp} target="_blank" rel="noopener" data-event="whatsapp_click" data-event-location={location} class="btn-sun-outline">
          <WhatsAppIcon size={20} /> WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
