---
// Orientation quiz (not a clinical test). Three questions route the visitor to
// the page and the first step that fit them. Answers live only in memory:
// they are not stored, not put in the URL and not sent to analytics, because
// they describe how the person feels, which is health data.
import { SITE, PRICES, formatPrice, WHATSAPP_BY_LOCALE, FREE_CALL_BY_LOCALE } from '../consts';
import type { Locale } from '../i18n/config';
import { pathFor } from '../i18n/routes';

interface Props {
  locale?: Locale;
}
const { locale = 'es' } = Astro.props;

const first = formatPrice(PRICES.firstSession.amount);
const online = formatPrice(PRICES.online.amount);
const inPerson = formatPrice(PRICES.inPerson.amount);
const couple = formatPrice(PRICES.couple.amount);
const coupleMin = PRICES.couple.minutes;

// Where each result leads.
const ROUTES = {
  anxiety: pathFor('anxiety', locale),
  trauma: pathFor('emdr', locale),
  loss: pathFor('grief', locale),
  relations: `${pathFor('therapy', locale)}#apego`,
  meaning: `${pathFor('therapy', locale)}#sentido`,
  demand: pathFor('selfEsteem', locale),
  growth: pathFor('growth', locale),
  couple: pathFor('couples', locale),
  unsure: pathFor('contact', locale),
};

const COPY = {
  es: {
    step: (n: number) => `Paso ${n} de 3`,
    back: 'Atrás',
    qStart: 'Cuéntame qué te trae por aquí',
    qHard: '¿Qué es lo que más te pesa ahora?',
    qGrowth: '¿Qué te gustaría cambiar?',
