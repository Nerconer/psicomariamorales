      couple: { title: 'Cuidar la relación a tiempo cambia mucho.', points: [`Sesiones de ${coupleMin} minutos para los dos, por ${couple}.`, 'Trabajaremos cómo os comunicáis y qué hay debajo de las discusiones.'] },
