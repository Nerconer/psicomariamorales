      { value: 'hard', label: 'Estoy pasando una mala racha', next: 'hard' },
      { value: 'growth', label: 'Estoy bien, pero quiero mejorar algo', next: 'growth' },
      { value: 'couple', label: 'Queremos trabajar algo en pareja', next: 'format' },
      { value: 'unsure', label: 'Todavía no lo tengo claro', next: 'format' },
    ],
    hard: [
      { value: 'anxiety', label: 'La ansiedad o una preocupación que no se apaga' },
      { value: 'anxiety', label: 'El estrés o el agotamiento' },
      { value: 'trauma', label: 'Algo que me pasó y sigue doliendo' },
      { value: 'loss', label: 'Una pérdida' },
      { value: 'relations', label: 'Cómo me relaciono y el miedo al rechazo' },
      { value: 'relations', label: 'Me siento solo o diferente a los demás' },
      { value: 'meaning', label: 'Nada me motiva o no le encuentro sentido' },
      { value: 'demand', label: 'Lo mucho que me exijo' },
    ],
    growth: [
      { value: 'growth', label: 'Tomar decisiones con más claridad' },
      { value: 'growth', label: 'Confiar más en mí' },
      { value: 'growth', label: 'Aprender a poner límites' },
      { value: 'growth', label: 'Salir de un bloqueo' },
      { value: 'growth', label: 'Pasar menos tiempo atrapado en el móvil' },
    ],
    formats: [
      { value: 'online', label: 'Online, desde donde estés' },
      { value: 'in_person', label: 'En persona, en Barcelona' },
      { value: 'either', label: 'Me da igual' },
    ],
