    coupleLabel: 'Reservar sesión de pareja',
    freeCallLabel: 'Pedir llamada gratuita de 15 min',
    note: 'Esto es una orientación, no una valoración profesional. Si ahora mismo estás en peligro o piensas en hacerte daño, llama al',
    noteFree: '(gratis, 24 horas) o al',
