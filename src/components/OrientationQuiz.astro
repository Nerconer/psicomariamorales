      couple: `La terapia de pareja cuesta ${couple} la sesión de ${coupleMin} minutos, también la primera.`,
    },
  },
  ca: {
    step: (n: number) => `Pas ${n} de 3`,
    back: 'Enrere',
    qStart: "Explica'm què et porta fins aquí",
    qHard: 'Què és el que més et pesa ara?',
    qGrowth: "Què t'agradaria canviar?",
    qFormat: 'Com et va millor?',
    whatsapp: 'Escriu-me per WhatsApp',
    more: "Saber-ne més",
    restart: 'Tornar a començar',
    firstLabel: `Reservar la primera sessió · ${first}`,
    coupleLabel: 'Reservar sessió de parella',
    freeCallLabel: 'Demanar trucada gratuïta de 15 min',
    note: "Això és una orientació, no una valoració professional. Si ara mateix estàs en perill o penses a fer-te mal, truca al",
    noteFree: '(gratuït, 24 hores) o al',
    start: [
      { value: 'hard', label: 'Estic passant una mala ratxa', next: 'hard' },
      { value: 'growth', label: 'Estic bé, però vull millorar alguna cosa', next: 'growth' },
      { value: 'couple', label: 'Volem treballar alguna cosa en parella', next: 'format' },
      { value: 'unsure', label: 'Encara no ho tinc clar', next: 'format' },
    ],
    hard: [
      { value: 'anxiety', label: "L'ansietat o una preocupació que no s'apaga" },
      { value: 'anxiety', label: "L'estrès o l'esgotament" },
      { value: 'trauma', label: 'Una cosa que em va passar i encara fa mal' },
      { value: 'loss', label: 'Una pèrdua' },
      { value: 'relations', label: 'Com em relaciono i la por al rebuig' },
      { value: 'relations', label: 'Em sento sol o diferent dels altres' },
      { value: 'meaning', label: "Res no em motiva o no hi trobo sentit" },
      { value: 'demand', label: "Com m'arribo a exigir" },
    ],
    growth: [
      { value: 'growth', label: 'Prendre decisions amb més claredat' },
      { value: 'growth', label: 'Confiar més en mi' },
      { value: 'growth', label: 'Aprendre a posar límits' },
      { value: 'growth', label: "Sortir d'un bloqueig" },
      { value: 'growth', label: 'Passar menys temps atrapat al mòbil' },
    ],
    formats: [
      { value: 'online', label: "En línia, des d'on siguis" },
      { value: 'in_person', label: 'En persona, a Barcelona' },
      { value: 'either', label: "M'és igual" },
    ],
    results: {
      anxiety: { title: 'Viure en alerta cansa molt. I es pot treballar.', points: ["Entendrem què dispara la teva ansietat o el teu esgotament.", 'Practicarem maneres de calmar el cos que et serveixin en el dia a dia.'] },
      trauma: { title: 'El que va passar no ha de continuar manant.', points: ["Anirem al teu ritme, sense que ho hagis d'explicar tot de cop.", 'Treballarem amb EMDR quan tingui sentit per a tu.'] },
      loss: { title: 'Una pèrdua necessita el seu temps i el seu espai.', points: ['Farem lloc al que sents, sense presses.', 'Buscarem com seguir endavant amb el que ha passat.'] },
      relations: { title: 'Els patrons que vam aprendre també es poden canviar.', points: ['Entendrem per què es repeteixen en les teves relacions.', 'Practicarem maneres més segures de vincular-te.'] },
      meaning: { title: 'Quan res no sembla tenir sentit, també es pot demanar ajuda.', points: ["Explorarem què s'ha apagat i des de quan.", 'Buscarem què té valor per a tu.'] },
      demand: { title: "Aquesta veu que t'exigeix tant es pot suavitzar.", points: ["Veurem d'on ve tanta exigència.", 'Treballarem perquè et tractis amb més cura.'] },
      growth: { title: 'No cal estar malament per venir a teràpia.', points: ["Posarem sobre la taula què vols canviar i què t'atura.", 'Avançarem amb objectius concrets i al teu ritme.'] },
      couple: { title: 'Cuidar la relació a temps canvia molt.', points: [`Sessions de ${coupleMin} minuts per a tots dos, per ${couple}.`, 'Treballarem com us comuniqueu i què hi ha sota les discussions.'] },
      unsure: { title: 'No cal tenir-ho clar per començar.', points: ['En una trucada gratuïta de 15 minuts en parlem.', 'Després decideixes si vols continuar, sense compromís.'] },
    },
    priceLines: {
      online: `La primera sessió costa ${first}. Després, ${online} la sessió en línia.`,
      in_person: `La primera sessió costa ${first}. Després, ${inPerson} la sessió a Barcelona.`,
      either: `La primera sessió costa ${first}. Després, ${online} en línia o ${inPerson} a Barcelona.`,
      couple: `La teràpia de parella costa ${couple} la sessió de ${coupleMin} minuts, també la primera.`,
    },
  },
}[locale];

const results = Object.fromEntries(
  Object.entries(COPY.results).map(([key, r]) => [key, { ...r, href: ROUTES[key as keyof typeof ROUTES] }])
);

const config = {
  results,
  priceLines: COPY.priceLines,
  booking: SITE.doctoralia,
  freeCall: FREE_CALL_BY_LOCALE[locale],
  firstLabel: COPY.firstLabel,
  coupleLabel: COPY.coupleLabel,
  freeCallLabel: COPY.freeCallLabel,
};
---

<div class="orientation-quiz rounded-3xl border border-line/60 bg-white p-5 shadow-soft sm:p-8">
  <p class="sr-only" aria-live="polite" data-announce></p>

  <div class="quiz-step" data-step="start">
    <p class="text-sm font-bold text-muted">{COPY.step(1)}</p>
    <h3 class="mt-1 text-2xl font-bold text-primary" tabindex="-1">{COPY.qStart}</h3>
    <div class="mt-5 grid gap-2.5">
      {COPY.start.map((o) => <button type="button" class="quiz-option" data-start={o.value} data-next={o.next}>{o.label}</button>)}
    </div>
  </div>

  <div class="quiz-step hidden" data-step="hard">
    <p class="text-sm font-bold text-muted">{COPY.step(2)}</p>
    <h3 class="mt-1 text-2xl font-bold text-primary" tabindex="-1">{COPY.qHard}</h3>
    <div class="mt-5 grid gap-2.5">
      {COPY.hard.map((o) => <button type="button" class="quiz-option" data-topic={o.value}>{o.label}</button>)}
    </div>
    <button type="button" class="quiz-back" data-back="start">{COPY.back}</button>
  </div>

  <div class="quiz-step hidden" data-step="growth">
    <p class="text-sm font-bold text-muted">{COPY.step(2)}</p>
    <h3 class="mt-1 text-2xl font-bold text-primary" tabindex="-1">{COPY.qGrowth}</h3>
    <div class="mt-5 grid gap-2.5">
      {COPY.growth.map((o) => <button type="button" class="quiz-option" data-topic={o.value}>{o.label}</button>)}
    </div>
    <button type="button" class="quiz-back" data-back="start">{COPY.back}</button>
  </div>

  <div class="quiz-step hidden" data-step="format">
    <p class="text-sm font-bold text-muted">{COPY.step(3)}</p>
    <h3 class="mt-1 text-2xl font-bold text-primary" tabindex="-1">{COPY.qFormat}</h3>
    <div class="mt-5 grid gap-2.5">
      {COPY.formats.map((o) => <button type="button" class="quiz-option" data-format={o.value}>{o.label}</button>)}
    </div>
    <button type="button" class="quiz-back" data-back="previous">{COPY.back}</button>
  </div>

  <div class="quiz-step hidden" data-step="result">
    <h3 class="text-2xl font-bold text-primary" tabindex="-1" data-result-title></h3>
    <ul class="checklist mt-4" data-result-points></ul>
    <p class="mt-4 font-semibold" data-result-price></p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a class="btn-primary" target="_blank" rel="noopener" data-result-cta data-event-location="quiz_result" href="#"></a>
      <a
        class="btn-whatsapp"
        target="_blank"
        rel="noopener"
        data-event="whatsapp_click"
        data-event-location="quiz_result"
        href={WHATSAPP_BY_LOCALE[locale]}>{COPY.whatsapp}</a
      >
    </div>
    <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
      <a class="font-semibold text-primary underline decoration-line underline-offset-4" data-result-link data-event="quiz_result_link" href="#"
        >{COPY.more}</a
      >
      <button type="button" class="font-semibold text-muted underline decoration-line underline-offset-4" data-restart>{COPY.restart}</button>
    </div>
    <p class="mt-6 border-t border-line/60 pt-4 text-sm text-muted">
      {COPY.note} <a class="font-semibold underline" href="tel:024" data-no-track>024</a>{' '}
      {COPY.noteFree} <a class="font-semibold underline" href="tel:112" data-no-track>112</a>.
    </p>
  </div>

  <script is:inline type="application/json" data-config set:html={JSON.stringify(config)} />
</div>

<style>
  .quiz-option {
    min-height: 3.25rem;
    width: 100%;
    border-radius: 1rem;
    border: 1.5px solid color-mix(in srgb, var(--color-line) 80%, white);
    background: var(--color-bg);
    padding: 0.8rem 1.1rem;
    text-align: left;
    font-weight: 600;
    color: var(--color-ink);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .quiz-option:hover {
    border-color: var(--color-primary);
    background: var(--color-surface);
  }
  .quiz-back {
    margin-top: 1rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>

<script>
  type Result = { title: string; points: string[]; href: string };
  type Config = {
    results: Record<string, Result>;
    priceLines: Record<string, string>;
    booking: string;
    freeCall: string;
    firstLabel: string;
    coupleLabel: string;
    freeCallLabel: string;
  };

  document.querySelectorAll<HTMLElement>('.orientation-quiz').forEach((root) => {
    const config: Config = JSON.parse(root.querySelector('script[data-config]')?.textContent || '{}');
    const announce = root.querySelector<HTMLElement>('[data-announce]');
    const state = { start: '', topic: '', format: '', previous: 'start' };
    let started = false;

    const track = (name: string, data?: Record<string, string | number>) =>
      document.dispatchEvent(new CustomEvent('site:event', { detail: { name, data } }));

    const show = (name: string) => {
      root.querySelectorAll<HTMLElement>('.quiz-step').forEach((s) => s.classList.toggle('hidden', s.dataset.step !== name));
      const heading = root.querySelector<HTMLElement>(`.quiz-step[data-step="${name}"] h3`);
      if (announce && heading) announce.textContent = heading.textContent ?? '';
      heading?.focus({ preventScroll: true });
    };

    const buildResult = () => {
      const key = state.start === 'couple' ? 'couple' : state.start === 'unsure' ? 'unsure' : state.topic;
      const r = config.results[key] ?? config.results.unsure;
      const priceKey = key === 'couple' ? 'couple' : state.format || 'either';

      root.querySelector('[data-result-title]')!.textContent = r.title;
      const list = root.querySelector('[data-result-points]')!;
      list.textContent = '';
      for (const p of r.points) {
        const li = document.createElement('li');
        li.textContent = p;
        list.appendChild(li);
      }
      root.querySelector('[data-result-price]')!.textContent = config.priceLines[priceKey] ?? '';

      const cta = root.querySelector<HTMLAnchorElement>('[data-result-cta]')!;
      const unsure = key === 'unsure';
      cta.href = unsure ? config.freeCall : config.booking;
      cta.textContent = unsure ? config.freeCallLabel : key === 'couple' ? config.coupleLabel : config.firstLabel;
      cta.dataset.event = unsure ? 'free_call_click' : 'booking_click';

      root.querySelector<HTMLAnchorElement>('[data-result-link]')!.href = r.href;
      track('quiz_complete');
      show('result');
    };

    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn || !root.contains(btn)) return;

      if (btn.dataset.start) {
        if (!started) track('quiz_start');
        started = true;
        state.start = btn.dataset.start;
        state.topic = '';
        state.previous = btn.dataset.next === 'format' ? 'start' : btn.dataset.next ?? 'start';
        track('quiz_step', { step: 1 });
        show(btn.dataset.next ?? 'format');
      } else if (btn.dataset.topic) {
        state.topic = btn.dataset.topic;
        track('quiz_step', { step: 2 });
        show('format');
      } else if (btn.dataset.format) {
        state.format = btn.dataset.format;
        track('quiz_step', { step: 3 });
        buildResult();
      } else if (btn.dataset.back) {
        show(btn.dataset.back === 'previous' ? state.previous : btn.dataset.back);
      } else if (btn.hasAttribute('data-restart')) {
        state.start = state.topic = state.format = '';
        show('start');
      }
    });
  });
</script>
