---
// Orientation quiz (not a clinical test). Three questions route the visitor to
// the page and the first step that fit them. Answers live only in memory:
// they are not stored, not put in the URL and not sent to analytics, because
// they describe how the person feels, which is health data.
import { SITE, PRICES, formatPrice, FREE_CALL_WHATSAPP } from '../consts';

const first = formatPrice(PRICES.firstSession.amount);

// Where each result leads. Point these to the dedicated pages once they exist.
const ROUTES = {
  anxiety: '/terapia-psicologica/#ansiedad',
  trauma: '/terapia-psicologica/#trauma',
  loss: '/terapia-psicologica/#duelo',
  relations: '/terapia-psicologica/#apego',
  demand: '/terapia-psicologica/#autoestima',
  growth: '/terapia-psicologica/#bloqueos',
  couple: '/terapia-de-pareja/',
  unsure: '/contacto/',
};

const results = {
  anxiety: {
    title: 'Vivir en alerta cansa mucho. Y se puede trabajar.',
    points: [
      'Entenderemos qué dispara tu ansiedad o tu agotamiento.',
      'Practicaremos formas de calmar el cuerpo que te sirvan en tu día a día.',
    ],
    href: ROUTES.anxiety,
  },
  trauma: {
    title: 'Lo que pasó no tiene por qué seguir mandando.',
    points: [
      'Iremos a tu ritmo, sin que tengas que contarlo todo de golpe.',
      'Trabajaremos con EMDR cuando tenga sentido para ti.',
    ],
    href: ROUTES.trauma,
  },
  loss: {
    title: 'Una pérdida necesita su tiempo y su espacio.',
    points: [
      'Daremos lugar a lo que sientes, sin prisas.',
      'Buscaremos cómo seguir adelante con lo que ha pasado.',
    ],
    href: ROUTES.loss,
  },
  relations: {
    title: 'Los patrones que aprendimos también se pueden cambiar.',
    points: [
      'Entenderemos por qué se repiten en tus relaciones.',
      'Practicaremos formas más seguras de vincularte.',
    ],
    href: ROUTES.relations,
  },
  demand: {
    title: 'Esa voz que te exige tanto se puede suavizar.',
    points: [
      'Veremos de dónde viene tanta exigencia.',
      'Trabajaremos para que te trates con más cuidado.',
    ],
    href: ROUTES.demand,
  },
  growth: {
    title: 'No hace falta estar mal para venir a terapia.',
    points: [
      'Pondremos sobre la mesa qué quieres cambiar y qué te frena.',
      'Avanzaremos con objetivos concretos y a tu ritmo.',
    ],
    href: ROUTES.growth,
  },
  couple: {
    title: 'Cuidar la relación a tiempo cambia mucho.',
    points: [
      `Sesiones de ${PRICES.couple.minutes} minutos para los dos, por ${formatPrice(PRICES.couple.amount)}.`,
      'Trabajaremos cómo os comunicáis y qué hay debajo de las discusiones.',
    ],
    href: ROUTES.couple,
  },
  unsure: {
    title: 'No hace falta tenerlo claro para empezar.',
    points: [
      'En una llamada gratuita de 15 minutos lo hablamos.',
      'Después decides si quieres seguir, sin compromiso.',
    ],
    href: ROUTES.unsure,
  },
};

const priceLines = {
  online: `La primera sesión cuesta ${first}. Después, ${formatPrice(PRICES.online.amount)} la sesión online.`,
  in_person: `La primera sesión cuesta ${first}. Después, ${formatPrice(PRICES.inPerson.amount)} la sesión en Barcelona.`,
  either: `La primera sesión cuesta ${first}. Después, ${formatPrice(PRICES.online.amount)} online o ${formatPrice(PRICES.inPerson.amount)} en Barcelona.`,
  couple: `La terapia de pareja cuesta ${formatPrice(PRICES.couple.amount)} la sesión de ${PRICES.couple.minutes} minutos, también la primera.`,
};

const start = [
  { value: 'hard', label: 'Estoy pasando una mala racha', next: 'hard' },
  { value: 'growth', label: 'Estoy bien, pero quiero mejorar algo', next: 'growth' },
  { value: 'couple', label: 'Queremos trabajar algo en pareja', next: 'format' },
  { value: 'unsure', label: 'Todavía no lo tengo claro', next: 'format' },
];

const hard = [
  { value: 'anxiety', label: 'La ansiedad o una preocupación que no se apaga' },
  { value: 'anxiety', label: 'El estrés o el agotamiento' },
  { value: 'trauma', label: 'Algo que me pasó y sigue doliendo' },
  { value: 'loss', label: 'Una pérdida' },
  { value: 'relations', label: 'Cómo me relaciono y el miedo al rechazo' },
  { value: 'demand', label: 'Lo mucho que me exijo' },
];

const growth = [
  { value: 'growth', label: 'Tomar decisiones con más claridad' },
  { value: 'growth', label: 'Confiar más en mí' },
  { value: 'growth', label: 'Aprender a poner límites' },
  { value: 'growth', label: 'Salir de un bloqueo' },
];

const formats = [
  { value: 'online', label: 'Online, desde donde estés' },
  { value: 'in_person', label: 'En persona, en Barcelona' },
  { value: 'either', label: 'Me da igual' },
];

const config = {
  results,
  priceLines,
  booking: SITE.doctoralia,
  whatsapp: SITE.whatsapp,
  freeCall: FREE_CALL_WHATSAPP,
  firstLabel: `Reservar primera sesión · ${first}`,
};
---

<div class="orientation-quiz rounded-3xl border border-line/60 bg-white p-5 shadow-soft sm:p-8">
  <p class="sr-only" aria-live="polite" data-announce></p>

  <div class="quiz-step" data-step="start">
    <p class="text-sm font-bold text-muted">Paso 1 de 3</p>
    <h3 class="mt-1 text-2xl font-bold text-primary" tabindex="-1">Cuéntame qué te trae por aquí</h3>
    <div class="mt-5 grid gap-2.5">
      {start.map((o) => <button type="button" class="quiz-option" data-start={o.value} data-next={o.next}>{o.label}</button>)}
    </div>
  </div>

  <div class="quiz-step hidden" data-step="hard">
    <p class="text-sm font-bold text-muted">Paso 2 de 3</p>
    <h3 class="mt-1 text-2xl font-bold text-primary" tabindex="-1">¿Qué es lo que más te pesa ahora?</h3>
    <div class="mt-5 grid gap-2.5">
      {hard.map((o) => <button type="button" class="quiz-option" data-topic={o.value}>{o.label}</button>)}
    </div>
    <button type="button" class="quiz-back" data-back="start">Atrás</button>
  </div>

  <div class="quiz-step hidden" data-step="growth">
    <p class="text-sm font-bold text-muted">Paso 2 de 3</p>
    <h3 class="mt-1 text-2xl font-bold text-primary" tabindex="-1">¿Qué te gustaría cambiar?</h3>
    <div class="mt-5 grid gap-2.5">
      {growth.map((o) => <button type="button" class="quiz-option" data-topic={o.value}>{o.label}</button>)}
    </div>
    <button type="button" class="quiz-back" data-back="start">Atrás</button>
  </div>

  <div class="quiz-step hidden" data-step="format">
    <p class="text-sm font-bold text-muted">Paso 3 de 3</p>
    <h3 class="mt-1 text-2xl font-bold text-primary" tabindex="-1">¿Cómo te viene mejor?</h3>
    <div class="mt-5 grid gap-2.5">
      {formats.map((o) => <button type="button" class="quiz-option" data-format={o.value}>{o.label}</button>)}
    </div>
    <button type="button" class="quiz-back" data-back="previous">Atrás</button>
  </div>

  <div class="quiz-step hidden" data-step="result">
    <h3 class="text-2xl font-bold text-primary" tabindex="-1" data-result-title></h3>
    <ul class="checklist mt-4" data-result-points></ul>
    <p class="mt-4 font-semibold" data-result-price></p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a class="btn-primary" target="_blank" rel="noopener" data-result-cta data-event-location="quiz_result" href="#"></a>
      <a
        class="btn-whatsapp"
        target="_blank"
        rel="noopener"
        data-event="whatsapp_click"
        data-event-location="quiz_result"
        href={SITE.whatsapp}>Escríbeme por WhatsApp</a
      >
    </div>
    <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
      <a class="font-semibold text-primary underline decoration-line underline-offset-4" data-result-link data-event="quiz_result_link" href="#"
        >Saber más sobre esto</a
      >
      <button type="button" class="font-semibold text-muted underline decoration-line underline-offset-4" data-restart>Volver a empezar</button>
    </div>
    <p class="mt-6 border-t border-line/60 pt-4 text-sm text-muted">
      Esto es una orientación, no una valoración profesional. Si ahora mismo estás en peligro o
      piensas en hacerte daño, llama al <a class="font-semibold underline" href="tel:024">024</a> (gratis,
      24 horas) o al <a class="font-semibold underline" href="tel:112">112</a>.
    </p>
  </div>

  <script is:inline type="application/json" data-config set:html={JSON.stringify(config)} />
</div>

<style>
  .quiz-option {
    min-height: 3.25rem;
    width: 100%;
    border-radius: 1rem;
    border: 1.5px solid color-mix(in srgb, var(--color-line) 80%, white);
    background: var(--color-bg);
    padding: 0.8rem 1.1rem;
    text-align: left;
    font-weight: 600;
    color: var(--color-ink);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .quiz-option:hover {
    border-color: var(--color-primary);
    background: var(--color-surface);
  }
  .quiz-back {
    margin-top: 1rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>

<script>
  type Result = { title: string; points: string[]; href: string };
  type Config = {
    results: Record<string, Result>;
    priceLines: Record<string, string>;
    booking: string;
    whatsapp: string;
    freeCall: string;
    firstLabel: string;
  };

  document.querySelectorAll<HTMLElement>('.orientation-quiz').forEach((root) => {
    const config: Config = JSON.parse(root.querySelector('script[data-config]')?.textContent || '{}');
    const announce = root.querySelector<HTMLElement>('[data-announce]');
    const state = { start: '', topic: '', format: '', previous: 'start' };
    let started = false;

    const track = (name: string, data?: Record<string, string | number>) =>
      document.dispatchEvent(new CustomEvent('site:event', { detail: { name, data } }));

    const show = (name: string) => {
      root.querySelectorAll<HTMLElement>('.quiz-step').forEach((s) => s.classList.toggle('hidden', s.dataset.step !== name));
      const heading = root.querySelector<HTMLElement>(`.quiz-step[data-step="${name}"] h3`);
      if (announce && heading) announce.textContent = heading.textContent ?? '';
      heading?.focus({ preventScroll: true });
    };

    const buildResult = () => {
      const key = state.start === 'couple' ? 'couple' : state.start === 'unsure' ? 'unsure' : state.topic;
      const r = config.results[key] ?? config.results.unsure;
      const priceKey = key === 'couple' ? 'couple' : state.format || 'either';

      root.querySelector('[data-result-title]')!.textContent = r.title;
      const list = root.querySelector('[data-result-points]')!;
      list.textContent = '';
      for (const p of r.points) {
        const li = document.createElement('li');
        li.textContent = p;
        list.appendChild(li);
      }
      root.querySelector('[data-result-price]')!.textContent = config.priceLines[priceKey] ?? '';

      const cta = root.querySelector<HTMLAnchorElement>('[data-result-cta]')!;
      const unsure = key === 'unsure';
      cta.href = unsure ? config.freeCall : config.booking;
      cta.textContent = unsure
        ? 'Pedir llamada gratuita de 15 min'
        : key === 'couple'
          ? 'Reservar sesión de pareja'
          : config.firstLabel;
      cta.dataset.event = unsure ? 'free_call_click' : 'booking_click';

      root.querySelector<HTMLAnchorElement>('[data-result-link]')!.href = r.href;
      track('quiz_complete');
      show('result');
    };

    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn || !root.contains(btn)) return;

      if (btn.dataset.start) {
        if (!started) track('quiz_start');
        started = true;
        state.start = btn.dataset.start;
        state.topic = '';
        state.previous = btn.dataset.next === 'format' ? 'start' : btn.dataset.next ?? 'start';
        track('quiz_step', { step: 1 });
        show(btn.dataset.next ?? 'format');
      } else if (btn.dataset.topic) {
        state.topic = btn.dataset.topic;
        track('quiz_step', { step: 2 });
        show('format');
      } else if (btn.dataset.format) {
        state.format = btn.dataset.format;
        track('quiz_step', { step: 3 });
        buildResult();
      } else if (btn.dataset.back) {
        show(btn.dataset.back === 'previous' ? state.previous : btn.dataset.back);
      } else if (btn.hasAttribute('data-restart')) {
        state.start = state.topic = state.format = '';
        show('start');
      }
    });
  });
</script>
