---
import { SITE } from '../consts';

// Orientation quiz (not a diagnosis). It guides the visitor to the closest
// specialty and to the first step (booking or contact). All the logic lives
// in the <script> below and works through data attributes.

// Analytics only records that a step was completed, never the answer: the
// answers describe the visitor's state of mind, which is health data.

const areas = [
  { key: 'anxiety', label: 'Ansiedad o preocupación constante' },
  { key: 'stress', label: 'Estrés, agotamiento o burnout' },
  { key: 'attachment', label: 'Relaciones, apego o miedo al rechazo' },
  { key: 'self_esteem', label: 'Autoestima y autoexigencia' },
  { key: 'trauma', label: 'Experiencias difíciles o trauma' },
  { key: 'couple', label: 'Dificultades en la pareja' },
  { key: 'unsure', label: 'No lo tengo claro todavía' },
];

// What the quiz gives back: for each area, a validating headline (not an echo
// of the answer) and 3 concrete points on how it is worked on in sessions.
const results = {
  anxiety: {
    title: 'La ansiedad tiene salida, y responde muy bien a la terapia',
    points: [
      'Entenderás por qué se activa tu alarma interna y qué la mantiene.',
      'Aprenderás a regular tu sistema nervioso con herramientas prácticas.',
      'Recuperarás la calma y la capacidad de disfrutar del presente.',
    ],
    href: '/terapia-psicologica#ansiedad',
  },
  stress: {
    title: 'El agotamiento es una señal, no una debilidad',
    points: [
      'Identificaremos qué te está drenando y qué lo sostiene.',
      'Aprenderás a poner límites sin sentirte culpable.',
      'Recuperarás la energía y la motivación, paso a paso.',
    ],
    href: '/terapia-psicologica#estres',
  },
  attachment: {
    title: 'Los patrones que se aprendieron también se pueden cambiar',
    points: [
      'Entenderás tu historia de vínculos y por qué se repiten patrones.',
      'Trabajaremos la seguridad y la confianza en tus relaciones.',
      'Construirás vínculos más sanos, también contigo.',
    ],
    href: '/terapia-psicologica#apego',
  },
  self_esteem: {
    title: 'Esa voz crítica no eres tú, y se puede transformar',
    points: [
      'Entenderás de dónde viene tanta autoexigencia.',
      'Aprenderás a tratarte con la misma amabilidad que a los demás.',
      'Reconocerás tu valor y te resultará más fácil poner límites.',
    ],
    href: '/terapia-psicologica#autoestima',
  },
  trauma: {
    title: 'El pasado no tiene por qué seguir dirigiendo tu presente',
    points: [
      'Procesaremos esas experiencias con EMDR, siempre a tu ritmo.',
      'Recuperarás la sensación de seguridad y de control.',
      'Sin necesidad de revivir el dolor una y otra vez.',
    ],
    href: '/terapia-psicologica#trauma',
  },
  couple: {
    title: 'Pedir ayuda a tiempo puede transformar la relación',
    points: [
      'Mejoraréis la comunicación y la gestión de los conflictos.',
      'Entenderéis qué hay debajo de las discusiones que se repiten.',
      'Recuperaréis la conexión y la confianza.',
    ],
    href: '/terapia-de-pareja',
  },
  unsure: {
    title: 'No pasa nada por no tenerlo claro',
    points: [
      'La primera sesión sirve exactamente para eso.',
      'Exploraremos qué te ocurre, sin prisa y sin juicios.',
      'No necesitas ponerle nombre todavía.',
    ],
    href: '/contacto',
  },
};

const durations = [
  { key: 'recent', label: 'Hace poco, días o semanas' },
  { key: 'months', label: 'Desde hace varios meses' },
  { key: 'chronic', label: 'Hace más de un año' },
];

const formats = [
  { key: 'in_person', label: 'Presencial en Barcelona' },
  { key: 'online', label: 'Online' },
  { key: 'either', label: 'Me da igual / no lo sé' },
];
---

<div
  class="orientation-quiz mx-auto w-[min(760px,100%)] rounded-3xl border border-forest-soft/40 bg-white p-6 shadow-forest sm:p-9"
  data-doctoralia={SITE.doctoralia}
  data-whatsapp={SITE.whatsapp}
>
  <!-- Progress -->
  <div class="mb-7 flex items-center justify-center gap-2" data-progress aria-hidden="true">
    <span class="h-1.5 w-8 rounded-full bg-forest transition-colors" data-dot="0"></span>
    <span class="h-1.5 w-8 rounded-full bg-forest-soft/40 transition-colors" data-dot="1"></span>
    <span class="h-1.5 w-8 rounded-full bg-forest-soft/40 transition-colors" data-dot="2"></span>
  </div>

  <!-- Step 1: area -->
  <div class="quiz-step" data-step="0">
    <p class="eyebrow text-center">Paso 1 de 3</p>
    <h3 class="text-center font-display text-2xl font-bold text-forest-dark sm:text-3xl">
      ¿Con qué te identificas más ahora mismo?
    </h3>
    <div class="mt-7 grid gap-3 sm:grid-cols-2">
      {
        areas.map((a) => (
          <button type="button" class="quiz-option" data-area={a.key}>
            {a.label}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Step 2: duration -->
  <div class="quiz-step hidden" data-step="1">
    <p class="eyebrow text-center">Paso 2 de 3</p>
    <h3 class="text-center font-display text-2xl font-bold text-forest-dark sm:text-3xl">
      ¿Desde cuándo lo notas?
    </h3>
    <div class="mt-7 grid gap-3">
      {
        durations.map((t) => (
          <button type="button" class="quiz-option" data-duration={t.key}>
            {t.label}
          </button>
        ))
      }
    </div>
    <div class="mt-6 text-center">
      <button type="button" class="quiz-back" data-back>← Atrás</button>
    </div>
  </div>

  <!-- Step 3: format -->
  <div class="quiz-step hidden" data-step="2">
    <p class="eyebrow text-center">Paso 3 de 3</p>
    <h3 class="text-center font-display text-2xl font-bold text-forest-dark sm:text-3xl">
      ¿Cómo prefieres la terapia?
    </h3>
    <div class="mt-7 grid gap-3">
      {
        formats.map((m) => (
          <button type="button" class="quiz-option" data-format={m.key}>
            {m.label}
          </button>
        ))
      }
    </div>
    <div class="mt-6 text-center">
      <button type="button" class="quiz-back" data-back>← Atrás</button>
    </div>
  </div>

  <!-- Result -->
  <div class="quiz-step hidden" data-step="result" aria-live="polite">
    <div class="text-center">
      <span
        class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-forest-light text-forest"
        aria-hidden="true"
      >
        <svg
          width="26"
          height="26"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M14.8 9.2l-1.9 4.6-4.7 2 1.9-4.6 4.7-2z"></path>
        </svg>
      </span>
      <h3 class="mt-4 font-display text-2xl font-bold text-forest-dark sm:text-3xl" data-result-title>
      </h3>
      <p class="mx-auto mt-4 max-w-[52ch] text-ink-soft" data-result-text></p>
      <div class="mx-auto mt-6 max-w-[52ch] rounded-2xl bg-forest-light/60 p-5 text-left sm:p-6">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.12em] text-forest">
          Así lo trabajaremos en consulta
        </p>
        <ul class="checklist space-y-2 text-base text-ink" data-result-points></ul>
      </div>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a class="btn-primary" data-result-cta href="#">Reservar primera sesión</a>
        <a
          class="font-semibold text-forest-dark underline decoration-forest-soft underline-offset-4 hover:text-forest"
          data-result-link
          href="#">Ver más</a
        >
      </div>
      <p class="mx-auto mt-7 max-w-[46ch] text-sm text-ink-soft">
        Esta orientación es informativa y no sustituye una valoración profesional.
      </p>
      <button type="button" class="quiz-back mt-3" data-restart>↺ Empezar de nuevo</button>
    </div>
  </div>

  <script type="application/json" data-results set:html={JSON.stringify(results)} />
</div>

<style>
  .quiz-step {
    animation: quiz-fade 0.32s ease both;
  }
  .quiz-option {
    width: 100%;
    text-align: left;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-forest-soft) 55%, white);
    background: var(--color-cream);
    padding: 0.95rem 1.15rem;
    font-weight: 600;
    color: var(--color-forest-dark);
    transition: all 0.18s ease;
  }
  .quiz-option:hover {
    border-color: var(--color-forest);
    background: var(--color-forest-light);
    transform: translateY(-2px);
  }
  .quiz-back {
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    transition: color 0.18s ease;
  }
  .quiz-back:hover {
    color: var(--color-forest);
  }
  @keyframes quiz-fade {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .quiz-step { animation: none; }
    .quiz-option:hover { transform: none; }
  }
</style>

<script>
  function initQuiz() {
    document.querySelectorAll<HTMLElement>('.orientation-quiz').forEach((root) => {
      if (root.dataset.ready === '1') return;
      root.dataset.ready = '1';

      const steps = root.querySelectorAll<HTMLElement>('.quiz-step');
      const dots = root.querySelectorAll<HTMLElement>('[data-dot]');
      const doctoralia = root.dataset.doctoralia || '#';
      const whatsapp = root.dataset.whatsapp || '#';

      const track = (name: string, data?: Record<string, string | number>) =>
        document.dispatchEvent(new CustomEvent('site:event', { detail: { name, data } }));

      const results = JSON.parse(
        root.querySelector('script[data-results]')?.textContent || '{}'
      );
      const state = { area: '', duration: '', format: '' };

      const show = (name: string) => {
        steps.forEach((s) => s.classList.toggle('hidden', s.dataset.step !== name));
        // Restart the entrance animation
        const active = root.querySelector<HTMLElement>(`.quiz-step[data-step="${name}"]`);
        if (active) {
          active.style.animation = 'none';
          void active.offsetWidth;
          active.style.animation = '';
        }
        const idx = Number(name);
        dots.forEach((d, i) => {
          const done = !Number.isNaN(idx) && i <= idx;
          d.classList.toggle('bg-forest', done);
          d.classList.toggle('bg-forest-soft/40', !done);
        });
      };

      const durationPhrase: Record<string, string> = {
        recent: 'Has dado el paso pronto, y eso juega a tu favor.',
        months: 'Llevas un tiempo sosteniéndolo. Pedir apoyo ahora tiene mucho sentido.',
        chronic: 'Llevas conviviendo con ello demasiado tiempo: mereces un espacio para soltarlo.',
      };
      const formatPhrase: Record<string, string> = {
        in_person: 'de forma presencial en la consulta de Barcelona',
        online: 'por videollamada, estés donde estés',
        either: 'en formato presencial u online, como mejor encaje contigo',
      };

      const buildResult = () => {
        const titleEl = root.querySelector<HTMLElement>('[data-result-title]');
        const textEl = root.querySelector<HTMLElement>('[data-result-text]');
        const pointsEl = root.querySelector<HTMLElement>('[data-result-points]');
        const cta = root.querySelector<HTMLAnchorElement>('[data-result-cta]');
        const link = root.querySelector<HTMLAnchorElement>('[data-result-link]');

        const isUnsure = state.area === 'unsure';
        const r = results[state.area] || results.unsure;

        if (titleEl) titleEl.textContent = r.title;
        if (textEl) {
          const durationText = durationPhrase[state.duration] || '';
          const formatText = formatPhrase[state.format] || '';
          textEl.textContent = isUnsure
            ? `${durationText} Podemos verlo en una primera sesión ${formatText}, sin compromiso.`
            : `${durationText} Podemos trabajarlo ${formatText}.`;
        }
        if (pointsEl) {
          pointsEl.textContent = '';
          for (const p of r.points) {
            const li = document.createElement('li');
            li.textContent = p;
            pointsEl.appendChild(li);
          }
        }
        if (cta) {
          cta.href = isUnsure ? whatsapp : doctoralia;
          cta.textContent = isUnsure ? 'Escríbeme por WhatsApp' : 'Reservar primera sesión';
          // Both targets are external, so the state must not carry over between retries.
          cta.target = '_blank';
          cta.rel = 'noopener';
          // The target depends on the result, and so does the event name: the
          // click counts as a booking or as WhatsApp, not as a quiz button.
          cta.dataset.event = isUnsure ? 'whatsapp_click' : 'booking_click';
          cta.dataset.eventLocation = 'quiz_result';
        }
        if (link) {
          link.href = r.href;
          link.textContent = isUnsure ? 'O escríbeme un email' : 'Conocer más sobre este proceso';
          // No target in the event: the link reveals the chosen area.
          link.dataset.event = 'quiz_result_link';
        }
        track('quiz_complete');
        show('result');
      };

      root.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('button');
        if (!btn || !root.contains(btn)) return;

        if (btn.hasAttribute('data-restart')) {
          state.area = state.duration = state.format = '';
          show('0');
          return;
        }
        if (btn.hasAttribute('data-back')) {
          const current = root.querySelector<HTMLElement>('.quiz-step:not(.hidden)');
          const step = current?.dataset.step;
          if (step === '1') show('0');
          else if (step === '2') show('1');
          return;
        }
        if (btn.dataset.area) {
          state.area = btn.dataset.area;
          track('quiz_step', { step: 1 });
          show('1');
          return;
        }
        if (btn.dataset.duration) {
          state.duration = btn.dataset.duration;
          track('quiz_step', { step: 2 });
          show('2');
          return;
        }
        if (btn.dataset.format) {
          state.format = btn.dataset.format;
          track('quiz_step', { step: 3 });
          buildResult();
          return;
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initQuiz);
</script>
