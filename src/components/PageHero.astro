---
import Wave from './Wave.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="bg-surface">
  <div class="mx-auto w-[min(820px,calc(100%-2rem))] pb-8 pt-12 text-center md:pb-12 md:pt-20">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="text-[2.1rem] font-bold leading-tight text-primary md:text-5xl">{title}</h1>
    {lead && <p class="mx-auto mt-4 max-w-[60ch] text-lg">{lead}</p>}
  </div>
</section>
<Wave from="var(--color-surface)" to="var(--color-bg)" />
