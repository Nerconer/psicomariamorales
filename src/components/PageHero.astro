---
import Wave from './Wave.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="bg-surface">
  <div class="mx-auto w-[min(820px,92%)] pb-10 pt-16 text-center md:pb-14 md:pt-24">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="font-display text-4xl font-semibold text-primary-strong md:text-5xl">{title}</h1>
    {lead && <p class="mx-auto mt-5 max-w-[62ch] text-lg text-muted">{lead}</p>}
  </div>
</section>
<Wave from="var(--color-surface)" to="var(--color-bg)" />
