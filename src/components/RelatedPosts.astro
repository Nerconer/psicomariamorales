---
import type { CollectionEntry } from 'astro:content';
import { categoryBadgeClass } from '../lib/categories';
import { localeFromPath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const t = useTranslations(localeFromPath(Astro.url.pathname));

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

{
  posts.length > 0 && (
    <section aria-labelledby="seguir-leyendo" class="py-16 md:py-20">
      <div class="mx-auto w-[min(1120px,92%)]">
        <h2
          id="seguir-leyendo"
          class="mb-8 font-display text-3xl font-semibold md:text-4xl"
        >
          {t('related.title')}
        </h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}/`}
              data-event="related_post_click"
              data-event-post={post.id}
              class="card group flex flex-col"
            >
              <span
                class={`mb-4 ${categoryBadgeClass(post.data.tag)}`}
              >
                {post.data.tag}
              </span>
              <h3 class="font-display text-xl font-semibold leading-snug group-hover:text-primary">
                {post.data.title}
              </h3>
              <p class="mt-3 flex-1 text-base text-muted">{post.data.description}</p>
              <p class="mt-5 text-sm uppercase tracking-wider text-muted">
                {formatDate(post.data.pubDate)}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
