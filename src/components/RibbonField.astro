---
interface Props {
  tone?: 'soft' | 'light';
  class?: string;
}

const { tone = 'soft', class: className = '' } = Astro.props;
const uid = `ribbon-${Math.random().toString(36).slice(2, 9)}`;

const primary = Array.from({ length: 20 }, (_, i) => {
  const offset = i * 10;
  return `M -80 ${535 + offset * 0.2} C ${210 + offset * 0.7} ${425 - offset * 1.25}, ${360 + offset * 1.4} ${150 + offset * 0.45}, ${650 + offset * 0.5} ${255 - offset * 0.35} S ${980 + offset * 0.9} ${190 - offset * 1.05}, 1280 ${-30 + offset * 0.2}`;
});

const secondary = Array.from({ length: 14 }, (_, i) => {
  const offset = i * 12;
  return `M 1280 ${480 + offset * 0.3} C ${1030 - offset * 0.6} ${330 - offset}, ${920 - offset * 1.1} ${100 + offset * 0.65}, ${690 - offset * 0.45} ${225 + offset * 0.25} S ${310 - offset * 0.35} ${410 + offset * 0.55}, -80 ${300 - offset * 0.25}`;
});
---

<svg
  class:list={['ribbon-field', `ribbon-field--${tone}`, className]}
  viewBox="0 0 1200 650"
  fill="none"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={`${uid}-primary`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color={tone === 'light' ? '#ffffff' : '#95b8a6'} stop-opacity="0" />
      <stop offset="0.38" stop-color={tone === 'light' ? '#ffffff' : '#2d6a4f'} stop-opacity={tone === 'light' ? '0.34' : '0.32'} />
      <stop offset="0.72" stop-color={tone === 'light' ? '#dcd2f0' : '#b7a4dc'} stop-opacity="0.38" />
      <stop offset="1" stop-color="#f2a38a" stop-opacity="0" />
    </linearGradient>
    <linearGradient id={`${uid}-secondary`} x1="1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#dcd2f0" stop-opacity="0" />
      <stop offset="0.48" stop-color={tone === 'light' ? '#ffffff' : '#b7a4dc'} stop-opacity="0.28" />
      <stop offset="0.8" stop-color="#f2a38a" stop-opacity="0.22" />
      <stop offset="1" stop-color="#95b8a6" stop-opacity="0" />
    </linearGradient>
  </defs>
  <g class="ribbon-layer ribbon-layer-a">
    {primary.map((d) => <path d={d} stroke={`url(#${uid}-primary)`} />)}
  </g>
  <g class="ribbon-layer ribbon-layer-b">
    {secondary.map((d) => <path d={d} stroke={`url(#${uid}-secondary)`} />)}
  </g>
</svg>

<style>
  .ribbon-field {
    pointer-events: none;
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(90deg, transparent, #000 17%, #000 90%, transparent);
  }
  path { stroke-width: 0.85; vector-effect: non-scaling-stroke; }
  .ribbon-layer-a { transform-origin: 62% 48%; animation: breathe 15s ease-in-out infinite alternate; }
  .ribbon-layer-b { transform-origin: 58% 44%; animation: breathe-reverse 19s ease-in-out -6s infinite alternate; }
  @keyframes breathe { to { transform: translate3d(1.4%, -1.2%, 0) rotate(0.8deg) scaleY(1.035); } }
  @keyframes breathe-reverse { to { transform: translate3d(-1%, 1.4%, 0) rotate(-0.65deg) scaleY(0.97); } }
  @media (prefers-reduced-motion: reduce) {
    .ribbon-layer { animation: none !important; }
  }
</style>
