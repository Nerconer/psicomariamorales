---
// Wave-shaped section divider.
// `from`: colour of the previous section (above the wave)
// `to`: colour of the next section (wave fill)
interface Props {
  from: string;
  to: string;
}
const { from, to } = Astro.props;
---

<div aria-hidden="true" class="leading-none" style={`background:${from}`}>
  <svg viewBox="0 0 1440 72" preserveAspectRatio="none" class="block h-10 w-full md:h-[72px]">
    <path d="M0,40 C180,72 420,4 720,20 C1020,36 1260,76 1440,32 L1440,72 L0,72 Z" fill={to}
    ></path>
  </svg>
</div>
