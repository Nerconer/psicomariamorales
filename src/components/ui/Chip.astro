---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  /** `highlight` fills the chip to point out one option among several. */
  tone?: 'default' | 'highlight';
  icon?: IconName;
}
const { tone = 'default', icon } = Astro.props;
---

<!-- White with a border by default, so it shows on any section background. -->
<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-semibold text-ink',
    tone === 'highlight' ? 'bg-highlight' : 'border border-line bg-white',
  ]}
>
  {icon && <Icon name={icon} size={16} class={tone === 'highlight' ? undefined : 'text-primary'} />}
  <slot />
</span>
