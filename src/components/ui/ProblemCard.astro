---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href: string;
  title: string;
  icon: IconName;
  text?: string;
}
const { href, title, icon, text } = Astro.props;
---

<a href={href} class="card group relative flex flex-col gap-1 p-4! sm:p-5!">
  <span class="mb-2 grid h-11 w-11 place-items-center rounded-full bg-surface text-primary" aria-hidden="true">
    <Icon name={icon} />
  </span>
  <span class="font-display text-base font-bold leading-snug text-ink sm:text-lg">{title}</span>
  {text && <span class="text-sm leading-relaxed text-muted sm:text-base">{text}</span>}
  <!-- Appears on hover to show the card leads to its own page. -->
  <Icon
    name="arrow"
    size={18}
    class="absolute right-4 top-5 -translate-x-1 text-primary opacity-0 transition duration-200 group-hover:translate-x-0 group-hover:opacity-100 sm:right-5 sm:top-6"
  />
</a>
