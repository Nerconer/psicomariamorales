---
// Self-hosted fonts (no Google CDN): better performance and the visitor's IP
// is not sent to a third party (relevant for GDPR on a health website). Only
// the .woff2 of the subset in use is downloaded.
import '@fontsource-variable/plus-jakarta-sans/index.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import WhatsAppIcon from '../components/ui/WhatsAppIcon.astro';
import { SITE, PRICE_RANGE } from '../consts';
import { LOCALES, DEFAULT_LOCALE, localeFromPath } from '../i18n/config';
import { alternatesOf } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
}

const {
  title,
  description = 'Maria Morales, psicóloga sanitaria en Barcelona. Consulta de psicología presencial y terapia online: trauma, EMDR, ansiedad, burnout, autoestima y terapia de pareja.',
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
// hreflang only when the page really exists in another language.
const alternates = alternatesOf(Astro.url.pathname);
const defaultAlternate = alternates.find((a) => a.locale === DEFAULT_LOCALE);
const ogImage = new URL('/og.jpg', Astro.site);

// Local business entity (schema.org) for searches such as "psicóloga Barcelona"
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'LocalBusiness'],
  '@id': new URL('/', Astro.site).href,
  name: 'Maria Morales · Psicóloga sanitaria en Barcelona',
  alternateName: SITE.brand,
  description:
    'Psicóloga sanitaria en Barcelona. Terapia psicológica presencial y online: trauma y EMDR, ansiedad, estrés, burnout, autoestima, apego y terapia de pareja.',
  url: new URL('/', Astro.site).href,
  image: ogImage.href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Carrer de los Castillejos, 326',
    postalCode: '08025',
    addressLocality: 'Barcelona',
    addressRegion: 'Barcelona',
    addressCountry: 'ES',
  },
  areaServed: [
    { '@type': 'City', name: 'Barcelona' },
    { '@type': 'Country', name: 'España' },
  ],
  telephone: SITE.phone,
  priceRange: PRICE_RANGE,
  currenciesAccepted: 'EUR',
  sameAs: [SITE.doctoralia, SITE.linkedin, SITE.copc],
  founder: {
    '@type': 'Person',
    name: 'Maria Morales Herrerías',
    jobTitle: 'Psicóloga General Sanitaria',
    identifier: `Colegiada n.º ${SITE.licenseNumber}`,
  },
  knowsAbout: [
    'Psicología sanitaria',
    'Trauma y trauma complejo',
    'EMDR',
    'Ansiedad',
    'Estrés y burnout',
    'Autoestima',
    'Apego',
    'Regulación emocional',
    'Terapia de pareja',
    'Terapia online',
  ],
};
---

<!doctype html>
<html lang={LOCALES[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · {SITE.person}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={LOCALES[a.locale].hreflang} href={new URL(a.path, Astro.site)} />
      ))
    }
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate.path, Astro.site)} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.person} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta
      property="og:image:alt"
      content="Maria Morales, psicóloga general sanitaria en Barcelona. Terapia presencial y online."
    />
    <meta property="og:locale" content={LOCALES[locale].ogLocale} />
    {
      alternates
        .filter((a) => a.locale !== locale)
        .map((a) => <meta property="og:locale:alternate" content={LOCALES[a.locale].ogLocale} />)
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="Maria Morales, psicóloga general sanitaria en Barcelona. Terapia presencial y online."
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

    <slot name="head" />

    <Analytics />

  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-primary-strong focus:shadow-lg">{t('a11y.skip')}</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <!-- Floating WhatsApp button (desktop). Mobile uses the action bar. -->
    <a
      href={SITE.whatsapp}
      target="_blank"
      rel="noopener"
      aria-label={t('cta.whatsappLong')}
      data-event="whatsapp_click"
      data-event-location="floating_button"
      class="fixed bottom-5 right-5 z-50 hidden h-14 w-14 place-items-center rounded-full bg-[#128c4a] text-white shadow-lg transition-transform duration-200 hover:scale-105 md:grid"
    >
      <WhatsAppIcon size={28} />
    </a>
    <MobileActionBar />
  </body>
</html>
