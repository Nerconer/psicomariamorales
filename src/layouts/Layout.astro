---
// Self-hosted fonts (no Google CDN): better performance and the visitor's IP
// is not sent to a third party (relevant for GDPR on a health website). Only
// the .woff2 of the subset in use is downloaded.
import '@fontsource-variable/plus-jakarta-sans/index.css';
// Preloaded so the text does not jump when the font arrives (layout shift).
import jakartaLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import WhatsAppIcon from '../components/ui/WhatsAppIcon.astro';
import { SITE, PRICES, PRICE_RANGE } from '../consts';
import { OG_KEYS } from '../data/og';
import { LOCALES, DEFAULT_LOCALE, localeFromPath } from '../i18n/config';
import { alternatesOf, ROUTES } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
}

const {
  title,
  description = 'Maria Morales, psicóloga sanitaria en Barcelona. Consulta de psicología presencial y terapia online: trauma, EMDR, ansiedad, burnout, autoestima y terapia de pareja.',
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const imageAlt =
  locale === 'ca'
    ? 'Maria Morales, psicòloga general sanitària. Teràpia en línia i presencial a Barcelona.'
    : 'Maria Morales, psicóloga general sanitaria. Terapia online y presencial en Barcelona.';
// hreflang only when the page really exists in another language.
const alternates = alternatesOf(Astro.url.pathname);
const defaultAlternate = alternates.find((a) => a.locale === DEFAULT_LOCALE);
// Share image: each translated page has its own (built by src/pages/og/),
// the rest use the home image of their language.
const routeKey = Object.entries(ROUTES).find(([, r]) => Object.values(r).includes(Astro.url.pathname))?.[0];
const ogKey = (OG_KEYS as readonly string[]).includes(routeKey ?? '') ? routeKey : 'home';
const ogImage = new URL(`/og/${localeFromPath(Astro.url.pathname)}-${ogKey}.jpg`, Astro.site);

// Local business entity (schema.org) for searches such as "psicóloga Barcelona"
const siteUrl = new URL('/', Astro.site).href;
const offer = (name: string, key: keyof typeof PRICES) => ({
  '@type': 'Offer',
  name,
  price: PRICES[key].amount,
  priceCurrency: 'EUR',
});

const personSchema = {
  '@type': 'Person',
  '@id': `${siteUrl}#maria`,
  name: 'Maria Morales Herrerías',
  jobTitle: SITE.role,
  url: new URL('/sobre-mi/', Astro.site).href,
  image: new URL('/og/es-about.jpg', Astro.site).href,
  knowsLanguage: ['es', 'ca'],
  sameAs: [SITE.copc, SITE.doctoralia, SITE.linkedin],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'Colegiación profesional',
    name: `Psicóloga General Sanitaria, colegiada n.º ${SITE.licenseNumber}`,
    recognizedBy: { '@type': 'Organization', name: "Col·legi Oficial de Psicologia de Catalunya", url: 'https://www.copc.cat/' },
  },
};

// Local business entity (schema.org) for searches such as "psicóloga Barcelona"
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'LocalBusiness'],
  '@id': `${siteUrl}#consulta`,
  name: `${SITE.person}, ${SITE.role}`,
  description:
    'Psicóloga general sanitaria. Terapia psicológica online en toda España y presencial en Barcelona: ansiedad, estrés, burnout, autoestima, duelo, trauma con EMDR y terapia de pareja.',
  url: siteUrl,
  image: new URL('/og/es-home.jpg', Astro.site).href,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  telephone: SITE.phone,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.postalAddress.street,
    postalCode: SITE.postalAddress.postalCode,
    addressLocality: SITE.postalAddress.locality,
    addressRegion: 'Barcelona',
    addressCountry: 'ES',
  },
  geo: { '@type': 'GeoCoordinates', ...SITE.geo },
  hasMap: SITE.maps,
  areaServed: [
    { '@type': 'City', name: 'Barcelona' },
    { '@type': 'Country', name: 'España' },
  ],
  availableLanguage: ['es', 'ca'],
  priceRange: PRICE_RANGE,
  currenciesAccepted: 'EUR',
  paymentAccepted: 'Efectivo, transferencia, Bizum',
  sameAs: [SITE.doctoralia, SITE.linkedin, SITE.copc, SITE.maps],
  founder: personSchema,
  makesOffer: [
    offer('Primera sesión de terapia individual', 'firstSession'),
    offer('Terapia psicológica online', 'online'),
    offer('Terapia psicológica presencial en Barcelona', 'inPerson'),
    offer('Terapia de pareja', 'couple'),
  ],
  knowsAbout: [
    'Psicología sanitaria',
    'Ansiedad',
    'Estrés y burnout',
    'Autoestima',
    'Duelo',
    'Trauma y trauma complejo',
    'EMDR',
    'Apego',
    'Regulación emocional',
    'Terapia de pareja',
    'Terapia online',
  ],
};
---

<!doctype html>
<html lang={LOCALES[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · {SITE.person}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={jakartaLatin} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={LOCALES[a.locale].hreflang} href={new URL(a.path, Astro.site)} />
      ))
    }
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate.path, Astro.site)} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.person} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta
      property="og:image:alt"
      content={imageAlt}
    />
    <meta property="og:locale" content={LOCALES[locale].ogLocale} />
    {
      alternates
        .filter((a) => a.locale !== locale)
        .map((a) => <meta property="og:locale:alternate" content={LOCALES[a.locale].ogLocale} />)
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content={imageAlt}
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

    <slot name="head" />

    <Analytics />

  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-primary-strong focus:shadow-lg">{t('a11y.skip')}</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <!-- Floating WhatsApp button (desktop). Mobile uses the action bar. -->
    <a
      href={SITE.whatsapp}
      target="_blank"
      rel="noopener"
      aria-label={t('cta.whatsappLong')}
      data-event="whatsapp_click"
      data-event-location="floating_button"
      class="fixed bottom-5 right-5 z-50 hidden h-14 w-14 place-items-center rounded-full bg-[#128c4a] text-white shadow-lg transition-transform duration-200 hover:scale-105 md:grid"
    >
      <WhatsAppIcon size={28} />
    </a>
    <MobileActionBar />
  </body>
</html>
