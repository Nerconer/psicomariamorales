---
import ServiceView from '../views/ServiceView.astro';
import { SERVICES, serviceSlug } from '../data/services';
import { getPublishedPosts } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return SERVICES.map((service) => ({
    params: { service: serviceSlug(service, 'es') },
    props: {
      service,
      related: service.posts.map((slug) => posts.find((p) => p.id === slug)).filter((p) => p !== undefined),
    },
  }));
}

const { service, related } = Astro.props;
---

<ServiceView service={service} locale="es" related={related} />
