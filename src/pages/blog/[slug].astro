---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import Icon from '../../components/ui/Icon.astro';
import WhatsAppIcon from '../../components/ui/WhatsAppIcon.astro';
import { buildRelatedMap } from '../../lib/related';
import { categoryBadgeClass } from '../../lib/categories';
import { getPublishedPosts, getDraftSlugs, unlinkDrafts } from '../../lib/posts';
import { SERVICES, serviceSlug } from '../../data/services';
import { SITE } from '../../consts';
import mariaHero from '../../assets/img/maria-hero.jpg';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const relatedMap = buildRelatedMap(posts);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedMap.get(post.id) ?? [] },
  }));
}

const { post, related } = Astro.props;
// Markdown posts have no components, so their rendered HTML is used directly.
const html = unlinkDrafts(post.rendered?.html ?? '', await getDraftSlugs());

const formatDate = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 200));

// Page the post leads to at the end. Service landings carry their own title;
// the few other pages are named here.
const OTHER_PAGES: Record<string, string> = {
  'terapia-de-pareja': 'Terapia de pareja',
  'terapia-psicologica': 'Terapia psicológica',
  'sobre-mi': 'Sobre mí',
};
const target = post.data.service
  ? {
      href: `/${post.data.service}/`,
      label:
        SERVICES.find((s) => serviceSlug(s, 'es') === post.data.service)?.es.title ?? OTHER_PAGES[post.data.service] ?? 'Terapia psicológica',
    }
  : { href: '/terapia-psicologica/', label: 'Terapia psicológica' };

const url = new URL(Astro.url.pathname, Astro.site).href;
const authorUrl = new URL('/sobre-mi/', Astro.site).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: 'es',
  mainEntityOfPage: url,
  image: new URL('/og.jpg', Astro.site).href,
  author: {
    '@type': 'Person',
    name: 'Maria Morales Herrerías',
    jobTitle: SITE.role,
    url: authorUrl,
    sameAs: [SITE.copc, SITE.doctoralia, SITE.linkedin],
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.person,
    logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', Astro.site).href },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
  ],
};
---

<Layout title={post.data.seoTitle ?? post.data.title} description={post.data.description} ogType="article">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <article data-article={post.id}>
    <header class="bg-surface">
      <div class="mx-auto w-[min(760px,calc(100%-2rem))] py-10 md:py-16">
        <nav aria-label="Ruta de navegación" class="text-sm text-muted">
          <ol class="flex flex-wrap items-center gap-1.5">
            <li><a href="/" class="hover:text-primary">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/blog/" class="hover:text-primary">Blog</a></li>
          </ol>
        </nav>
        <span class={`mt-5 ${categoryBadgeClass(post.data.tag)}`}>
          {post.data.tag}
        </span>
        <h1 class="mt-4 text-[2rem] font-bold leading-tight md:text-5xl">{post.data.title}</h1>
        <p class="mt-4 text-sm text-muted">
          {formatDate(post.data.pubDate)} · {readingMinutes} min de lectura ·{' '}
          <a href="/sobre-mi/" class="underline decoration-primary/30 underline-offset-4 hover:text-primary">{SITE.person}</a>
        </p>
      </div>
    </header>

    <div class="mx-auto w-[min(760px,calc(100%-2rem))] py-12 md:py-16">
      <div class="prose-brand">
        <Fragment set:html={html} />
      </div>

      <aside class="mt-12 rounded-2xl border border-line/60 bg-white p-6">
        <p class="font-display text-xl font-bold text-primary">¿Te reconoces en lo que has leído?</p>
        <p class="mt-2 text-muted">Puedo acompañarte online o en Barcelona.</p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={target.href} data-event="post_service_click" data-event-target={target.href} class="btn-primary whitespace-normal text-center">
            {target.label}
          </a>
          <a href={SITE.whatsapp} target="_blank" rel="noopener" data-event="whatsapp_click" data-event-location="post" class="btn-whatsapp">
            <WhatsAppIcon size={20} class="text-[#128c4a]" /> WhatsApp
          </a>
        </div>
      </aside>

      <div class="mt-8 flex items-center gap-4 rounded-2xl bg-surface p-5">
        <Image src={mariaHero} alt="" widths={[128]} sizes="64px" class="h-16 w-16 shrink-0 rounded-full object-cover ring-4 ring-highlight" />
        <div>
          <p class="font-display font-bold">Escrito por {SITE.person}</p>
          <p class="text-sm text-muted">
            {SITE.role} ·{' '}
            <a href={SITE.copc} target="_blank" rel="noopener" data-event="license_click" data-event-location="post_author" class="underline decoration-primary/30 underline-offset-4 hover:text-primary"
              >Colegiada n.º {SITE.licenseNumber}</a
            >
          </p>
          <a href="/sobre-mi/" class="mt-1 inline-flex items-center gap-1 text-sm font-semibold text-primary hover:underline">
            Conóceme <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>
    </div>
  </article>

  <RelatedPosts posts={related} />

  <CtaFinal />
</Layout>
