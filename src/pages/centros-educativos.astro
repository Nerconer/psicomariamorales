---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';

const tematicas = [
  'Gestión emocional',
  'Ansiedad y estrés académico',
  'Autoestima e imagen corporal',
  'Relaciones saludables y prevención de la violencia',
  'Trauma y resiliencia',
  'Regulación emocional',
  'Prevención del acoso escolar',
  'Uso saludable de las redes sociales',
  'Prevención de conductas de riesgo',
  'Bienestar psicológico y autocuidado',
];

const servicios = [
  {
    title: 'Talleres para el alumnado',
    text: 'Talleres participativos y adaptados a cada etapa educativa, con un enfoque dinámico, cercano y basado en la evidencia científica.',
  },
  {
    title: 'Formación para docentes y equipos educativos',
    text: 'Formación dirigida a profesorado, equipos directivos y personal educativo para facilitar la identificación del malestar psicológico, la gestión de situaciones complejas en el aula y la promoción de un clima educativo saludable.',
  },
  {
    title: 'Escuelas de familias',
    text: 'Charlas y talleres sobre comunicación familiar, límites, regulación emocional, uso de pantallas, adolescencia, gestión de conflictos y acompañamiento emocional.',
  },
  {
    title: 'Charlas y conferencias',
    text: 'Ponencias para jornadas educativas, congresos, semanas de la salud, asociaciones de familias y otros eventos relacionados con la educación y la salud mental.',
  },
];
---

<Layout
  title="Psicoeducación para centros educativos"
  description="Talleres para alumnado, formación para profesorado y escuelas de familias: educación emocional, prevención del acoso, redes sociales, salud mental y más."
>
  <PageHero
    eyebrow="Centros educativos"
    title="Psicoeducación para crecer con bienestar"
    lead="La salud mental y el bienestar emocional son pilares fundamentales para el desarrollo personal, académico y social del alumnado."
  />

  <section class="py-16 md:py-24">
    <div class="mx-auto w-[min(820px,92%)]">
      <p class="text-muted">
        Los centros educativos desempeñan un papel esencial en la promoción del bienestar, la
        prevención de dificultades psicológicas y la creación de entornos seguros donde niños,
        adolescentes y jóvenes puedan crecer de forma saludable.
      </p>
      <p class="mt-4 text-muted">
        Colaboro con centros educativos, universidades, institutos y entidades formativas
        ofreciendo programas adaptados a las necesidades de cada comunidad educativa. Mi objetivo
        es proporcionar herramientas prácticas que favorezcan el bienestar emocional, la
        convivencia y la detección temprana de situaciones de riesgo.
      </p>
    </div>
  </section>

  <section class="bg-surface py-16 md:py-24">
    <div class="mx-auto w-[min(1120px,92%)]">
      <div class="text-center">
        <p class="eyebrow">Servicios para centros educativos</p>
        <h2 class="font-display text-4xl font-semibold text-primary-strong">
          Programas para toda la comunidad educativa
        </h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          servicios.map((s) => (
            <div class="card">
              <h3 class="font-display text-2xl font-semibold text-primary-strong">{s.title}</h3>
              <p class="mt-3 text-base text-muted">{s.text}</p>
            </div>
          ))
        }
      </div>

      <div class="mx-auto mt-14 max-w-[820px]">
        <h3 class="text-center font-display text-2xl font-semibold text-primary-strong">
          Temáticas que trabajo
        </h3>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          {
            tematicas.map((t) => (
              <span class="rounded-full border border-line/60 bg-white px-5 py-2 text-base text-ink">
                {t}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="mx-auto w-[min(820px,92%)] text-center">
      <p class="eyebrow">Un enfoque adaptado a cada centro</p>
      <h2 class="font-display text-3xl font-semibold text-primary-strong">
        Intervenciones diseñadas de forma personalizada
      </h2>
      <p class="mt-5 text-muted">
        Cada comunidad educativa tiene unas necesidades diferentes. Por ello, todas las
        intervenciones se diseñan teniendo en cuenta la edad del alumnado, los objetivos del centro
        y el contexto en el que se desarrollan.
      </p>
      <p class="mt-4 text-muted">
        Mi forma de trabajar combina el rigor científico con un enfoque cercano, práctico y
        participativo, favoreciendo espacios donde el aprendizaje, la reflexión y el bienestar
        puedan ir de la mano.
      </p>
    </div>
  </section>

  <CtaFinal
    title="¿Diseñamos una propuesta para tu centro?"
    text="Si tu centro educativo está interesado en desarrollar actividades de promoción de la salud mental, formación o prevención, estaré encantada de diseñar una propuesta adaptada a vuestras necesidades."
    primaryLabel="Solicitar propuesta"
    primaryHref="/contacto"
  />
</Layout>
