---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../consts';
---

<Layout
  title="Contacto"
  description="Contacta con Maria Morales, psicóloga sanitaria en Barcelona: WhatsApp, email o reserva directamente tu cita en Doctoralia. Terapia presencial y online."
>
  <PageHero
    eyebrow="Contacto"
    title="¿Hablamos?"
    lead="¿Te gustaría entender mejor lo que te sucede por dentro? Escríbeme sin compromiso: resolveré cualquier duda sobre la terapia, las tarifas o mi forma de trabajar."
  />

  <section class="py-10 sm:py-14 md:py-20 lg:py-24">
    <div class="mx-auto grid w-[min(1120px,calc(100%-1.25rem))] gap-8 sm:w-[92%] lg:grid-cols-[1fr_1fr] lg:gap-10">
      <!-- Contact channels -->
      <div class="space-y-4 sm:space-y-5">
        <a
          href={SITE.whatsapp}
          target="_blank"
          rel="noopener"
          data-event="whatsapp_click"
          data-event-location="contact"
          class="card flex items-center gap-3 !p-5 sm:!p-7 min-[420px]:gap-5"
        >
          <span class="hidden h-12 w-12 shrink-0 place-items-center rounded-full bg-forest-light/70 text-forest min-[420px]:grid">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.66 15L2 22l5.2-1.3A10 10 0 1 0 12 2Zm5.42 14.13c-.23.64-1.33 1.22-1.86 1.26-.5.05-1.12.24-3.76-.78-3.18-1.25-5.2-4.5-5.36-4.7-.15-.21-1.27-1.7-1.27-3.23s.8-2.29 1.09-2.6c.28-.32.62-.4.83-.4h.6c.19 0 .45-.07.7.54.26.62.87 2.14.95 2.3.08.15.13.34.02.55-.1.21-.16.34-.31.52-.16.18-.33.41-.47.55-.16.15-.32.32-.14.63.18.3.8 1.32 1.72 2.14 1.18 1.05 2.17 1.38 2.48 1.53.31.16.49.13.67-.08.18-.2.77-.9.98-1.2.2-.31.41-.26.7-.16.28.1 1.8.85 2.1 1 .31.16.52.24.6.37.07.13.07.75-.16 1.4Z"/></svg>
          </span>
          <span>
            <span class="block font-display text-xl font-semibold text-forest-dark">WhatsApp</span>
            <span class="block whitespace-nowrap text-base font-semibold text-forest-dark">{SITE.phone}</span>
          </span>
        </a>

        <a
          href={`mailto:${SITE.email}`}
          data-event="email_click"
          data-event-location="contact"
          class="card flex items-center gap-3 !p-5 sm:!p-7 min-[420px]:gap-5"
        >
          <span class="hidden h-12 w-12 shrink-0 place-items-center rounded-full bg-forest-light/70 text-forest min-[420px]:grid">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </span>
          <span>
            <span class="block font-display text-xl font-semibold text-forest-dark">Email</span>
            <span class="block whitespace-nowrap text-base text-ink-soft">{SITE.email}</span>
          </span>
        </a>

        <a
          href={SITE.doctoralia}
          target="_blank"
          rel="noopener"
          data-event="booking_click"
          data-event-location="contact"
          class="card flex items-center gap-3 !p-5 sm:!p-7 min-[420px]:gap-5"
        >
          <span class="hidden h-12 w-12 shrink-0 place-items-center rounded-full bg-forest-light/70 text-forest min-[420px]:grid">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18M9.5 15.5h5M12 13v5"/></svg>
          </span>
          <span>
            <span class="block font-display text-xl font-semibold text-forest-dark">Reservar cita online</span>
            <span class="block text-base text-ink-soft"
              >Consulta disponibilidad y reserva directamente en Doctoralia</span
            >
          </span>
        </a>
      </div>

      <!-- In-person practice -->
      <div class="card self-start !p-5 sm:!p-7">
        <h2 class="font-display text-xl font-semibold text-forest-dark">Consulta presencial</h2>
        <p class="mt-2 text-base text-ink-soft">
          <a
            href={SITE.maps}
            target="_blank"
            rel="noopener"
            data-event="map_click"
            data-event-location="contact"
            class="font-semibold text-forest-dark underline decoration-forest-soft underline-offset-4"
            >{SITE.address}</a
          >
        </p>
        <p class="mt-3 text-base text-ink-soft"><strong class="text-ink">Horario de atención:</strong> {SITE.schedule}</p>
        <p class="mt-3 text-base text-ink-soft">
          ¿No estás en Barcelona? También ofrezco <a
            href="/terapia-psicologica/"
            class="font-semibold text-forest underline decoration-forest-soft underline-offset-4"
            >terapia online</a
          > en toda España.
        </p>
        <a
          href={SITE.maps}
          target="_blank"
          rel="noopener"
          data-event="map_click"
          data-event-location="contact_button"
          class="btn-outline mt-5 !px-5 !py-2">Abrir en Google Maps</a
        >
      </div>
    </div>
    <p class="mx-auto mt-8 max-w-[72ch] rounded-xl border border-forest-soft/40 bg-forest-light px-5 py-4 text-left text-base text-ink-soft sm:mt-10 sm:text-center">
      Este contacto no es un servicio de urgencias. Si existe riesgo inmediato para ti o para otra persona, llama al 112 o acude al servicio de urgencias más cercano. Si tienes pensamientos de suicidio, llama al 024: es gratuito, confidencial y atiende las 24 horas.
    </p>
  </section>
</Layout>
