---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CtaFinal from '../components/CtaFinal.astro';
import DoctoraliaEmbed from '../components/DoctoraliaEmbed.astro';
import Chip from '../components/ui/Chip.astro';
import Faq from '../components/ui/Faq.astro';
import Icon from '../components/ui/Icon.astro';
import ProblemCard from '../components/ui/ProblemCard.astro';
import OrientationQuiz from '../components/OrientationQuiz.astro';
import WhatsAppIcon from '../components/ui/WhatsAppIcon.astro';
import { SITE, PRICES, formatPrice, FREE_CALL_WHATSAPP } from '../consts';
import mariaHero from '../assets/img/maria-hero.jpg';

const hardTimes = [
  { icon: 'anxiety', title: 'Ansiedad', text: 'Tu mente no para y te cuesta desconectar.', href: '/terapia-psicologica/#ansiedad' },
  { icon: 'stress', title: 'Estrés y burnout', text: 'Sientes que ya no puedes con todo.', href: '/terapia-psicologica/#estres' },
  { icon: 'grief', title: 'Duelo', text: 'Una pérdida que no encuentra alivio.', href: '/terapia-psicologica/#duelo' },
  { icon: 'trauma', title: 'Trauma y EMDR', text: 'El pasado sigue pesando en tu presente.', href: '/terapia-psicologica/#trauma' },
] as const;

const growth = [
  { icon: 'couple', title: 'Tu relación de pareja', text: 'Comunicaros mejor, también sin crisis.', href: '/terapia-de-pareja/' },
  { icon: 'confidence', title: 'Seguridad en ti', text: 'Exigirte menos y confiar más en ti.', href: '/terapia-psicologica/#autoestima' },
  { icon: 'blocks', title: 'Bloqueos y decisiones', text: 'Sabes lo que quieres cambiar, pero algo te frena.', href: '/terapia-psicologica/#bloqueos' },
  { icon: 'self', title: 'Límites', text: 'Decir que no sin sentir culpa.', href: '/terapia-psicologica/#apego' },
] as const;

const steps = [
  {
    title: 'Llamada gratuita de 15 minutos',
    text: 'Pídela por WhatsApp o por teléfono y resolvemos tus dudas antes de empezar.',
  },
  {
    title: `Primera sesión, ${formatPrice(PRICES.firstSession.amount)}`,
    text: `${PRICES.firstSession.minutes} minutos para conocernos y ver qué necesitas. Online o en Barcelona.`,
  },
  {
    title: 'Seguimos a tu ritmo',
    text: `Online ${formatPrice(PRICES.online.amount)}, presencial ${formatPrice(PRICES.inPerson.amount)}.`,
  },
];

const faqs = [
  {
    q: '¿Puedo ir a terapia aunque esté bien?',
    a: 'Sí. Mucha gente viene para entenderse mejor, tomar una decisión o mejorar su relación, sin que haya una crisis.',
  },
  {
    q: '¿Funciona igual la terapia online?',
    a: 'Sí. La forma de trabajar es la misma. Solo necesitas un sitio tranquilo y conexión a internet.',
  },
  {
    q: '¿Necesito saber qué me pasa para empezar?',
    a: 'No. Muchas personas llegan sintiendo malestar, bloqueo o confusión, sin tener todavía claro qué les ocurre. Ese también es un buen punto de partida.',
  },
  {
    q: '¿Qué pasa en la primera sesión?',
    a: 'Nos conocemos, me cuentas qué te trae y vemos qué necesitas. También resolvemos tus dudas sobre el proceso.',
  },
  {
    q: '¿Cuánto dura la terapia?',
    a: 'Depende de cada persona y de lo que quiera trabajar. Lo vamos revisando sobre la marcha.',
  },
  {
    q: '¿En qué idioma son las sesiones?',
    a: 'En castellano o en catalán, como prefieras.',
  },
];
---

<Layout
  title="Psicóloga online y en Barcelona"
  description="Maria Morales, psicóloga general sanitaria. Terapia online en toda España y presencial en Barcelona: ansiedad, estrés, pareja, autoestima y trauma con EMDR. Primera sesión 35 €."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] items-center gap-10 py-10 md:py-16 lg:grid-cols-[1.1fr_0.9fr] lg:py-20">
      <div>
        <div class="flex items-center gap-4">
          <Image
            src={mariaHero}
            alt="Maria Morales"
            widths={[128, 192]}
            sizes="64px"
            class="h-16 w-16 rounded-full object-cover ring-4 ring-sun lg:hidden"
            loading="eager"
          />
          <div>
            <p class="font-display text-lg font-bold">Hola, soy Maria</p>
            <p class="text-sm text-muted">
              {SITE.role} ·{' '}
              <a
                href={SITE.copc}
                target="_blank"
                rel="noopener"
                data-event="license_click"
                data-event-location="hero"
                class="underline decoration-line underline-offset-4 hover:text-primary"
                >Col. {SITE.licenseNumber}</a
              >
            </p>
          </div>
        </div>

        <h1 class="mt-6 text-[2.1rem] font-bold leading-[1.15] text-primary sm:text-5xl lg:text-[3.4rem]">
          Psicóloga online y en Barcelona
        </h1>
        <p class="mt-4 max-w-[46ch] text-lg md:text-xl">
          Te acompaño cuando algo pesa, y también cuando estás bien pero quieres cambiar algo.
        </p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a
            href={SITE.doctoralia}
            target="_blank"
            rel="noopener"
            data-event="booking_click"
            data-event-location="hero"
            class="btn-primary"
          >
            <Icon name="calendar" size={20} />
            Reservar primera sesión · {formatPrice(PRICES.firstSession.amount)}
          </a>
          <a
            href={SITE.whatsapp}
            target="_blank"
            rel="noopener"
            data-event="whatsapp_click"
            data-event-location="hero"
            class="btn-whatsapp"
          >
            <WhatsAppIcon size={20} class="text-[#128c4a]" />
            Escríbeme por WhatsApp
          </a>
        </div>
        <p class="mt-4 text-base text-muted">
          ¿Tienes dudas?{' '}
          <a
            href={FREE_CALL_WHATSAPP}
            target="_blank"
            rel="noopener"
            data-event="free_call_click"
            data-event-location="hero"
            class="font-semibold text-primary underline decoration-line underline-offset-4 hover:decoration-primary"
            >Pide una llamada gratuita de 15 minutos</a
          >
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          <Chip tone="sun" icon="online">Online desde casa · {formatPrice(PRICES.online.amount)}</Chip>
          <Chip>Sesiones de {PRICES.online.minutes} min</Chip>
          <Chip>Castellano y català</Chip>
          <Chip icon="location">Presencial en Barcelona · {formatPrice(PRICES.inPerson.amount)}</Chip>
        </div>
      </div>

      <div class="relative mx-auto hidden w-full max-w-[460px] lg:block">
        <div class="absolute -right-6 -top-6 h-40 w-40 rounded-full bg-sun/70" aria-hidden="true"></div>
        <div class="absolute -bottom-6 -left-6 h-28 w-28 rounded-full bg-surface" aria-hidden="true"></div>
        <Image
          src={mariaHero}
          alt="Maria Morales, psicóloga general sanitaria"
          widths={[460, 744, 920]}
          sizes="460px"
          class="relative aspect-[4/5] w-full rounded-[2.5rem] object-cover shadow-primary"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Do you recognise yourself -->
  <section class="bg-surface py-14 md:py-20" id="ayuda">
    <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
      <div class="max-w-[68ch]">
        <h2 class="text-3xl font-bold text-primary md:text-4xl">¿Te reconoces en algo de esto?</h2>
        <p class="mt-4">
          A veces no es ansiedad exactamente. Puede aparecer como estrés, tristeza, inseguridad,
          dificultad para poner límites o sensación de estar bloqueado/a. Si te reconoces en alguna
          de estas situaciones, la terapia puede ayudarte:
        </p>
      </div>

      <h3 class="mt-10 text-lg font-bold text-muted">Si estás pasando un mal momento</h3>
      <div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
        {hardTimes.map((c) => <ProblemCard href={c.href} title={c.title} text={c.text} icon={c.icon} />)}
      </div>

      <h3 class="mt-12 text-lg font-bold text-muted">Si estás bien, pero quieres mejorar</h3>
      <p class="mt-3 max-w-[68ch]">
        Y a veces el problema es precisamente no saber cómo afrontar lo que te está pasando: evitar
        conversaciones difíciles, bloquearte ante los conflictos, darle demasiadas vueltas antes de
        decidir o reaccionar de una manera que después no entiendes.
      </p>
      <div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
        {growth.map((c) => <ProblemCard href={c.href} title={c.title} text={c.text} icon={c.icon} />)}
      </div>

      <p class="mt-10 max-w-[60ch] font-display text-xl font-semibold text-primary-strong">
        Si llevas tiempo pensando «no sé qué me pasa, pero no estoy bien», también es un motivo
        válido para pedir ayuda.
      </p>
    </div>
  </section>

  <!-- Orientation quiz -->
  <section class="py-14 md:py-20" id="test">
    <div class="mx-auto w-[min(760px,calc(100%-2rem))]">
      <h2 class="text-3xl font-bold text-primary md:text-4xl">¿No sabes por dónde empezar?</h2>
      <p class="mt-3 text-muted">
        Tres preguntas y te digo cómo puedo ayudarte. Tus respuestas no se guardan ni se envían.
      </p>
      <div class="mt-6">
        <OrientationQuiz />
      </div>
    </div>
  </section>

  <!-- Who I am and how we start -->
  <section class="bg-surface py-14 md:py-20">
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold text-primary md:text-4xl">Quién soy</h2>
        <p class="mt-4 max-w-[52ch]">
          Soy Maria Morales, psicóloga general sanitaria. Trabajo desde la psicología integradora y
          me he especializado en trauma y apego con EMDR.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <Chip>Colegiada COPC {SITE.licenseNumber}</Chip>
          <Chip>EMDR nivel I y II</Chip>
          <Chip>Máster en Psicología General Sanitaria</Chip>
        </div>
        <a href="/sobre-mi/" class="btn-outline mt-6">Conóceme</a>
      </div>

      <div>
        <h2 class="text-3xl font-bold text-primary md:text-4xl">Cómo empezamos</h2>
        <ol class="mt-6 space-y-4">
          {
            steps.map((s, i) => (
              <li class="flex gap-4">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-sun font-display font-bold text-ink">
                  {i + 1}
                </span>
                <div>
                  <p class="font-display text-lg font-bold">{s.title}</p>
                  <p class="text-muted">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <a href="/tarifas/" class="mt-6 inline-flex items-center gap-2 font-semibold text-primary underline decoration-line underline-offset-4 hover:decoration-primary">
          Ver tarifas
        </a>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="py-14 md:py-20" id="opiniones">
    <div class="mx-auto w-[min(820px,calc(100%-2rem))]">
      <h2 class="text-3xl font-bold text-primary md:text-4xl">Opiniones de pacientes</h2>
      <div class="mt-6">
        <DoctoraliaEmbed mode="reviews" location="home" />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-surface py-14 md:py-20" id="faq">
    <div class="mx-auto w-[min(820px,calc(100%-2rem))]">
      <h2 class="text-3xl font-bold text-primary md:text-4xl">Dudas</h2>
      <div class="mt-6">
        <Faq items={faqs} schema />
      </div>
    </div>
  </section>

  <CtaFinal />
</Layout>
