---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Chip from '../components/ui/Chip.astro';
import { SITE } from '../consts';
import mariaHero from '../assets/img/maria-hero.jpg';

const degrees = [
  'Grado en Psicología',
  'Máster en Psicología General Sanitaria',
  'Grado en Criminología',
  'Máster en Intervención Criminológica y Victimológica',
];

const approaches = [
  {
    title: 'Trauma y apego',
    text: 'EMDR, trauma relacional y complejo, teoría del apego y abordaje informado por el trauma.',
  },
  {
    title: 'Trabajo con partes y emociones',
    text: 'IFS (Sistemas Familiares Internos), Terapia Focalizada en las Emociones (EFT), Terapia de Esquemas y Terapia Centrada en la Compasión (CFT).',
  },
  {
    title: 'Cuerpo y regulación',
    text: 'Psicoterapia Sensoriomotriz, psicoterapias somáticas y trabajo con regulación emocional y del sistema nervioso.',
  },
  {
    title: 'Enfoques cognitivo-conductuales',
    text: 'Terapia Cognitivo-Conductual (TCC), Terapia Dialéctico-Conductual (DBT) y Terapias de Tercera Generación, especialmente ACT.',
  },
  {
    title: 'Enfoques relacionales',
    text: 'Terapia Sistémica, Terapia Humanista, Terapia Narrativa y Análisis Transaccional.',
  },
  {
    title: 'Otros recursos',
    text: 'Mindfulness y herramientas de regulación emocional.',
  },
];
---

<Layout
  title="Sobre mí, psicóloga general sanitaria"
  description="Soy Maria Morales, psicóloga general sanitaria (COPC 35153). Trabajo desde la psicología integradora, online y en Barcelona, en castellano y en catalán."
>
  <PageHero
    title="Hola, soy Maria"
    lead="Psicóloga general sanitaria, colegiada en Barcelona (COPC 35153). Atiendo online y en Barcelona, en castellano y en catalán."
  />

  <section class="py-12 md:py-20">
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] items-start gap-10 lg:grid-cols-[380px_1fr] lg:gap-14">
      <div class="relative mx-auto w-full max-w-[380px]">
        <div class="absolute -right-4 -top-4 h-28 w-28 rounded-full bg-sun/70" aria-hidden="true"></div>
        <Image
          src={mariaHero}
          alt="Maria Morales, psicóloga general sanitaria"
          widths={[380, 760]}
          sizes="(max-width: 1024px) 90vw, 380px"
          class="relative aspect-[4/5] w-full rounded-[2rem] object-cover shadow-primary"
          loading="eager"
        />
      </div>

      <div class="max-w-[62ch]">
        <h2 class="text-2xl font-bold text-primary md:text-3xl">Por qué me dedico a esto</h2>
        <p class="mt-4">
          Me dediqué a la psicología porque me genera mucha curiosidad la conducta humana y cómo los
          aprendizajes condicionan la vida de las personas. Poder hacer conscientes muchos de los
          procesos inconscientes de nuestra vida es la clave para tener una vida plena.
        </p>

        <h2 class="mt-10 text-2xl font-bold text-primary md:text-3xl">Cómo trabajo</h2>
        <p class="mt-4">
          Trabajo desde la psicología integradora y me adapto a cada persona. Cada persona es
          diferente, le funcionan cosas diferentes y se siente cómoda con cosas diferentes. Me
          adapto a lo que creo que le puede encajar mejor por su personalidad y por lo que necesita.
        </p>
        <p class="mt-4">
          Conozco varios enfoques y técnicas, entre ellos EMDR, IFS, las terapias de tercera
          generación y la terapia focalizada en las emociones.
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          <a
            href={SITE.copc}
            target="_blank"
            rel="noopener"
            data-event="license_click"
            data-event-location="about"
            class="inline-flex"
            ><Chip>Colegiada COPC {SITE.licenseNumber}</Chip></a
          >
          <Chip>EMDR nivel I y II</Chip>
          <Chip>Castellano y català</Chip>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface py-12 md:py-20" id="formacion">
    <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
      <h2 class="text-2xl font-bold text-primary md:text-3xl">Formación</h2>
      <ul class="checklist mt-6 grid gap-x-10 sm:grid-cols-2">
        {degrees.map((d) => <li>{d}</li>)}
      </ul>

      <h3 class="mt-10 text-xl font-bold text-ink">Enfoques en los que me he formado</h3>
      <dl class="mt-4 grid gap-x-10 gap-y-5 md:grid-cols-2">
        {
          approaches.map((a) => (
            <div>
              <dt class="font-bold text-primary-strong">{a.title}</dt>
              <dd class="mt-1 text-muted">{a.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaFinal />
</Layout>
