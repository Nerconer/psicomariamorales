---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { SITE, PRICES, formatPrice } from '../consts';

const rates = [
  {
    title: 'Terapia online',
    price: PRICES.online,
    desc: 'Por videollamada, desde cualquier lugar y con mayor flexibilidad horaria.',
    featured: true,
  },
  {
    title: 'Primera sesión',
    price: PRICES.firstSession,
    desc: 'Un espacio para conocernos: exploramos qué te trae a consulta, cómo te está afectando y cuáles son tus objetivos.',
    featured: false,
  },
  {
    title: 'Terapia presencial en Barcelona',
    price: PRICES.inPerson,
    desc: 'Sesiones individuales de seguimiento en consulta, en un ambiente tranquilo, confidencial y seguro.',
    featured: false,
  },
  {
    title: 'Terapia de pareja',
    price: PRICES.couple,
    desc: 'Sesión conjunta para los dos miembros de la pareja, presencial u online.',
    featured: false,
  },
];
---

<Layout
  title="Tarifas"
  description="Tarifas de terapia psicológica con Maria Morales: primera sesión y sesiones de seguimiento, presencial en Barcelona y online. Reserva en Doctoralia."
>
  <PageHero
    eyebrow="Tarifas"
    title="Tarifas claras y sin sorpresas"
    lead="Las sesiones duran 60 minutos. La terapia de pareja, 90."
  />

  <section class="py-16 md:py-24">
    <div class="mx-auto w-[min(1120px,92%)]">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          rates.map((t) => (
            <div
              class:list={[
                'card flex flex-col text-center',
                t.featured && 'border-primary/40 !bg-primary text-bg',
              ]}
            >
              <h2
                class:list={[
                  'font-display text-2xl font-semibold',
                  t.featured ? 'text-bg' : 'text-primary-strong',
                ]}
              >
                {t.title}
              </h2>
              <p
                class:list={[
                  'my-4 font-display text-5xl font-semibold',
                  t.featured ? 'text-bg' : 'text-primary',
                ]}
              >
                {formatPrice(t.price.amount)}
              </p>
              <p class:list={['-mt-2 mb-4 text-sm font-semibold', t.featured ? 'text-bg/85' : 'text-muted']}>
                {t.price.minutes} min
              </p>
              <p class:list={['text-base', t.featured ? 'text-bg/85' : 'text-muted']}>
                {t.desc}
              </p>
              <a
                href={SITE.doctoralia}
                target="_blank"
                rel="noopener"
                data-event="booking_click"
                data-event-location="pricing_card"
                data-event-rate={t.title}
                class:list={['mt-6 justify-center', t.featured ? 'btn-light' : 'btn-outline']}
              >
                Reservar cita
              </a>
            </div>
          ))
        }
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="card">
          <h3 class="font-display text-xl font-semibold text-primary-strong">Formas de pago</h3>
          <p class="mt-2 text-base text-muted">
            Puedes abonar las sesiones en efectivo, por transferencia bancaria o Bizum. Las
            sesiones online se abonan antes de la cita.
          </p>
        </div>
        <div class="card">
          <h3 class="font-display text-xl font-semibold text-primary-strong">Política de cancelación</h3>
          <p class="mt-2 text-base text-muted">
            Si no puedes asistir a una sesión, te agradezco que avises con al menos 24 horas de
            antelación para poder reprogramarla sin coste.
          </p>
        </div>
      </div>

      <p class="mt-10 text-center text-base text-muted">
        Puedes consultar la disponibilidad y reservar en <a
          href={SITE.doctoralia}
          target="_blank"
          rel="noopener"
          data-event="booking_click"
          data-event-location="pricing_note"
          class="font-semibold text-primary underline decoration-line underline-offset-4"
          >Doctoralia</a
        >.
      </p>
    </div>
  </section>

  <CtaFinal />
</Layout>
