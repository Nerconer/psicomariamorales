---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { SITE } from '../consts';

const tarifas = [
  {
    title: 'Primera sesión',
    price: 'desde 50 €',
    desc: 'Un espacio para conocernos: exploramos qué te trae a consulta, cómo te está afectando y cuáles son tus objetivos.',
    featured: true,
  },
  {
    title: 'Terapia presencial en Barcelona',
    price: 'desde 50 €',
    desc: 'Sesiones individuales de seguimiento en consulta, en un ambiente tranquilo, confidencial y seguro.',
    featured: false,
  },
  {
    title: 'Terapia online',
    price: '45 €',
    desc: 'La misma calidad y cercanía que la terapia presencial, desde cualquier lugar y con mayor flexibilidad horaria.',
    featured: false,
  },
];
---

<Layout
  title="Tarifas"
  description="Tarifas de terapia psicológica con Maria Morales: primera sesión y sesiones de seguimiento, presencial en Barcelona y online. Reserva en Doctoralia."
>
  <PageHero
    eyebrow="Tarifas"
    title="Tarifas claras y sin sorpresas"
    lead="Invertir en tu bienestar es una de las decisiones más importantes que puedes tomar. Estas son las tarifas de las sesiones, siempre sincronizadas con mi perfil de Doctoralia."
  />

  <section class="py-16 md:py-24">
    <div class="mx-auto w-[min(1120px,92%)]">
      <div class="grid gap-6 md:grid-cols-3">
        {
          tarifas.map((t) => (
            <div
              class:list={[
                'card flex flex-col text-center',
                t.featured && 'border-forest/40 !bg-forest text-cream',
              ]}
            >
              <h2
                class:list={[
                  'font-display text-2xl font-semibold',
                  t.featured ? 'text-cream' : 'text-forest-dark',
                ]}
              >
                {t.title}
              </h2>
              <p
                class:list={[
                  'my-4 font-display text-5xl font-semibold',
                  t.featured ? 'text-cream' : 'text-forest',
                ]}
              >
                {t.price}
              </p>
              <p class:list={['text-sm', t.featured ? 'text-cream/85' : 'text-ink-soft']}>
                {t.desc}
              </p>
              <a
                href={SITE.doctoralia}
                target="_blank"
                rel="noopener"
                class:list={['mt-6 justify-center', t.featured ? 'btn-light' : 'btn-outline']}
              >
                Reservar cita
              </a>
            </div>
          ))
        }
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="card">
          <h3 class="font-display text-xl font-semibold text-forest-dark">Formas de pago</h3>
          <p class="mt-2 text-sm text-ink-soft">
            Puedes abonar las sesiones en efectivo, por transferencia bancaria o Bizum. Las
            sesiones online se abonan antes de la cita.
          </p>
        </div>
        <div class="card">
          <h3 class="font-display text-xl font-semibold text-forest-dark">Política de cancelación</h3>
          <p class="mt-2 text-sm text-ink-soft">
            Si no puedes asistir a una sesión, te agradezco que avises con al menos 24 horas de
            antelación para poder reprogramarla sin coste.
          </p>
        </div>
      </div>

      <p class="mt-10 text-center text-sm text-ink-soft">
        Los precios se mantienen sincronizados con el perfil de <a
          href={SITE.doctoralia}
          target="_blank"
          rel="noopener"
          class="font-semibold text-forest underline decoration-forest-soft underline-offset-4"
          >Doctoralia</a
        >, donde puedes consultar la disponibilidad actualizada.
      </p>
    </div>
  </section>

  <CtaFinal />
</Layout>
