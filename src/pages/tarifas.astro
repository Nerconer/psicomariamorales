---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import DoctoraliaEmbed from '../components/DoctoraliaEmbed.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE, PRICES, formatPrice, FREE_CALL_WHATSAPP } from '../consts';

const rates = [
  {
    title: 'Terapia online',
    price: PRICES.online,
    desc: 'Por videollamada, desde donde estés.',
    featured: true,
  },
  {
    title: 'Primera sesión',
    price: PRICES.firstSession,
    desc: 'Para conocernos y ver qué necesitas. Terapia individual, online o en Barcelona.',
    featured: false,
  },
  {
    title: 'Presencial',
    price: PRICES.inPerson,
    desc: 'En la consulta de Barcelona.',
    featured: false,
  },
  {
    title: 'Terapia de pareja',
    price: PRICES.couple,
    desc: 'Para los dos, online o en Barcelona.',
    featured: false,
  },
];
---

<Layout
  title="Tarifas de terapia online y en Barcelona"
  description={`Primera sesión ${formatPrice(PRICES.firstSession.amount)}, terapia online ${formatPrice(PRICES.online.amount)}, presencial en Barcelona ${formatPrice(PRICES.inPerson.amount)} y terapia de pareja ${formatPrice(PRICES.couple.amount)}. Sesiones de 60 minutos, pareja de 90.`}
>
  <PageHero title="Tarifas" lead="Las sesiones duran 60 minutos. La terapia de pareja, 90." />

  <section class="py-12 md:py-16">
    <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          rates.map((r) => (
            <div
              class:list={[
                'flex flex-col rounded-2xl border p-6',
                r.featured ? 'border-primary bg-primary text-white' : 'border-line/60 bg-white',
              ]}
            >
              <h2 class:list={['text-xl font-bold', r.featured ? 'text-white' : 'text-primary']}>{r.title}</h2>
              <p class="mt-3 flex items-baseline gap-2">
                <span class="font-display text-4xl font-bold">{formatPrice(r.price.amount)}</span>
                <span class:list={['text-sm font-semibold', r.featured ? 'text-white/85' : 'text-muted']}>
                  {r.price.minutes} min
                </span>
              </p>
              <p class:list={['mt-3 flex-1 text-base', r.featured ? 'text-white/90' : 'text-muted']}>{r.desc}</p>
              <a
                href={SITE.doctoralia}
                target="_blank"
                rel="noopener"
                data-event="booking_click"
                data-event-location="pricing_card"
                data-event-rate={r.title}
                class:list={['mt-5', r.featured ? 'btn-light' : 'btn-outline']}
              >
                Reservar
              </a>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-center text-base text-muted">
        ¿Tienes dudas antes de reservar?{' '}
        <a
          href={FREE_CALL_WHATSAPP}
          target="_blank"
          rel="noopener"
          data-event="free_call_click"
          data-event-location="pricing"
          class="font-semibold text-primary underline decoration-line underline-offset-4 hover:decoration-primary"
          >Pide una llamada gratuita de 15 minutos</a
        >.
      </p>
    </div>
  </section>

  <section class="bg-surface py-12 md:py-16" id="reservar">
    <div class="mx-auto w-[min(820px,calc(100%-2rem))]">
      <h2 class="text-2xl font-bold text-primary md:text-3xl">Reserva sin salir de la web</h2>
      <div class="mt-5">
        <DoctoraliaEmbed mode="calendar" location="pricing" />
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] gap-4 md:grid-cols-2">
      <div class="card">
        <h2 class="flex items-center gap-2 text-xl font-bold text-primary">
          <Icon name="check" class="text-primary" /> Pago
        </h2>
        <p class="mt-2 text-muted">Efectivo, transferencia o Bizum. Las sesiones online se pagan antes de la cita.</p>
      </div>
      <div class="card">
        <h2 class="flex items-center gap-2 text-xl font-bold text-primary">
          <Icon name="calendar" class="text-primary" /> Cancelación
        </h2>
        <p class="mt-2 text-muted">
          Si no puedes venir, avísame con 24 horas de antelación y la cambiamos sin coste.
        </p>
      </div>
      <p class="text-sm text-muted md:col-span-2">Los precios se revisan una vez al año.</p>
    </div>
  </section>

  <CtaFinal />
</Layout>
