---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Faq from '../components/ui/Faq.astro';
import Chip from '../components/ui/Chip.astro';
import { SITE, PRICES, formatPrice } from '../consts';

const situations = [
  'Discusiones que se repiten y no se resuelven.',
  'Problemas de comunicación.',
  'Distancia emocional o pérdida de conexión.',
  'Celos, desconfianza o una infidelidad.',
  'Cambios grandes: un hijo, una mudanza, el trabajo.',
  'Ganas de fortalecer la relación antes de que haya problemas.',
];

const faqs = [
  {
    q: '¿Y si mi pareja no quiere venir?',
    a: 'Puedes empezar en terapia individual y ver más adelante si se suma.',
  },
  {
    q: '¿Hace falta estar en crisis?',
    a: 'No. Muchas parejas vienen para cuidar la relación antes de que haya problemas.',
  },
  {
    q: '¿Se puede hacer online?',
    a: 'Sí, por videollamada, juntos o cada uno desde donde esté.',
  },
];
---

<Layout
  title="Terapia de pareja online y en Barcelona"
  description={`Terapia de pareja online y en Barcelona: comunicación, discusiones, distancia, celos o infidelidad. Sesiones de ${PRICES.couple.minutes} minutos por ${formatPrice(PRICES.couple.amount)}.`}
>
  <PageHero
    title="Terapia de pareja online y en Barcelona"
    lead="Para parejas que discuten más de la cuenta, que se han distanciado o que quieren cuidarse. Sesiones de 90 minutos."
  />

  <section class="py-12 md:py-16">
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] gap-10 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <h2 class="text-2xl font-bold text-primary md:text-3xl">¿Cuándo venir?</h2>
        <ul class="checklist mt-5">
          {situations.map((s) => <li>{s}</li>)}
        </ul>

        <h2 class="mt-10 text-2xl font-bold text-primary md:text-3xl">Cómo trabajo</h2>
        <p class="mt-4 max-w-[62ch]">
          Os escucho a los dos sin tomar partido. Buscamos qué hay debajo de los conflictos y
          practicamos otras formas de hablaros. Si la relación no puede o no debe seguir, la terapia
          también ayuda a separarse con respeto.
        </p>
      </div>

      <aside class="self-start rounded-2xl bg-primary p-6 text-white">
        <p class="font-display text-lg font-bold">Terapia de pareja</p>
        <p class="mt-2 flex items-baseline gap-2">
          <span class="font-display text-4xl font-bold">{formatPrice(PRICES.couple.amount)}</span>
          <span class="text-white/85">{PRICES.couple.minutes} min</span>
        </p>
        <p class="mt-2 text-white/90">Online o presencial en Barcelona.</p>
        <a
          href={SITE.doctoralia}
          target="_blank"
          rel="noopener"
          data-event="booking_click"
          data-event-location="couples_price"
          class="btn-light mt-5 w-full">Reservar sesión</a
        >
        <div class="mt-4 flex flex-wrap gap-2">
          <Chip>Castellano y català</Chip>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-surface py-12 md:py-16">
    <div class="mx-auto w-[min(820px,calc(100%-2rem))]">
      <h2 class="text-2xl font-bold text-primary md:text-3xl">Dudas</h2>
      <div class="mt-5">
        <Faq items={faqs} schema />
      </div>
    </div>
  </section>

  <CtaFinal
    title="¿Empezamos a cuidar vuestra relación?"
    text="Reservad la primera sesión o escribidme para resolver dudas."
    primaryLabel="Reservar sesión de pareja"
  />
</Layout>
