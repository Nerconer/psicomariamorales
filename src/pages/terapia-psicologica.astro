---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import { PRICES, formatPrice } from '../consts';

// Specialties with their own page link to it.
const LANDINGS: Record<string, string> = {
  ansiedad: '/psicologa-ansiedad-barcelona/',
  estres: '/terapia-estres-burnout/',
  burnout: '/terapia-estres-burnout/',
  autoestima: '/terapia-autoestima/',
  perfeccionismo: '/terapia-autoestima/',
  bloqueos: '/crecimiento-personal/',
  duelo: '/terapia-duelo/',
  trauma: '/terapia-emdr-barcelona/',
};

// Anxiety comes first and trauma last, as Maria asked. The ids are the anchors
// other pages link to.
const specialties: Array<{ id: string; icon: IconName; title: string; text: string }> = [
  { id: 'ansiedad', icon: 'anxiety', title: 'Ansiedad', text: 'Insomnio, presión en el pecho, pensamientos constantes, obsesiones o rumiaciones.' },
  { id: 'estres', icon: 'stress', title: 'Estrés', text: 'Cuando las exigencias superan durante mucho tiempo lo que puedes sostener.' },
  { id: 'burnout', icon: 'stress', title: 'Burnout', text: 'El trabajo te ha dejado sin energía ni ganas.' },
  { id: 'panico', icon: 'panic', title: 'Ataques de pánico', text: 'Un miedo intenso y repentino, con síntomas físicos que asustan.' },
  { id: 'intrusivos', icon: 'anxiety', title: 'Pensamientos intrusivos', text: 'Ideas o imágenes que aparecen sin querer y generan mucho malestar.' },
  { id: 'autoestima', icon: 'confidence', title: 'Autoestima', text: 'Te cuesta valorarte o sientes que nunca es suficiente.' },
  { id: 'regulacion', icon: 'heart', title: 'Regulación emocional', text: 'Emociones tan intensas que cuesta entenderlas o manejarlas.' },
  { id: 'irritabilidad', icon: 'heart', title: 'Irritabilidad', text: 'Estar irascible, que todo te moleste.' },
  { id: 'bloqueos', icon: 'blocks', title: 'Bloqueos', text: 'A veces sabes lo que quieres cambiar, pero algo dentro de ti parece frenarte.' },
  { id: 'conflictos', icon: 'blocks', title: 'Gestión de conflictos', text: 'Gestión de conflictos (quedarte bloqueado).' },
  { id: 'dependencia', icon: 'couple', title: 'Dependencia emocional', text: 'Cuando el miedo a perder una relación decide por ti.' },
  { id: 'apego', icon: 'couple', title: 'Apego y límites', text: 'Te cuesta confiar, poner límites o mantener relaciones estables.' },
  { id: 'familia', icon: 'couple', title: 'Relaciones familiares', text: 'Conflictos familiares que desgastan.' },
  { id: 'soledad', icon: 'couple', title: 'Soledad y conexión', text: 'Soledad, dificultad para conectar con la gente o sentirte diferente.' },
  { id: 'sentido', icon: 'self', title: 'Apatía y falta de sentido', text: 'No encontrar el sentido de la vida, apatía o falta de ganas.' },
  { id: 'pantallas', icon: 'self', title: 'Móvil y pantallas', text: 'Horas y horas atrapado en el móvil o en las pantallas.' },
  { id: 'crisis', icon: 'self', title: 'Crisis vitales', text: 'Una separación, un cambio de trabajo, la maternidad o una enfermedad.' },
  { id: 'duelo', icon: 'grief', title: 'Duelo', text: 'Una pérdida que duele y necesita su espacio.' },
  { id: 'perfeccionismo', icon: 'confidence', title: 'Perfeccionismo', text: 'Presión constante, miedo al error y la sensación de no llegar nunca.' },
  { id: 'disociacion', icon: 'trauma', title: 'Disociación', text: 'Disociación.' },
  { id: 'trauma', icon: 'trauma', title: 'Trauma', text: 'El trauma no siempre viene de algo extremo. A veces nace de años de críticas, abandono o relaciones inseguras.' },
];
---

<Layout
  title="Terapia psicológica online y en Barcelona"
  description="Terapia psicológica online en toda España y presencial en Barcelona: ansiedad, estrés, burnout, autoestima, bloqueos, duelo y trauma con EMDR."
>
  <PageHero title="Terapia psicológica online y en Barcelona" />

  <section class="py-12 md:py-16">
    <div class="mx-auto w-[min(820px,calc(100%-2rem))]">
      <p>
        Trabajo desde la psicología integradora. Me adapto a cada persona, a cada situación y a cada
        necesidad. No todo funciona de la misma manera en cada persona.
      </p>
      <p class="mt-4">
        Tengo formación amplia en diferentes enfoques y corrientes: cognitivo-conductual, terapias
        de tercera generación, EMDR nivel I y II, IFS, terapia focalizada en la emoción, terapia
        sistémica y análisis transaccional, entre otros.
      </p>

      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        <div class="rounded-2xl bg-primary p-5 text-white">
          <p class="flex items-center gap-2 font-display text-lg font-bold">
            <Icon name="online" /> Online · {formatPrice(PRICES.online.amount)}
          </p>
          <p class="mt-1 text-white/90">Por videollamada, desde cualquier lugar de España.</p>
        </div>
        <div class="rounded-2xl border border-line/60 bg-white p-5">
          <p class="flex items-center gap-2 font-display text-lg font-bold text-primary">
            <Icon name="location" /> Presencial · {formatPrice(PRICES.inPerson.amount)}
          </p>
          <p class="mt-1 text-muted">En la consulta de Barcelona.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface py-12 md:py-16" id="especialidades">
    <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
      <h2 class="text-2xl font-bold text-primary md:text-3xl">Con qué acompaño</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          specialties.map((s) => (
            <article id={s.id} class="card relative flex scroll-mt-28 gap-4 p-5!">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-surface text-primary" aria-hidden="true">
                <Icon name={s.icon} />
              </span>
              <div>
                <h3 class="font-display text-lg font-bold">
                  {LANDINGS[s.id] ? (
                    <a href={LANDINGS[s.id]} class="text-primary after:absolute after:inset-0 hover:underline">
                      {s.title}
                    </a>
                  ) : (
                    s.title
                  )}
                </h3>
                {s.text !== `${s.title}.` && <p class="mt-1 text-base text-muted">{s.text}</p>}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaFinal />
</Layout>
