---
// About page, shared by the Spanish and Catalan routes. The Spanish text is
// Maria's own wording; the Catalan one is its translation.
import { Image, Picture, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Wave from '../components/Wave.astro';
import Chip from '../components/ui/Chip.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE } from '../consts';
import { PAGE_TITLES } from '../data/page-titles';
import type { Locale } from '../i18n/config';
import mariaPortrait from '../assets/img/maria-portrait.jpg';
import certEmdr1 from '../assets/certificates/emdr-nivel-1.jpg';
import certEmdr2 from '../assets/certificates/emdr-nivel-2.jpg';
import certPerinatal1 from '../assets/certificates/unir-apego-perinatal-1.jpg';
import certPerinatal2 from '../assets/certificates/unir-apego-perinatal-2.jpg';
import certPtsd from '../assets/certificates/estres-postraumatico.jpg';
import certCopc from '../assets/certificates/copc.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const COPY = {
  es: {
    metaTitle: 'Sobre mí, psicóloga general sanitaria',
    description:
      'Soy Maria Morales, psicóloga general sanitaria (COPC 35153). Trabajo desde la psicología integradora, online y en Barcelona, en castellano y en catalán.',
    title: PAGE_TITLES.about.es,
    lead: 'Psicóloga general sanitaria, colegiada en Barcelona (COPC 35153). Atiendo online y en Barcelona, en castellano y en catalán.',
    alt: 'Maria Morales, psicóloga general sanitaria',
    whyTitle: 'Por qué me dedico a esto',
    why: 'Me dediqué a la psicología porque me genera mucha curiosidad la conducta humana y cómo los aprendizajes condicionan la vida de las personas. Poder hacer conscientes muchos de los procesos inconscientes de nuestra vida es la clave para tener una vida plena.',
    howTitle: 'Cómo trabajo',
    how: [
      'Trabajo desde la psicología integradora y me adapto a cada persona. Cada persona es diferente, le funcionan cosas diferentes y se siente cómoda con cosas diferentes. Me adapto a lo que creo que le puede encajar mejor por su personalidad y por lo que necesita y siempre de forma consensuada con el paciente, que no sienta que pierde el tiempo, siempre generando un espacio de comunicación con objetivos claros.',
    ],
    chips: [`Colegiada COPC ${SITE.licenseNumber}`, 'EMDR nivel I y II', 'Castellano y català'],
    trainingTitle: 'Formación',
    approachesTitle: 'Enfoques en los que me he formado',
    academicTitle: 'Formación académica',
    complementaryTitle: 'Formación complementaria',
    certificatesTitle: 'Certificados',
    degrees: [
      { title: 'Máster en Psicología General Sanitaria', place: 'UNIR', years: '2025-2026' },
      { title: 'Grado en Psicología', place: 'Universitat Oberta de Catalunya (UOC)', years: '2019-2025' },
      { title: 'Máster Oficial en Intervención Criminológica y Victimológica', place: 'Universidad Miguel Hernández, Elche', years: '2016-2017' },
      { title: 'Grado en Criminología', place: 'Universitat Autònoma de Barcelona', years: '2012-2016' },
    ],
    certificates: {
      emdr2: 'Certificado de Formación Básica en EMDR Nivel II, de Imaya Formación, acreditado por EMDR Europe',
      emdr1: 'Certificado de Formación Básica en EMDR Nivel I, de Imaya Formación, acreditado por EMDR Europe',
      perinatal1: 'Título del Programa Universitario Avanzado en Apego y Psicología Perinatal, de la UNIR',
      perinatal2: 'Módulos del Programa Universitario Avanzado en Apego y Psicología Perinatal, de la UNIR',
      ptsd: 'Certificado del curso El abordaje del estrés postraumático, de Imaya Formación',
      copc: `Carnet de colegiada del Col·legi Oficial de Psicologia de Catalunya, número ${SITE.licenseNumber}`,
    },
    approaches: [
      { title: 'Trauma y apego', text: 'EMDR, trauma relacional y complejo, teoría del apego y abordaje informado por el trauma.' },
      { title: 'Trabajo con partes y emociones', text: 'IFS (Sistemas Familiares Internos), Terapia Focalizada en las Emociones (EFT), Terapia de Esquemas y Terapia Centrada en la Compasión (CFT).' },
      { title: 'Cuerpo y regulación', text: 'Psicoterapia Sensoriomotriz, psicoterapias somáticas y trabajo con regulación emocional y del sistema nervioso.' },
      { title: 'Enfoques cognitivo-conductuales', text: 'Terapia Cognitivo-Conductual (TCC), Terapia Dialéctico-Conductual (DBT) y Terapias de Tercera Generación, especialmente ACT.' },
      { title: 'Enfoques relacionales', text: 'Terapia Sistémica, Terapia Humanista, Terapia Narrativa y Análisis Transaccional.' },
      { title: 'Otros recursos', text: 'Mindfulness y herramientas de regulación emocional.' },
    ],
  },
  ca: {
    metaTitle: 'Sobre mi, psicòloga general sanitària',
    description:
      'Soc Maria Morales, psicòloga general sanitària (COPC 35153). Treballo des de la psicologia integradora, en línia i a Barcelona, en català i en castellà.',
    title: PAGE_TITLES.about.ca,
    lead: 'Psicòloga general sanitària, col·legiada a Barcelona (COPC 35153). Atenc en línia i a Barcelona, en català i en castellà.',
    alt: 'Maria Morales, psicòloga general sanitària',
    whyTitle: 'Per què em dedico a això',
    why: "Em vaig dedicar a la psicologia perquè em desperta molta curiositat la conducta humana i com els aprenentatges condicionen la vida de les persones. Poder fer conscients molts dels processos inconscients de la nostra vida és la clau per tenir una vida plena.",
    howTitle: 'Com treballo',
    how: [
      "Treballo des de la psicologia integradora i m'adapto a cada persona. Cada persona és diferent, li funcionen coses diferents i se sent còmoda amb coses diferents. M'adapto al que crec que li pot encaixar millor per la seva personalitat i pel que necessita i sempre de manera consensuada amb el pacient, que no senti que perd el temps, sempre generant un espai de comunicació amb objectius clars.",
    ],
    chips: [`Col·legiada COPC ${SITE.licenseNumber}`, 'EMDR nivell I i II', 'Català i castellà'],
    trainingTitle: 'Formació',
    approachesTitle: "Enfocaments en què m'he format",
    academicTitle: 'Formació acadèmica',
    complementaryTitle: 'Formació complementària',
    certificatesTitle: 'Certificats',
    degrees: [
      { title: 'Màster en Psicologia General Sanitària', place: 'UNIR', years: '2025-2026' },
      { title: 'Grau en Psicologia', place: 'Universitat Oberta de Catalunya (UOC)', years: '2019-2025' },
      { title: 'Màster Oficial en Intervenció Criminològica i Victimològica', place: 'Universitat Miguel Hernández, Elx', years: '2016-2017' },
      { title: 'Grau en Criminologia', place: 'Universitat Autònoma de Barcelona', years: '2012-2016' },
    ],
    certificates: {
      emdr2: "Certificat de Formació Bàsica en EMDR Nivell II, d'Imaya Formación, acreditat per EMDR Europe",
      emdr1: "Certificat de Formació Bàsica en EMDR Nivell I, d'Imaya Formación, acreditat per EMDR Europe",
      perinatal1: 'Títol del Programa Universitari Avançat en Aferrament i Psicologia Perinatal, de la UNIR',
      perinatal2: 'Mòduls del Programa Universitari Avançat en Aferrament i Psicologia Perinatal, de la UNIR',
      ptsd: "Certificat del curs El abordaje del estrés postraumático, d'Imaya Formación",
      copc: `Carnet de col·legiada del Col·legi Oficial de Psicologia de Catalunya, número ${SITE.licenseNumber}`,
    },
    approaches: [
      { title: 'Trauma i aferrament', text: "EMDR, trauma relacional i complex, teoria de l'aferrament i abordatge informat pel trauma." },
      { title: 'Treball amb parts i emocions', text: "IFS (Sistemes Familiars Interns), Teràpia Focalitzada en les Emocions (EFT), Teràpia d'Esquemes i Teràpia Centrada en la Compassió (CFT)." },
      { title: 'Cos i regulació', text: 'Psicoteràpia Sensoriomotriu, psicoteràpies somàtiques i treball amb la regulació emocional i del sistema nerviós.' },
      { title: 'Enfocaments cognitivoconductuals', text: 'Teràpia Cognitivoconductual (TCC), Teràpia Dialecticoconductual (DBT) i Teràpies de Tercera Generació, especialment ACT.' },
      { title: 'Enfocaments relacionals', text: 'Teràpia Sistèmica, Teràpia Humanista, Teràpia Narrativa i Anàlisi Transaccional.' },
      { title: 'Altres recursos', text: 'Mindfulness i eines de regulació emocional.' },
    ],
  },
}[locale];

// Complementary training, from Maria's CV. Years are kept in the data but not
// shown, as Maria asked. Course names are kept as issued,
// so the Catalan page shows them in their original language too.
const COMPLEMENTARY = [
  { title: 'EMDR Nivel 1 y 2', place: 'IMAYA Formación. Asociación Española EMDR', years: '2026' },
  { title: 'Formación en Psicotrauma Modelo Cert', place: 'Centro Cert', years: '2026' },
  { title: 'Introducción terapia sistémica', place: 'Centro Cert', years: '2026' },
  { title: 'Formación en Sistemas Familiares Internos (IFS)', place: 'Formarme', years: '2026' },
  { title: 'Entender y explorar el apego', place: 'IMAYA Formación. Anabel González', years: '2026' },
  { title: 'Evaluando la disociación', place: 'IMAYA Formación. Anabel González', years: '2026' },
  { title: 'Estrés postraumático y las distintas emociones', place: 'IMAYA Formación. Anabel González', years: '2026' },
  { title: 'El abordaje del estrés postraumático', place: 'IMAYA Formación. Anabel González', years: '2026' },
  { title: 'Programa Universitario Avanzado en Apego y Psicología Perinatal', place: 'UNIR', years: '2026' },
  { title: 'Análisis transaccional', place: 'Hylé', years: '2025' },
  { title: 'Terapia de Aceptación y Compromiso', place: 'Udemy', years: '2025' },
  { title: 'Curso de terapia de esquemas', place: 'Asociación Española de Psicología Sanitaria', years: '2025' },
  { title: 'Curso de prevención e intervención en la conducta suicida', place: 'Asociación Española de Psicología Sanitaria', years: '2025' },
  { title: 'Certificación de Terapia Grupal en Salud Mental como Herramienta Psicoeducativa', place: 'Ilabora Formación', years: '2024' },
];

// Certificates as images. The originals were redacted before being added:
// ID number, signatures, verification codes and QR codes are covered, so
// nothing can be copied or used to fetch the original document.
const certificates = await Promise.all(
  [
    { src: certEmdr2, alt: COPY.certificates.emdr2 },
    { src: certEmdr1, alt: COPY.certificates.emdr1 },
    { src: certPerinatal1, alt: COPY.certificates.perinatal1 },
    { src: certPerinatal2, alt: COPY.certificates.perinatal2 },
    { src: certPtsd, alt: COPY.certificates.ptsd },
    { src: certCopc, alt: COPY.certificates.copc },
  ].map(async (c) => ({ ...c, full: await getImage({ src: c.src, width: 1600, format: 'webp' }) }))
);
---

<Layout title={COPY.metaTitle} description={COPY.description}>
  <PageHero title={COPY.title} lead={COPY.lead} />

  <section class="py-12 md:py-20">
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] items-start gap-10 lg:grid-cols-[380px_1fr] lg:gap-14">
      <div class="relative mx-auto w-full max-w-[380px]">
        <div class="absolute -right-4 -top-4 h-28 w-28 rounded-full bg-sun/70" aria-hidden="true"></div>
        <Picture
          src={mariaPortrait}
          formats={['avif', 'webp']}
          alt={COPY.alt}
          width={380}
          widths={[380, 760]}
          sizes="(max-width: 1024px) 90vw, 380px"
          class="relative aspect-[4/5] w-full rounded-[2rem] object-cover shadow-primary"
          loading="eager"
        />
      </div>

      <div class="max-w-[62ch]">
        <h2 class="text-2xl font-bold text-primary md:text-3xl">{COPY.whyTitle}</h2>
        <p class="mt-4">{COPY.why}</p>

        <h2 class="mt-10 text-2xl font-bold text-primary md:text-3xl">{COPY.howTitle}</h2>
        {COPY.how.map((p) => <p class="mt-4">{p}</p>)}

        <div class="mt-6 flex flex-wrap gap-2">
          <a href={SITE.copc} target="_blank" rel="noopener" data-event="license_click" data-event-location="about" class="inline-flex"
            ><Chip>{COPY.chips[0]}</Chip></a
          >
          <Chip>{COPY.chips[1]}</Chip>
          <Chip>{COPY.chips[2]}</Chip>
        </div>
      </div>
    </div>
  </section>

  <Wave from="var(--color-bg)" to="var(--color-surface)" />
  <section class="bg-surface py-12 md:py-20" id="formacion">
    <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
      <h2 class="text-2xl font-bold text-primary md:text-3xl">{COPY.trainingTitle}</h2>

      <h3 class="mt-8 text-xl font-bold text-ink">{COPY.academicTitle}</h3>
      <ul class="checklist mt-4 grid gap-x-10 sm:grid-cols-2">
        {
          COPY.degrees.map((d) => (
            <li>
              <span class="font-semibold">{d.title}</span>
              <span class="block text-sm text-muted">
                {d.place}
              </span>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-10 text-xl font-bold text-ink">{COPY.complementaryTitle}</h3>
      <ul class="checklist mt-4 grid gap-x-10 md:grid-cols-2">
        {
          COMPLEMENTARY.map((d) => (
            <li>
              <span class="font-semibold">{d.title}</span>
              <span class="block text-sm text-muted">
                {d.place}
              </span>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-10 text-xl font-bold text-ink">{COPY.approachesTitle}</h3>
      <dl class="mt-4 grid gap-x-10 gap-y-5 md:grid-cols-2">
        {
          COPY.approaches.map((a) => (
            <div>
              <dt class="font-bold text-primary-strong">{a.title}</dt>
              <dd class="mt-1 text-muted">{a.text}</dd>
            </div>
          ))
        }
      </dl>

      <h3 class="mt-10 text-xl font-bold text-ink">{COPY.certificatesTitle}</h3>
      <ul class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3">
        {
          certificates.map((c) => (
            <li>
              <a href={c.full.src} target="_blank" rel="noopener" class="block overflow-hidden rounded-xl border border-line/60 bg-white shadow-soft">
                <Image src={c.src} alt={c.alt} width={480} widths={[360, 480, 720]} sizes="(max-width: 768px) 45vw, 340px" class="aspect-[4/3] w-full bg-white object-contain" />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-10">
        <SocialLinks location="about" />
      </div>
    </div>
  </section>

  <CtaFinal from="var(--color-surface)" />
</Layout>
