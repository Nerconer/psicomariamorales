---
// Home page, shared by / and /ca/.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CtaFinal from '../components/CtaFinal.astro';
import GoogleReviewsLink from '../components/GoogleReviewsLink.astro';
import OrientationQuiz from '../components/OrientationQuiz.astro';
import Chip from '../components/ui/Chip.astro';
import Faq from '../components/ui/Faq.astro';
import Icon from '../components/ui/Icon.astro';
import ProblemCard from '../components/ui/ProblemCard.astro';
import WhatsAppIcon from '../components/ui/WhatsAppIcon.astro';
import { SITE, PRICES, REVIEWS, formatPrice, FREE_CALL_BY_LOCALE } from '../consts';
import type { Locale } from '../i18n/config';
import { pathFor } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import mariaHero from '../assets/img/maria-hero.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const to = (key: Parameters<typeof pathFor>[0]) => pathFor(key, locale);
const t = useTranslations(locale);

const first = formatPrice(PRICES.firstSession.amount);
const online = formatPrice(PRICES.online.amount);
const inPerson = formatPrice(PRICES.inPerson.amount);

// Doctoralia rating, shown on the photo and next to the credentials. Hidden
// while there are no reviews.
const reviews = REVIEWS.doctoralia;
const rating = reviews.rating.toLocaleString(locale === 'ca' ? 'ca-ES' : 'es-ES', { minimumFractionDigits: 1 });
const reviewsLabel = `${reviews.count} ${reviews.count === 1 ? t('doctoralia.one') : t('doctoralia.many')}`;

// The texts of the help block (recogniseIntro, growthIntro, closing) are
// Maria's own words (Refs #34): do not rewrite them.
const COPY = {
  es: {
    metaTitle: 'Psicóloga online y en Barcelona',
    description: `Maria Morales, psicóloga general sanitaria. Terapia online en toda España y presencial en Barcelona: ansiedad, estrés, pareja, autoestima y trauma con EMDR. Primera sesión ${first}.`,
    hello: 'Hola, soy Maria',
    role: SITE.role,
    // The highlighted word is the modality Maria wants to push.
    h1: ['Psicóloga ', 'online', ' y en Barcelona'],
    sub: 'Te acompaño cuando algo pesa, y también cuando estás bien pero quieres cambiar algo.',
    book: `Reservar primera sesión · ${first}`,
    freeCall: 'Llamada gratuita de 15 min',
    facts: { online: `Online desde casa · ${online}`, inPerson: `Presencial en Barcelona · ${inPerson}`, languages: 'Castellano y català' },
    photoAlt: `${SITE.person}, ${SITE.role}`,
    outOf: 'sobre 5',
    recogniseTitle: '¿Te reconoces en algo de esto?',
    recogniseIntro:
      'A veces no es ansiedad exactamente. Puede aparecer como estrés, tristeza, inseguridad, dificultad para poner límites o sensación de estar bloqueado/a. Si te reconoces en alguna de estas situaciones, la terapia puede ayudarte:',
    hardTitle: 'Si estás pasando un mal momento',
    growthTitle: 'Si estás bien, pero quieres mejorar',
    growthIntro:
      'Y a veces el problema es precisamente no saber cómo afrontar lo que te está pasando: evitar conversaciones difíciles, bloquearte ante los conflictos, darle demasiadas vueltas antes de decidir o reaccionar de una manera que después no entiendes.',
    closing: 'Si llevas tiempo pensando «no sé qué me pasa, pero no estoy bien», también es un motivo válido para pedir ayuda.',
    hard: [
      { icon: 'anxiety', title: 'Ansiedad', text: 'Tu mente no para y te cuesta desconectar.', key: 'anxiety' },
      { icon: 'stress', title: 'Estrés y burnout', text: 'Sientes que ya no puedes con todo.', key: 'stress' },
      { icon: 'grief', title: 'Duelo', text: 'Una pérdida que no encuentra alivio.', key: 'grief' },
      { icon: 'trauma', title: 'Trauma y EMDR', text: 'El pasado sigue pesando en tu presente.', key: 'emdr' },
    ],
    growth: [
      { icon: 'couple', title: 'Tu relación de pareja', text: 'Comunicaros mejor, también sin crisis.', key: 'couples' },
      { icon: 'confidence', title: 'Seguridad en ti', text: 'Exigirte menos y confiar más en ti.', key: 'selfEsteem' },
      { icon: 'blocks', title: 'Bloqueos y decisiones', text: 'Sabes lo que quieres cambiar, pero algo te frena.', key: 'growth' },
      { icon: 'self', title: 'Límites', text: 'Decir que no sin sentir culpa.', key: 'growth' },
    ],
    quizTitle: '¿No sabes por dónde empezar?',
    quizIntro: 'Tres preguntas y te digo cómo puedo ayudarte. Tus respuestas no se guardan ni se envían.',
    whoTitle: 'Quién soy',
    who: 'Soy Maria Morales, psicóloga general sanitaria. Trabajo desde la psicología integradora y me he especializado en trauma y apego con EMDR.',
    whoChips: [`Colegiada COPC ${SITE.licenseNumber}`, 'EMDR nivel I y II', 'Máster en Psicología General Sanitaria'],
    meet: 'Conóceme',
    stepsTitle: 'Cómo empezamos',
    steps: [
      { title: 'Llamada gratuita de 15 minutos', text: 'Pídela por WhatsApp o por teléfono y resolvemos tus dudas antes de empezar.' },
      { title: `Primera sesión, ${first}`, text: `${PRICES.firstSession.minutes} minutos para conocernos y ver qué necesitas. Online o en Barcelona.` },
      { title: 'Seguimos a tu ritmo', text: `Online ${online}, presencial ${inPerson}.` },
    ],
    pricing: 'Ver tarifas',
    faqTitle: 'Dudas',
    faqs: [
      { q: '¿Puedo ir a terapia aunque esté bien?', a: 'Sí. Mucha gente viene para entenderse mejor, tomar una decisión o mejorar su relación, sin que haya una crisis.' },
      { q: '¿Funciona igual la terapia online?', a: 'Sí. La forma de trabajar es la misma. Solo necesitas un sitio tranquilo y conexión a internet.' },
      { q: '¿Necesito saber qué me pasa para empezar?', a: 'No. Muchas personas llegan sintiendo malestar, bloqueo o confusión, sin tener todavía claro qué les ocurre. Ese también es un buen punto de partida.' },
      { q: '¿Qué pasa en la primera sesión?', a: 'Nos conocemos, me cuentas qué te trae y vemos qué necesitas. También resolvemos tus dudas sobre el proceso.' },
      { q: '¿Lo que cuento es confidencial?', a: 'Sí. Lo que hablamos en sesión queda entre tú y yo, protegido por el secreto profesional. Solo podría romperse si hubiera un riesgo grave para ti o para otra persona.' },
      { q: '¿Cuánto dura la terapia?', a: 'Depende de cada persona y de lo que quiera trabajar. Lo vamos revisando sobre la marcha.' },
      { q: '¿Atiendes a adolescentes?', a: 'Sí, a partir de 12 años. También a adultos, online o en Barcelona.' },
    ],
  },
  ca: {
    metaTitle: 'Psicòloga en línia i a Barcelona',
    description: `Maria Morales, psicòloga general sanitària. Teràpia en línia a tot Espanya i presencial a Barcelona: ansietat, estrès, parella, autoestima i trauma amb EMDR. Primera sessió ${first}.`,
    hello: 'Hola, soc Maria',
    role: SITE.roleCa,
    h1: ['Psicòloga ', 'en línia', ' i a Barcelona'],
    sub: "T'acompanyo quan alguna cosa pesa, i també quan estàs bé però vols canviar alguna cosa.",
    book: `Reservar la primera sessió · ${first}`,
    freeCall: 'Trucada gratuïta de 15 min',
    facts: { online: `En línia des de casa · ${online}`, inPerson: `Presencial a Barcelona · ${inPerson}`, languages: 'Català i castellà' },
    photoAlt: `${SITE.person}, ${SITE.roleCa}`,
    outOf: 'sobre 5',
    recogniseTitle: "T'hi reconeixes en alguna cosa d'això?",
    recogniseIntro:
      "De vegades no és exactament ansietat. Pot aparèixer com a estrès, tristesa, inseguretat, dificultat per posar límits o sensació d'estar bloquejat/da. Si et reconeixes en alguna d'aquestes situacions, la teràpia et pot ajudar:",
    hardTitle: 'Si estàs passant un mal moment',
    growthTitle: 'Si estàs bé, però vols millorar',
    growthIntro:
      "I de vegades el problema és precisament no saber com afrontar el que t'està passant: evitar converses difícils, bloquejar-te davant dels conflictes, donar-hi massa voltes abans de decidir o reaccionar d'una manera que després no entens.",
    closing: 'Si fa temps que penses «no sé què em passa, però no estic bé», també és un motiu vàlid per demanar ajuda.',
    hard: [
      { icon: 'anxiety', title: 'Ansietat', text: "La teva ment no s'atura i et costa desconnectar.", key: 'anxiety' },
      { icon: 'stress', title: 'Estrès i burnout', text: 'Sents que ja no pots amb tot.', key: 'stress' },
      { icon: 'grief', title: 'Dol', text: 'Una pèrdua que no troba alleujament.', key: 'grief' },
      { icon: 'trauma', title: 'Trauma i EMDR', text: 'El passat continua pesant en el teu present.', key: 'emdr' },
    ],
    growth: [
      { icon: 'couple', title: 'La teva relació de parella', text: 'Comunicar-vos millor, també sense crisi.', key: 'couples' },
      { icon: 'confidence', title: 'Seguretat en tu', text: "Exigir-te menys i confiar més en tu.", key: 'selfEsteem' },
      { icon: 'blocks', title: 'Bloquejos i decisions', text: "Saps què vols canviar, però alguna cosa t'atura.", key: 'growth' },
      { icon: 'self', title: 'Límits', text: 'Dir que no sense sentir culpa.', key: 'growth' },
    ],
    quizTitle: 'No saps per on començar?',
    quizIntro: "Tres preguntes i et dic com et puc ajudar. Les teves respostes no es guarden ni s'envien.",
    whoTitle: 'Qui soc',
    who: "Soc Maria Morales, psicòloga general sanitària. Treballo des de la psicologia integradora i m'he especialitzat en trauma i aferrament amb EMDR.",
    whoChips: [`Col·legiada COPC ${SITE.licenseNumber}`, 'EMDR nivell I i II', 'Màster en Psicologia General Sanitària'],
    meet: "Coneix-me",
    stepsTitle: 'Com comencem',
    steps: [
      { title: 'Trucada gratuïta de 15 minuts', text: 'Demana-la per WhatsApp o per telèfon i resolem els teus dubtes abans de començar.' },
      { title: `Primera sessió, ${first}`, text: `${PRICES.firstSession.minutes} minuts per conèixer-nos i veure què necessites. En línia o a Barcelona.` },
      { title: 'Continuem al teu ritme', text: `En línia ${online}, presencial ${inPerson}.` },
    ],
    pricing: 'Veure tarifes',
    faqTitle: 'Dubtes',
    faqs: [
      { q: 'Puc anar a teràpia encara que estigui bé?', a: "Sí. Molta gent ve per entendre's millor, prendre una decisió o millorar la seva relació, sense que hi hagi una crisi." },
      { q: 'Funciona igual la teràpia en línia?', a: 'Sí. La manera de treballar és la mateixa. Només necessites un lloc tranquil i connexió a internet.' },
      { q: 'He de saber què em passa per començar?', a: 'No. Moltes persones arriben amb malestar, bloqueig o confusió, sense tenir encara clar què els passa. Aquest també és un bon punt de partida.' },
      { q: 'Què passa a la primera sessió?', a: "Ens coneixem, m'expliques què t'hi porta i veiem què necessites. També resolem els teus dubtes sobre el procés." },
      { q: 'El que explico és confidencial?', a: 'Sí. El que parlem a la sessió queda entre tu i jo, protegit pel secret professional. Només es podria trencar si hi hagués un risc greu per a tu o per a una altra persona.' },
      { q: 'Quant dura la teràpia?', a: 'Depèn de cada persona i del que vulgui treballar. Ho anem revisant sobre la marxa.' },
      { q: 'Atens adolescents?', a: 'Sí, a partir de 12 anys. També adults, en línia o a Barcelona.' },
    ],
  },
} as const;

const c = COPY[locale];
const sectionTitle = 'text-3xl font-bold md:text-4xl';
const groupTitle = 'text-sm font-bold uppercase tracking-[0.08em] text-muted';
---

<Layout title={c.metaTitle} description={c.description}>
  <!-- Hero: two actions only, booking and the free call, plus checkable facts. -->
  <section>
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] items-center gap-12 py-10 md:py-16 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-16 lg:py-20">
      <div>
        <div class="flex items-center gap-4">
          <Image
            src={mariaHero}
            alt=""
            widths={[112, 168]}
            sizes="56px"
            class="h-14 w-14 shrink-0 rounded-full object-cover ring-2 ring-highlight ring-offset-2 ring-offset-bg lg:hidden"
            loading="eager"
          />
          <div class="leading-snug">
            <p class="font-display text-lg font-bold">{c.hello}</p>
            <p class="mt-0.5 flex flex-wrap items-center gap-x-1.5 text-sm text-muted">
              <Icon name="verified" size={16} class="text-primary" />
              {c.role} ·
              <a
                href={SITE.copc}
                target="_blank"
                rel="noopener"
                data-event="license_click"
                data-event-location="hero"
                class="underline decoration-primary/30 underline-offset-4 hover:text-primary"
                >Col. {SITE.licenseNumber}</a
              >
            </p>
          </div>
        </div>

        <h1 class="mt-7 text-[2.5rem] font-bold leading-[1.04] tracking-[-0.035em] sm:text-[3.25rem] lg:text-[3.75rem]">
          {c.h1[0]}<span class="text-primary">{c.h1[1]}</span>{c.h1[2]}
        </h1>
        <p class="mt-5 max-w-[42ch] text-lg text-muted md:text-xl">{c.sub}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={SITE.doctoralia} target="_blank" rel="noopener" data-event="booking_click" data-event-location="hero" class="btn-primary">
            <Icon name="calendar" size={20} />
            {c.book}
          </a>
          <a href={FREE_CALL_BY_LOCALE[locale]} target="_blank" rel="noopener" data-event="free_call_click" data-event-location="hero" class="btn-whatsapp">
            <WhatsAppIcon size={20} class="text-[#128c4a]" />
            {c.freeCall}
          </a>
        </div>

        <ul class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2.5 text-[0.95rem] text-muted">
          <li class="inline-flex items-center gap-1.5 rounded-full bg-highlight py-1.5 pl-2.5 pr-3.5 font-semibold text-ink">
            <Icon name="online" size={17} />
            {c.facts.online}
          </li>
          <li class="inline-flex items-center gap-1.5"><Icon name="location" size={17} class="text-primary" /> {c.facts.inPerson}</li>
          <li class="inline-flex items-center gap-1.5"><Icon name="language" size={17} class="text-primary" /> {c.facts.languages}</li>
        </ul>
      </div>

      <div class="relative mx-auto hidden w-full max-w-[440px] lg:block">
        <div class="absolute inset-0 translate-x-5 translate-y-5 rounded-photo bg-highlight" aria-hidden="true"></div>
        <Image
          src={mariaHero}
          alt={c.photoAlt}
          widths={[440, 744, 880]}
          sizes="440px"
          class="relative aspect-[4/5] w-full rounded-photo object-cover object-[50%_30%]"
          loading="eager"
          fetchpriority="high"
        />
        {
          reviews.count > 0 && (
            <a
              href={SITE.doctoralia}
              target="_blank"
              rel="noopener"
              data-event="reviews_click"
              data-event-location="hero_badge"
              class="absolute -left-8 bottom-10 grid grid-cols-[auto_auto] items-baseline gap-x-2 rounded-2xl bg-white px-4 py-3 shadow-float transition-[translate] duration-200 motion-safe:hover:-translate-y-0.5"
            >
              <span class="font-display text-2xl font-bold tracking-[-0.02em]">
                {rating}<span class="sr-only"> {c.outOf}.</span>
              </span>
              <span class="tracking-[1px] text-primary" aria-hidden="true">★★★★★</span>
              <span class="col-span-2 text-xs text-muted">{reviewsLabel}</span>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- How we start: price and first step before asking for anything. -->
  <section class="bg-surface py-14 md:py-20">
    <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class={sectionTitle}>{c.stepsTitle}</h2>
        <a href={to('pricing')} class="link">{c.pricing}</a>
      </div>
      <ol class="mt-8 grid gap-3 md:grid-cols-3 md:gap-4">
        {
          c.steps.map((s, i) => (
            <li class="flex flex-col gap-1.5 rounded-card bg-white p-6">
              <span class="mb-2 grid h-9 w-9 place-items-center rounded-[0.65rem] bg-highlight font-display font-bold text-ink" aria-hidden="true">
                {i + 1}
              </span>
              <h3 class="text-lg font-bold">{s.title}</h3>
              <p class="text-base text-muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Do you recognise yourself -->
  <section class="py-14 md:py-20" id="ayuda">
    <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
      <div class="max-w-[68ch]">
        <h2 class={sectionTitle}>{c.recogniseTitle}</h2>
        <p class="mt-4 text-muted">{c.recogniseIntro}</p>
      </div>

      <h3 class:list={['mt-10', groupTitle]}>{c.hardTitle}</h3>
      <div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
        {c.hard.map((card) => <ProblemCard href={to(card.key)} title={card.title} text={card.text} icon={card.icon} />)}
      </div>

      <h3 class:list={['mt-12', groupTitle]}>{c.growthTitle}</h3>
      <p class="mt-3 max-w-[68ch] text-muted">{c.growthIntro}</p>
      <div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
        {c.growth.map((card) => <ProblemCard href={to(card.key)} title={card.title} text={card.text} icon={card.icon} />)}
      </div>

      <p class="mt-12 max-w-[52ch] font-display text-xl font-semibold leading-snug text-primary-strong md:text-2xl">{c.closing}</p>
    </div>
  </section>

  <!-- Orientation quiz -->
  <section class="bg-surface py-14 md:py-20" id="test">
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] lg:gap-12">
      <div>
        <h2 class={sectionTitle}>{c.quizTitle}</h2>
        <p class="mt-3 max-w-[40ch] text-muted">{c.quizIntro}</p>
      </div>
      <OrientationQuiz locale={locale} />
    </div>
  </section>

  <!-- Who I am, with the credentials and reviews anyone can check -->
  <section class="py-14 md:py-20">
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] lg:gap-12">
      <h2 class={sectionTitle}>{c.whoTitle}</h2>
      <div>
        <p class="max-w-[60ch]">{c.who}</p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href={SITE.copc} target="_blank" rel="noopener" data-event="license_click" data-event-location="home_about" class="inline-flex"
            ><Chip icon="verified">{c.whoChips[0]}</Chip></a
          >
          <Chip>{c.whoChips[1]}</Chip>
          <Chip>{c.whoChips[2]}</Chip>
        </div>
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
          {
            reviews.count > 0 && (
              <a
                href={SITE.doctoralia}
                target="_blank"
                rel="noopener"
                data-event="reviews_click"
                data-event-location="home_about"
                class="link"
              >
                {rating} <span aria-hidden="true">★</span><span class="sr-only">{c.outOf}</span> · {reviewsLabel}
              </a>
            )
          }
          <GoogleReviewsLink />
        </div>
        <a href={to('about')} class="btn-outline mt-7">{c.meet}</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-surface py-14 md:py-20" id="faq">
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.8fr)] lg:gap-12">
      <h2 class={sectionTitle}>{c.faqTitle}</h2>
      <Faq items={[...c.faqs]} schema />
    </div>
  </section>

  <CtaFinal />
</Layout>
