---
// Pricing page, shared by the Spanish and Catalan routes.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import DoctoraliaEmbed from '../components/DoctoraliaEmbed.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE, PRICES, formatPrice, FREE_CALL_BY_LOCALE } from '../consts';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = (key: keyof typeof PRICES) => formatPrice(PRICES[key].amount);

const COPY = {
  es: {
    metaTitle: 'Tarifas de terapia online y en Barcelona',
    description: `Primera sesión ${p('firstSession')}, terapia online ${p('online')}, presencial en Barcelona ${p('inPerson')} y terapia de pareja ${p('couple')}. Sesiones de 60 minutos, pareja de 90.`,
    title: 'Tarifas',
    lead: 'Las sesiones duran 60 minutos. La terapia de pareja, 90.',
    rates: [
      { title: 'Terapia online', key: 'online', desc: 'Por videollamada, desde donde estés.', featured: true },
      { title: 'Primera sesión', key: 'firstSession', desc: 'Para conocernos y ver qué necesitas. Terapia individual, online o en Barcelona.', featured: false },
      { title: 'Presencial', key: 'inPerson', desc: 'En la consulta de Barcelona.', featured: false },
      { title: 'Terapia de pareja', key: 'couple', desc: 'Para los dos, online o en Barcelona.', featured: false },
    ],
    book: 'Reservar',
    doubts: '¿Tienes dudas antes de reservar?',
    freeCall: 'Pide una llamada gratuita de 15 minutos',
    calendarTitle: 'Reserva sin salir de la web',
    payTitle: 'Pago',
    pay: 'Efectivo, transferencia o Bizum. Las sesiones online se pagan antes de la cita.',
    cancelTitle: 'Cancelación',
    cancel: 'Si no puedes venir, avísame con 24 horas de antelación y la cambiamos sin coste.',
    review: 'Los precios se revisan una vez al año.',
  },
  ca: {
    metaTitle: 'Tarifes de teràpia en línia i a Barcelona',
    description: `Primera sessió ${p('firstSession')}, teràpia en línia ${p('online')}, presencial a Barcelona ${p('inPerson')} i teràpia de parella ${p('couple')}. Sessions de 60 minuts, parella de 90.`,
    title: 'Tarifes',
    lead: 'Les sessions duren 60 minuts. La teràpia de parella, 90.',
    rates: [
      { title: 'Teràpia en línia', key: 'online', desc: "Per videotrucada, des d'on siguis.", featured: true },
      { title: 'Primera sessió', key: 'firstSession', desc: 'Per conèixer-nos i veure què necessites. Teràpia individual, en línia o a Barcelona.', featured: false },
      { title: 'Presencial', key: 'inPerson', desc: 'A la consulta de Barcelona.', featured: false },
      { title: 'Teràpia de parella', key: 'couple', desc: 'Per a tots dos, en línia o a Barcelona.', featured: false },
    ],
    book: 'Reservar',
    doubts: 'Tens dubtes abans de reservar?',
    freeCall: 'Demana una trucada gratuïta de 15 minuts',
    calendarTitle: 'Reserva sense sortir del web',
    payTitle: 'Pagament',
    pay: 'Efectiu, transferència o Bizum. Les sessions en línia es paguen abans de la cita.',
    cancelTitle: 'Cancel·lació',
    cancel: "Si no pots venir, avisa'm amb 24 hores d'antelació i la canviem sense cost.",
    review: "Els preus es revisen un cop l'any.",
  },
}[locale] as {
  metaTitle: string; description: string; title: string; lead: string;
  rates: Array<{ title: string; key: keyof typeof PRICES; desc: string; featured: boolean }>;
  book: string; doubts: string; freeCall: string; calendarTitle: string;
  payTitle: string; pay: string; cancelTitle: string; cancel: string; review: string;
};
---

<Layout title={COPY.metaTitle} description={COPY.description}>
  <PageHero title={COPY.title} lead={COPY.lead} />

  <section class="py-12 md:py-16">
    <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          COPY.rates.map((r) => (
            <div
              class:list={[
                'flex flex-col rounded-2xl border p-6',
                r.featured ? 'border-primary bg-primary text-white' : 'border-line/60 bg-white',
              ]}
            >
              <h2 class:list={['text-xl font-bold', r.featured && 'text-white']}>{r.title}</h2>
              <p class="mt-3 flex items-baseline gap-2">
                <span class="font-display text-4xl font-bold">{formatPrice(PRICES[r.key].amount)}</span>
                <span class:list={['text-sm font-semibold', r.featured ? 'text-white/85' : 'text-muted']}>
                  {PRICES[r.key].minutes} min
                </span>
              </p>
              <p class:list={['mt-3 flex-1 text-base', r.featured ? 'text-white/90' : 'text-muted']}>{r.desc}</p>
              <a
                href={SITE.doctoralia}
                target="_blank"
                rel="noopener"
                data-event="booking_click"
                data-event-location="pricing_card"
                data-event-rate={r.key}
                class:list={['mt-5', r.featured ? 'btn-light' : 'btn-outline']}
              >
                {COPY.book}
              </a>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-center text-base text-muted">
        {COPY.doubts}{' '}
        <a
          href={FREE_CALL_BY_LOCALE[locale]}
          target="_blank"
          rel="noopener"
          data-event="free_call_click"
          data-event-location="pricing"
          class="font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary"
          >{COPY.freeCall}</a
        >.
      </p>
    </div>
  </section>

  <section class="bg-surface py-12 md:py-16" id="reservar">
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.8fr)] lg:gap-12">
      <h2 class="text-2xl font-bold md:text-3xl">{COPY.calendarTitle}</h2>
      <div>
        <DoctoraliaEmbed mode="calendar" location="pricing" />
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] gap-4 md:grid-cols-2">
      <div class="card">
        <h2 class="flex items-center gap-2 text-xl font-bold"><Icon name="check" class="text-primary" /> {COPY.payTitle}</h2>
        <p class="mt-2 text-muted">{COPY.pay}</p>
      </div>
      <div class="card">
        <h2 class="flex items-center gap-2 text-xl font-bold"><Icon name="calendar" class="text-primary" /> {COPY.cancelTitle}</h2>
        <p class="mt-2 text-muted">{COPY.cancel}</p>
      </div>
      <p class="text-sm text-muted md:col-span-2">{COPY.review}</p>
    </div>
  </section>

  <CtaFinal />
</Layout>
