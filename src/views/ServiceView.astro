---
// Service landing page, shared by the Spanish and Catalan routes.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Wave from '../components/Wave.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import AnxietyTest from '../components/AnxietyTest.astro';
import Faq from '../components/ui/Faq.astro';
import Icon from '../components/ui/Icon.astro';
import WhatsAppIcon from '../components/ui/WhatsAppIcon.astro';
import type { Service } from '../data/services';
import type { Locale } from '../i18n/config';
import type { Post } from '../lib/posts';
import { SITE, PRICES, formatPrice, WHATSAPP_BY_LOCALE, FREE_CALL_BY_LOCALE } from '../consts';

interface Props {
  service: Service;
  locale: Locale;
  related: Post[];
}
const { service, locale, related } = Astro.props;
const c = service[locale];

const COPY = {
  es: {
    approach: 'Cómo lo trabajo',
    online: 'Online',
    inPerson: 'Presencial en Barcelona',
    first: 'Primera sesión',
    length: `Sesiones de ${PRICES.online.minutes} minutos, en castellano o en catalán.`,
    book: 'Reservar primera sesión',
    freeCall: 'Pedir llamada gratuita de 15 min',
    faq: 'Dudas',
  },
  ca: {
    approach: 'Com ho treballo',
    online: 'En línia',
    inPerson: 'Presencial a Barcelona',
    first: 'Primera sessió',
    length: `Sessions de ${PRICES.online.minutes} minuts, en català o en castellà.`,
    book: 'Reservar la primera sessió',
    freeCall: 'Demanar trucada gratuïta de 15 min',
    faq: 'Dubtes',
  },
}[locale];

const location = `service_${service.key}`;
---

<Layout title={c.metaTitle} description={c.description}>
  <PageHero title={c.title} lead={c.lead} />

  <section class="py-12 md:py-16">
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] gap-10 lg:grid-cols-[1.25fr_0.75fr]">
      <div>
        <h2 class="text-2xl font-bold text-primary md:text-3xl">{c.signsTitle}</h2>
        <ul class="checklist mt-5">
          {c.signs.map((s) => <li>{s}</li>)}
        </ul>

        <h2 class="mt-10 text-2xl font-bold text-primary md:text-3xl">{COPY.approach}</h2>
        {c.approach.map((p) => <p class="mt-4 max-w-[62ch]">{p}</p>)}
      </div>

      <aside class="self-start rounded-2xl border border-line/60 bg-white p-6 lg:sticky lg:top-24">
        <ul class="space-y-3">
          <li class="flex items-center justify-between gap-3">
            <span class="flex items-center gap-2 font-semibold"><Icon name="online" class="text-primary" /> {COPY.online}</span>
            <span class="font-display text-xl font-bold">{formatPrice(PRICES.online.amount)}</span>
          </li>
          <li class="flex items-center justify-between gap-3">
            <span class="flex items-center gap-2 font-semibold"><Icon name="location" class="text-primary" /> {COPY.inPerson}</span>
            <span class="font-display text-xl font-bold">{formatPrice(PRICES.inPerson.amount)}</span>
          </li>
          <li class="flex items-center justify-between gap-3 rounded-xl bg-sun/40 px-3 py-2">
            <span class="font-semibold">{COPY.first}</span>
            <span class="font-display text-xl font-bold">{formatPrice(PRICES.firstSession.amount)}</span>
          </li>
        </ul>
        <p class="mt-3 text-sm text-muted">{COPY.length}</p>
        <div class="mt-5 grid gap-3">
          <a href={SITE.doctoralia} target="_blank" rel="noopener" data-event="booking_click" data-event-location={location} class="btn-primary">
            <Icon name="calendar" size={20} /> {COPY.book}
          </a>
          <a href={WHATSAPP_BY_LOCALE[locale]} target="_blank" rel="noopener" data-event="whatsapp_click" data-event-location={location} class="btn-whatsapp">
            <WhatsAppIcon size={20} class="text-[#128c4a]" /> WhatsApp
          </a>
          <a
            href={FREE_CALL_BY_LOCALE[locale]}
            target="_blank"
            rel="noopener"
            data-event="free_call_click"
            data-event-location={location}
            class="text-center font-semibold text-primary underline decoration-line underline-offset-4 hover:decoration-primary"
            >{COPY.freeCall}</a
          >
        </div>
      </aside>
    </div>
  </section>

  {
    service.key === 'anxiety' && (
      <section class="pb-12 md:pb-16">
        <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
          <AnxietyTest locale={locale} />
        </div>
      </section>
    )
  }

  <Wave from="var(--color-bg)" to="var(--color-surface)" />
  <section class="bg-surface py-12 md:py-16">
    <div class="mx-auto w-[min(820px,calc(100%-2rem))]">
      <h2 class="text-2xl font-bold text-primary md:text-3xl">{COPY.faq}</h2>
      <div class="mt-5">
        <Faq items={c.faqs} schema />
      </div>
    </div>
  </section>

  <Wave from="var(--color-surface)" to="var(--color-bg)" flip />
  <RelatedPosts posts={related} />

  <CtaFinal />
</Layout>
