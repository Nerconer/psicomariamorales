---
// Therapy hub, shared by the Spanish and Catalan routes.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Wave from '../components/Wave.astro';
import LifeStages from '../components/LifeStages.astro';
import ApproachCard from '../components/ApproachCard.astro';
import SpecialtyDoors, { type Door } from '../components/SpecialtyDoors.astro';
import DoctoraliaBadge from '../components/DoctoraliaBadge.astro';
import GoogleReviewsLink from '../components/GoogleReviewsLink.astro';
import { APPROACHES } from '../data/approaches';
import { Picture } from 'astro:assets';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import mariaWriting from '../assets/img/maria-writing.jpg';
import { PRICES, formatPrice, FREE_CALL_BY_LOCALE } from '../consts';
import { PAGE_TITLES } from '../data/page-titles';
import type { Locale } from '../i18n/config';
import { pathFor, type RouteKey } from '../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Every specialty links to its own page (issue #45).
const LANDINGS: Record<string, RouteKey> = {
  ansiedad: 'anxiety',
  estres: 'stress',
  burnout: 'stress',
  autoestima: 'selfEsteem',
  perfeccionismo: 'selfEsteem',
  bloqueos: 'growth',
  sentido: 'growth',
  duelo: 'grief',
  trauma: 'emdr',
  victima: 'emdr',
  panico: 'panic',
  intrusivos: 'intrusive',
  tristeza: 'sadness',
  regulacion: 'emotionRegulation',
  irritabilidad: 'irritability',
  control: 'control',
  conflictos: 'conflicts',
  dependencia: 'dependency',
  apego: 'attachment',
  familia: 'family',
  soledad: 'loneliness',
  evitacion: 'avoidance',
  pantallas: 'screens',
  crisis: 'lifeCrisis',
  jovenes: 'youth',
  perinatal: 'perinatal',
  disociacion: 'dissociation',
};

type Specialty = { id: string; title: string; text: string };

// The specialties are shown in six groups, each one a "door" phrased the way a
// visitor would say it, because many people do not know the name of what they
// have. Anxiety comes first and trauma last, as Maria asked.
//
// The groups hold a similar amount of text, so no panel looks half empty next
// to the others. Within a group, the order is the one that splits the items
// into two columns of about the same height: check the panels on desktop after
// moving an item or changing a long description.
type GroupKey = 'alert' | 'emotions' | 'self' | 'relationships' | 'stages' | 'past';
const GROUPS: { key: GroupKey; icon: IconName; ids: string[] }[] = [
  { key: 'alert', icon: 'anxiety', ids: ['ansiedad', 'intrusivos', 'estres', 'burnout', 'panico'] },
  { key: 'emotions', icon: 'heart', ids: ['tristeza', 'regulacion', 'irritabilidad', 'evitacion', 'pantallas'] },
  { key: 'self', icon: 'confidence', ids: ['autoestima', 'perfeccionismo', 'bloqueos', 'control', 'sentido'] },
  { key: 'relationships', icon: 'couple', ids: ['dependencia', 'apego', 'soledad', 'familia', 'conflictos'] },
  { key: 'stages', icon: 'self', ids: ['crisis', 'perinatal', 'jovenes'] },
  { key: 'past', icon: 'trauma', ids: ['duelo', 'disociacion', 'victima', 'trauma'] },
];

// The ids are the anchors other pages link to, so they stay the same in both
// languages.
const COPY: Record<Locale, { metaTitle: string; description: string; title: string; intro: string[]; photoAlt: string; online: string; onlineText: string; inPerson: string; inPersonText: string; listTitle: string; doorsIntro: string; doors: Record<GroupKey, string>; unsureTitle: string; unsureText: string; quizLabel: string; freeCallLabel: string; reviewsTitle: string; specialties: Specialty[] }> = {
  es: {
    metaTitle: 'Terapia psicológica en Barcelona',
    description:
      'Terapia psicológica online en toda España y presencial en Barcelona: ansiedad, estrés, burnout, autoestima, bloqueos, duelo y trauma con EMDR.',
    title: PAGE_TITLES.therapy.es,
    intro: [
      "Para mí los síntomas (psicológicos y somáticos) y el malestar que podemos tener las personas simplemente es el cuerpo hablando. La finalidad biológica de nuestro cuerpo es sobrevivir y para ello tiene muchos mecanismos para garantizarlo, lo que pasa que muchas veces no tenemos las herramientas o la consciencia para entenderlos y se acaban cronificando manifestándose en formato síntomas y malestar, perdiendo así salud (esos mecanismos no cumplen con su función).",
      "Cuando se entienden, cumplen su función y muchas veces ese malestar desaparece. Eso es a lo que me dedico, a entender el origen y el porqué de los síntomas y el malestar.",
      'Trabajo desde la psicología integradora. Me adapto a cada persona, a cada situación y a cada necesidad. No todo funciona de la misma manera en cada persona.',
      'Tengo formación amplia en diferentes enfoques y corrientes: cognitivo-conductual, terapias de tercera generación, EMDR nivel I y II, IFS, terapia focalizada en la emoción, terapia sistémica y análisis transaccional, entre otros.',
    ],
    photoAlt: 'Maria Morales tomando notas en un cuaderno',
    online: 'Online',
    onlineText: 'Por videollamada, desde cualquier lugar de España.',
    inPerson: 'Presencial',
    inPersonText: 'En la consulta de Barcelona.',
    listTitle: 'Con qué puedo acompañarte',
    doorsIntro: '¿Te reconoces en alguna de estas situaciones?',
    doors: {
      alert: 'Mi cabeza no para',
      emotions: 'Me cuesta llevar lo que siento',
      self: 'Me exijo mucho o no sé qué quiero',
      relationships: 'Me pesan las relaciones',
      stages: 'Una etapa que lo remueve todo',
      past: 'Algo que me pasó y sigue doliendo',
    },
    unsureTitle: '¿No sabes ponerle nombre?',
    unsureText: 'Si llevas tiempo pensando «no sé qué me pasa, pero no estoy bien», también es un motivo válido para pedir ayuda.',
    quizLabel: 'Responder 3 preguntas',
    freeCallLabel: 'Llamada gratuita de 15 min',
    reviewsTitle: 'Opiniones de pacientes',
    specialties: [
      { id: 'ansiedad', title: 'Ansiedad', text: 'Insomnio, presión en el pecho, pensamientos constantes, obsesiones o rumiaciones.' },
      { id: 'estres', title: 'Estrés', text: 'Cuando las exigencias superan durante mucho tiempo lo que puedes sostener.' },
      { id: 'burnout', title: 'Burnout', text: 'El trabajo te ha dejado sin energía ni ganas.' },
      { id: 'panico', title: 'Ataques de pánico', text: 'Un miedo intenso y repentino, con síntomas físicos que asustan.' },
      { id: 'intrusivos', title: 'Pensamientos intrusivos, obsesiones y compulsiones', text: 'Ideas o imágenes que aparecen sin querer y generan malestar. Pueden llevar a que repitas alguna acción para sentirte mejor.' },
      { id: 'tristeza', title: 'Tristeza', text: 'Sentirme sin ganas, que todo me cueste, hasta las tareas más simples.' },
      { id: 'autoestima', title: 'Autoestima', text: 'Te gustaría valorarte y tratarte bien.' },
      { id: 'regulacion', title: 'Regulación emocional', text: 'Emociones tan intensas y desbordantes que cuesta entenderlas y manejarlas, generando malestar y acciones de regulación poco saludables (atracones, autolesiones, tricotilomanía, etc.).' },
      { id: 'irritabilidad', title: 'Irritabilidad', text: 'Estar irascible, que todo te moleste.' },
      { id: 'control', title: 'Necesidad de control', text: 'No poder ceder nunca el control, estar sobrepasado en todo, anticipar todo y estar irascible si algo no sale como esperaba.' },
      { id: 'bloqueos', title: 'Bloqueos', text: 'A veces sabes lo que quieres cambiar, pero algo dentro de ti parece frenarte.' },
      { id: 'conflictos', title: 'Gestión de conflictos', text: 'Sentir que no solucionas bien los conflictos en el trabajo, con profesores/as, con la familia, con amigos, etc.' },
      { id: 'dependencia', title: 'Dependencia emocional', text: 'Cuando el miedo a perder una relación decide por ti.' },
      { id: 'apego', title: 'Apego y límites', text: 'Te cuesta confiar, poner límites o mantener relaciones estables.' },
      { id: 'familia', title: 'Relaciones familiares', text: 'Aceptar o modificar la vivencia de las relaciones familiares que generan malestar.' },
      { id: 'soledad', title: 'Soledad y conexión', text: 'Soledad, dificultad para conectar con la gente o sentirte diferente.' },
      { id: 'sentido', title: 'No saber quién soy o lo que quiero', text: 'No sabes cómo eres o lo que quieres. Te gustaría tener tu identidad y el sentido de vida más definido.' },
      { id: 'evitacion', title: 'Evitación', text: 'Evadirse con el móvil, el deporte o cualquier cosa para evitar afrontar o conectar con el sufrimiento.' },
      { id: 'pantallas', title: 'Abuso de pantallas', text: 'Notar que estoy muchas horas en el móvil, Netflix, videojuegos... hasta dejar de tener el control.' },
      { id: 'crisis', title: 'Crisis vitales', text: 'Una separación, un cambio de trabajo, la maternidad o una enfermedad.' },
      { id: 'jovenes', title: 'Acompañamiento adolescente/joven', text: 'De los 12 a los 25 años es una etapa de cambios, no solo sociales sino también de cambios biológicos. En esta etapa se puede necesitar acompañamiento en las diferentes dudas y cambios vitales.' },
      { id: 'perinatal', title: 'Psicología perinatal', text: 'Preparación psicológica para el parto, posparto.' },
      { id: 'duelo', title: 'Duelo', text: 'Una pérdida que duele y necesita su espacio.' },
      { id: 'perfeccionismo', title: 'Perfeccionismo', text: 'Presión constante, miedo al error y la sensación de no llegar nunca.' },
      { id: 'victima', title: 'Haber sido víctima', text: 'De abuso sexual infantil, abuso, conducta narcisista, etc.' },
      { id: 'disociacion', title: 'Disociación', text: 'Estar presente físicamente, pero sentir que estás lejos de ti, como si vivieras en automático y te costara conectar con lo que sientes.' },
      { id: 'trauma', title: 'Trauma', text: 'El trauma no siempre viene de algo extremo. A veces nace de años de críticas, abandono o relaciones inseguras.' },
    ],
  },
  ca: {
    metaTitle: 'Teràpia psicològica a Barcelona',
    description:
      "Teràpia psicològica en línia a tot Espanya i presencial a Barcelona: ansietat, estrès, burnout, autoestima, bloquejos, dol i trauma amb EMDR.",
    title: PAGE_TITLES.therapy.ca,
    intro: [
      "Per a mi, els símptomes (psicològics i somàtics) i el malestar que podem tenir les persones simplement són el cos parlant. La finalitat biològica del nostre cos és sobreviure i per això té molts mecanismes per garantir-ho, el que passa és que moltes vegades no tenim les eines o la consciència per entendre'ls i s'acaben cronificant i manifestant en forma de símptomes i malestar, i així perdem salut (aquests mecanismes no compleixen la seva funció).",
      "Quan s'entenen, compleixen la seva funció i moltes vegades aquest malestar desapareix. Això és el que faig, entendre l'origen i el perquè dels símptomes i del malestar.",
      "Treballo des de la psicologia integradora. M'adapto a cada persona, a cada situació i a cada necessitat. No tot funciona de la mateixa manera en cada persona.",
      "Tinc una formació àmplia en diferents enfocaments i corrents: cognitivoconductual, teràpies de tercera generació, EMDR nivell I i II, IFS, teràpia focalitzada en l'emoció, teràpia sistèmica i anàlisi transaccional, entre d'altres.",
    ],
    photoAlt: 'Maria Morales prenent notes en una llibreta',
    online: 'En línia',
    onlineText: "Per videotrucada, des de qualsevol lloc d'Espanya.",
    inPerson: 'Presencial',
    inPersonText: 'A la consulta de Barcelona.',
    listTitle: 'Amb què et puc acompanyar',
    doorsIntro: "Et reconeixes en alguna d'aquestes situacions?",
    doors: {
      alert: "La meva ment no s'atura",
      emotions: 'Em costa portar el que sento',
      self: "M'exigeixo molt o no sé què vull",
      relationships: 'Les relacions em pesen',
      stages: 'Una etapa que ho remou tot',
      past: 'Una cosa que em va passar i encara fa mal',
    },
    unsureTitle: 'No saps posar-hi nom?',
    unsureText: 'Si fa temps que penses «no sé què em passa, però no estic bé», també és un motiu vàlid per demanar ajuda.',
    quizLabel: 'Respondre 3 preguntes',
    freeCallLabel: 'Trucada gratuïta de 15 min',
    reviewsTitle: 'Opinions de pacients',
    specialties: [
      { id: 'ansiedad', title: 'Ansietat', text: 'Insomni, pressió al pit, pensaments constants, obsessions o rumiacions.' },
      { id: 'estres', title: 'Estrès', text: 'Quan les exigències superen durant molt de temps el que pots sostenir.' },
      { id: 'burnout', title: 'Burnout', text: "La feina t'ha deixat sense energia ni ganes." },
      { id: 'panico', title: 'Atacs de pànic', text: 'Una por intensa i sobtada, amb símptomes físics que espanten.' },
      { id: 'intrusivos', title: 'Pensaments intrusius, obsessions i compulsions', text: 'Idees o imatges que apareixen sense voler i generen malestar. Poden fer que repeteixis alguna acció per sentir-te millor.' },
      { id: 'tristeza', title: 'Tristesa', text: 'Sentir-me sense ganes, que tot em costi, fins i tot les tasques més simples.' },
      { id: 'autoestima', title: 'Autoestima', text: "T'agradaria valorar-te i tractar-te bé." },
      { id: 'regulacion', title: 'Regulació emocional', text: 'Emocions tan intenses i desbordants que costa entendre-les i gestionar-les, i que generen malestar i accions de regulació poc saludables (afartaments, autolesions, tricotil·lomania, etc.).' },
      { id: 'irritabilidad', title: 'Irritabilitat', text: 'Estar irascible, que tot et molesti.' },
      { id: 'control', title: 'Necessitat de control', text: 'No poder cedir mai el control, estar sobrepassat en tot, anticipar-ho tot i estar irascible si alguna cosa no surt com esperava.' },
      { id: 'bloqueos', title: 'Bloquejos', text: 'De vegades saps què vols canviar, però alguna cosa dins teu sembla frenar-te.' },
      { id: 'conflictos', title: 'Gestió de conflictes', text: 'Sentir que no resols bé els conflictes a la feina, amb professors/es, amb la família, amb amics, etc.' },
      { id: 'dependencia', title: 'Dependència emocional', text: 'Quan la por de perdre una relació decideix per tu.' },
      { id: 'apego', title: 'Aferrament i límits', text: 'Et costa confiar, posar límits o mantenir relacions estables.' },
      { id: 'familia', title: 'Relacions familiars', text: 'Acceptar o modificar la vivència de les relacions familiars que generen malestar.' },
      { id: 'soledad', title: 'Solitud i connexió', text: 'Solitud, dificultat per connectar amb la gent o sentir-te diferent.' },
      { id: 'sentido', title: 'No saber qui soc o què vull', text: "No saps com ets o què vols. T'agradaria tenir la teva identitat i el sentit de la vida més definits." },
      { id: 'evitacion', title: 'Evitació', text: "Evadir-se amb el mòbil, l'esport o qualsevol cosa per evitar afrontar el patiment o connectar-hi." },
      { id: 'pantallas', title: 'Abús de pantalles', text: 'Notar que estic moltes hores al mòbil, Netflix, videojocs... fins a deixar de tenir el control.' },
      { id: 'crisis', title: 'Crisis vitals', text: 'Una separació, un canvi de feina, la maternitat o una malaltia.' },
      { id: 'jovenes', title: 'Acompanyament adolescent/jove', text: 'Dels 12 als 25 anys és una etapa de canvis, no només socials sinó també biològics. En aquesta etapa es pot necessitar acompanyament en els diferents dubtes i canvis vitals.' },
      { id: 'perinatal', title: 'Psicologia perinatal', text: 'Preparació psicològica per al part, postpart.' },
      { id: 'duelo', title: 'Dol', text: 'Una pèrdua que fa mal i necessita el seu espai.' },
      { id: 'perfeccionismo', title: 'Perfeccionisme', text: "Pressió constant, por a l'error i la sensació de no arribar mai." },
      { id: 'victima', title: 'Haver estat víctima', text: "D'abús sexual infantil, abús, conducta narcisista, etc." },
      { id: 'disociacion', title: 'Dissociació', text: 'Estar present físicament, però sentir que estàs lluny de tu, com si visquessis en automàtic i et costés connectar amb el que sents.' },
      { id: 'trauma', title: 'Trauma', text: "El trauma no sempre ve d'una cosa extrema. De vegades neix d'anys de crítiques, abandonament o relacions insegures." },
    ],
  },
};

const c = COPY[locale];
const a = APPROACHES[locale];

const byId = new Map(c.specialties.map((s) => [s.id, s]));
const doors: Door[] = GROUPS.map((g) => ({
  key: g.key,
  icon: g.icon,
  title: c.doors[g.key],
  items: g.ids.map((id) => {
    const s = byId.get(id);
    if (!s) throw new Error(`Specialty "${id}" is grouped but missing in ${locale}`);
    return { ...s, href: LANDINGS[id] && pathFor(LANDINGS[id], locale) };
  }),
}));
// A specialty left out of every group would silently disappear from the page.
const grouped = new Set(GROUPS.flatMap((g) => g.ids));
const ungrouped = c.specialties.filter((s) => !grouped.has(s.id)).map((s) => s.id);
if (ungrouped.length) throw new Error(`Specialties without a group in ${locale}: ${ungrouped.join(', ')}`);

const quiz = `${pathFor('home', locale)}#test`;
---

<Layout title={c.metaTitle} description={c.description}>
  <PageHero title={c.title} />

  <section class="py-12 md:py-16">
    <div class="mx-auto grid w-[min(1120px,calc(100%-2rem))] items-center gap-10 lg:grid-cols-[1fr_380px] lg:gap-14">
      <div>
        {c.intro.map((p, i) => <p class:list={['max-w-[62ch]', i > 0 && 'mt-4']}>{p}</p>)}

        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          <a href={pathFor('online', locale)} class="rounded-2xl bg-primary p-5 text-white transition-colors hover:bg-primary-strong">
            <p class="flex items-center gap-2 font-display text-lg font-bold">
              <Icon name="online" /> {c.online} · {formatPrice(PRICES.online.amount)}
            </p>
            <p class="mt-1 text-white/90">{c.onlineText}</p>
          </a>
          <div class="rounded-2xl border border-line/60 bg-white p-5">
            <p class="flex items-center gap-2 font-display text-lg font-bold text-primary">
              <Icon name="location" /> {c.inPerson} · {formatPrice(PRICES.inPerson.amount)}
            </p>
            <p class="mt-1 text-muted">{c.inPersonText}</p>
          </div>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[380px]">
        <div class="absolute -bottom-4 -left-4 h-28 w-28 rounded-full bg-line/70" aria-hidden="true"></div>
        <Picture
          src={mariaWriting}
          formats={['avif', 'webp']}
          alt={c.photoAlt}
          width={380}
          widths={[380, 760]}
          sizes="(max-width: 1024px) 90vw, 380px"
          class="relative aspect-square w-full rounded-[2rem] object-cover shadow-primary"
        />
      </div>
    </div>
  </section>

  <Wave from="var(--color-bg)" to="var(--color-surface)" />
  <section class="bg-surface py-12 md:py-16" id="especialidades">
    <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
      <h2 class="text-2xl font-bold text-primary md:text-3xl">{c.listTitle}</h2>
      <p class="mt-2 text-muted">{c.doorsIntro}</p>
      <SpecialtyDoors doors={doors} />

      <div class="mt-6 flex flex-col gap-4 rounded-2xl bg-primary p-6 text-white md:flex-row md:items-center md:justify-between">
        <div class="max-w-[54ch]">
          <p class="font-display text-lg font-bold">{c.unsureTitle}</p>
          <p class="mt-1 text-white/90">{c.unsureText}</p>
        </div>
        <div class="flex flex-wrap gap-2 md:shrink-0">
          <a href={quiz} class="btn-light" data-event="quiz_link_click" data-event-location="therapy_specialties">{c.quizLabel}</a>
          <a
            href={FREE_CALL_BY_LOCALE[locale]}
            class="btn-sun-outline"
            target="_blank"
            rel="noopener"
            data-event="free_call_click"
            data-event-location="therapy_specialties"
          >
            {c.freeCallLabel}
          </a>
        </div>
      </div>

      <div class="mt-12">
        <LifeStages locale={locale} tone="light" />
      </div>
    </div>
  </section>

  <Wave from="var(--color-surface)" to="var(--color-bg)" flip />
  <section class="py-12 md:py-16" id="enfoques">
    <div class="mx-auto w-[min(1120px,calc(100%-2rem))]">
      <h2 class="text-2xl font-bold text-primary md:text-3xl">{a.title}</h2>

      <h3 class="mt-8 text-xl font-bold text-ink">{a.approachesTitle}</h3>
      <div class="mt-4 grid gap-3 md:grid-cols-3">{a.approaches.map((x) => <ApproachCard {...x} />)}</div>

      <h3 class="mt-10 text-xl font-bold text-ink">{a.techniquesTitle}</h3>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{a.techniques.map((x) => <ApproachCard {...x} />)}</div>

      <h3 class="mt-10 text-xl font-bold text-ink">{a.combineTitle}</h3>
      <p class="mt-3 max-w-[68ch]">{a.combine}</p>

      <h3 class="mt-12 text-xl font-bold text-ink">{c.reviewsTitle}</h3>
      <div class="mt-4">
        <DoctoraliaBadge />
        <GoogleReviewsLink />
      </div>
    </div>
  </section>

  <CtaFinal />
</Layout>
