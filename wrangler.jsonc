{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psicomariamorales",
  "compatibility_date": "2026-07-14",
  // The Worker runs before the static assets to decide indexing per host and to
  // add security and cache headers. See worker/index.ts.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
